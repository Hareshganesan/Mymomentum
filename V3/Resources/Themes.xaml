<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- ============================================== -->
    <!-- PREMIUM BLACK, GOLD & FROSTED GLASS THEME      -->
    <!-- ============================================== -->
    
    <!-- Background Colors - Deep Space Black -->
    <Color x:Key="DarkBackground">#FF07070D</Color>
    <Color x:Key="DarkSurface">#FF0E0E16</Color>
    <Color x:Key="DarkCard">#FF14141E</Color>
    <Color x:Key="DarkCardHover">#FF1E1E2C</Color>
    <Color x:Key="DarkBorder">#FF282838</Color>
    
    <!-- Gold Accent Colors -->
    <Color x:Key="GoldPrimary">#FFD4AF37</Color>
    <Color x:Key="GoldLight">#FFFFD700</Color>
    <Color x:Key="GoldDark">#FFB8860B</Color>
    <Color x:Key="GoldMuted">#FF9E8765</Color>
    
    <!-- Status Colors -->
    <Color x:Key="StatusGreen">#FF4ADE80</Color>
    <Color x:Key="StatusYellow">#FFFBBF24</Color>
    <Color x:Key="StatusRed">#FFEF4444</Color>
    
    <!-- Text Colors -->
    <Color x:Key="TextPrimary">#FFFFFFFF</Color>
    <Color x:Key="TextSecondary">#FFB4B4C0</Color>
    <Color x:Key="TextMuted">#FF6E6E7C</Color>
    <Color x:Key="TextGold">#FFD4AF37</Color>
    
    <!-- Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource DarkBackground}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource DarkSurface}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource DarkCard}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource DarkCardHover}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource DarkBorder}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource GoldPrimary}"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource GoldLight}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
    <SolidColorBrush x:Key="TextGoldBrush" Color="{StaticResource TextGold}"/>
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource StatusGreen}"/>
    <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource StatusYellow}"/>
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource StatusRed}"/>
    
    <!-- Additional UI Brushes -->
    <SolidColorBrush x:Key="DarkBackgroundBrush" Color="{StaticResource DarkBackground}"/>
    <SolidColorBrush x:Key="GoldBorderBrush" Color="#30D4AF37"/>
    <SolidColorBrush x:Key="GoldMutedBrush" Color="{StaticResource GoldMuted}"/>
    
    <!-- Premium Gold Gradient -->
    <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFD4AF37" Offset="0"/>
        <GradientStop Color="#FFFFD700" Offset="0.5"/>
        <GradientStop Color="#FFB8860B" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="GoldGradientHorizontal" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFB8860B" Offset="0"/>
        <GradientStop Color="#FFD4AF37" Offset="0.3"/>
        <GradientStop Color="#FFFFD700" Offset="0.6"/>
        <GradientStop Color="#FFD4AF37" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- Advanced Frosted Glass Effects -->
    <LinearGradientBrush x:Key="GlassBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#18FFFFFF" Offset="0"/>
        <GradientStop Color="#0AFFFFFF" Offset="0.5"/>
        <GradientStop Color="#05FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#40FFFFFF" Offset="0"/>
        <GradientStop Color="#15FFFFFF" Offset="0.5"/>
        <GradientStop Color="#25D4AF37" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GoldGlassCardBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#281A1A2E" Offset="0"/>
        <GradientStop Color="#18111220" Offset="0.5"/>
        <GradientStop Color="#22151828" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#24141628" Offset="0"/>
        <GradientStop Color="#160E101D" Offset="0.5"/>
        <GradientStop Color="#1E121526" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassCardShineBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3520233E" Offset="0"/>
        <GradientStop Color="#1C121524" Offset="0.6"/>
        <GradientStop Color="#26171B30" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GoldGlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#65D4AF37" Offset="0"/>
        <GradientStop Color="#30FFFFFF" Offset="0.35"/>
        <GradientStop Color="#20D4AF37" Offset="0.75"/>
        <GradientStop Color="#40D4AF37" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CyanGlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6538BDF8" Offset="0"/>
        <GradientStop Color="#30FFFFFF" Offset="0.35"/>
        <GradientStop Color="#2038BDF8" Offset="0.75"/>
        <GradientStop Color="#450284C7" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="UltraGlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#65D4AF37" Offset="0"/>
        <GradientStop Color="#35FFFFFF" Offset="0.3"/>
        <GradientStop Color="#18D4AF37" Offset="0.65"/>
        <GradientStop Color="#5038BDF8" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassBorderSubtle" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#35FFFFFF" Offset="0"/>
        <GradientStop Color="#15FFFFFF" Offset="0.5"/>
        <GradientStop Color="#25D4AF37" Offset="1"/>
    </LinearGradientBrush>
    
    <!-- Card Shadows & Glows -->
    <DropShadowEffect x:Key="CardShadow" 
                      BlurRadius="25" 
                      ShadowDepth="0" 
                      Direction="270"
                      Color="#000000" 
                      Opacity="0.6"/>
    
    <DropShadowEffect x:Key="CardShadowHover" 
                      BlurRadius="35" 
                      ShadowDepth="0" 
                      Direction="270"
                      Color="#000000" 
                      Opacity="0.7"/>
    
    <!-- Gold Glow Effects -->
    <DropShadowEffect x:Key="GoldGlow" 
                      BlurRadius="20" 
                      ShadowDepth="0" 
                      Color="{StaticResource GoldPrimary}" 
                      Opacity="0.5"/>
    
    <DropShadowEffect x:Key="GoldGlowStrong" 
                      BlurRadius="30" 
                      ShadowDepth="0" 
                      Color="{StaticResource GoldLight}" 
                      Opacity="0.6"/>
    
    <DropShadowEffect x:Key="GreenGlow" 
                      BlurRadius="15" 
                      ShadowDepth="0" 
                      Color="{StaticResource StatusGreen}" 
                      Opacity="0.5"/>

</ResourceDictionary>
