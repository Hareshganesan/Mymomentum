<Window x:Class="MyTodo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyTodo.ViewModels"
        xmlns:controls="clr-namespace:MyTodo.Controls"
        Title="MyTodo - Premium Desktop" 
        Height="800" Width="1400"
        MinHeight="650" MinWidth="1100"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Smooth animations -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        
        <Storyboard x:Key="SlideIn">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" 
                             From="20" To="0" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
        </Storyboard>
    </Window.Resources>

    <!-- Main Container -->
    <Border x:Name="MainBorder"
            Background="#40080810" 
            CornerRadius="20"
            Margin="8"
            BorderBrush="{StaticResource GoldBorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="50" ShadowDepth="0" Color="#000000" Opacity="0.9"/>
        </Border.Effect>
        
        <Grid>
            <!-- Animated Background -->
            <Border CornerRadius="20" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#20080810" Offset="0"/>
                        <GradientStop Color="#300A0A14" Offset="0.5"/>
                        <GradientStop Color="#20080810" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Animated Particle Canvas -->
            <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False" ClipToBounds="True"/>

            <!-- Ambient Gold Orbs -->
            <Canvas IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse Width="600" Height="600" Canvas.Left="-200" Canvas.Top="-200" Opacity="0.02">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFD4AF37" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="500" Height="500" Canvas.Right="-150" Canvas.Bottom="-100" Opacity="0.02">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFD700" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="400" Height="400" Canvas.Left="600" Canvas.Top="200" Opacity="0.01">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFB8860B" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <Grid x:Name="MainContentGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFocusMode}" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <BlurEffect Radius="15"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- ============================================== -->
                <!-- LEFT SIDEBAR - Navigation & Stats              -->
                <!-- ============================================== -->
                <Border Grid.Column="0" 
                        Margin="0" 
                        CornerRadius="20,0,0,20"
                        BorderThickness="0,0,1,0"
                        BorderBrush="#15D4AF37">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12D4AF37" Offset="0"/>
                            <GradientStop Color="#08D4AF37" Offset="0.5"/>
                            <GradientStop Color="#05D4AF37" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    
                    <Grid Margin="24,20,24,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Logo & Brand -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,30">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Width="44" Height="44" CornerRadius="12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFB8860B" Offset="0"/>
                                            <GradientStop Color="#FFD4AF37" Offset="0.5"/>
                                            <GradientStop Color="#FFFFD700" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#FFD4AF37" Opacity="0.5"/>
                                    </Border.Effect>
                                    <TextBlock Text="🌱" FontSize="22" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="#0A0A0F"/>
                                </Border>
                                
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Momentum" 
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource GoldGradient}"/>
                                    <TextBlock Text="Keep Hustling" 
                                               FontSize="10"
                                               Foreground="{StaticResource GoldMutedBrush}"
                                               Margin="0,-2,0,0"/>
                                </StackPanel>
                                
                                <!-- Window Controls -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource GoldIconButton}" Width="28" Height="28"
                                            Click="MinimizeButton_Click" Content="─" FontSize="10"/>
                                    <Button Style="{StaticResource GoldIconButton}" Width="28" Height="28"
                                            Click="MaximizeButton_Click" Content="□" FontSize="12"/>
                                    <Button Style="{StaticResource GoldIconButton}" Width="28" Height="28"
                                            Click="CloseButton_Click" Content="✕" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        
                        <!-- Navigation Menu -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,20">
                            <!-- Home -->
                            <Button Command="{Binding NavigateToHomeCommand}" Margin="0,0,0,6" 
                                    HorizontalContentAlignment="Left" Padding="14,12" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHomePage}" Value="True">
                                                <Setter Property="Background" Value="#18D4AF37"/>
                                                <Setter Property="Foreground" Value="{StaticResource GoldGradient}"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#0CD4AF37"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏠" FontSize="18" Margin="0,0,10,0"/>
                                    <TextBlock Text="Home" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Achievements -->
                            <Button Command="{Binding NavigateToAchievementsCommand}" Margin="0,0,0,6"
                                    HorizontalContentAlignment="Left" Padding="14,12" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAchievementsPage}" Value="True">
                                                <Setter Property="Background" Value="#18D4AF37"/>
                                                <Setter Property="Foreground" Value="{StaticResource GoldGradient}"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#0CD4AF37"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏆" FontSize="18" Margin="0,0,10,0"/>
                                    <TextBlock Text="Achievements" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- History -->
                            <Button Command="{Binding NavigateToHistoryCommand}" Margin="0,0,0,6"
                                    HorizontalContentAlignment="Left" Padding="14,12" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHistoryPage}" Value="True">
                                                <Setter Property="Background" Value="#18D4AF37"/>
                                                <Setter Property="Foreground" Value="{StaticResource GoldGradient}"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#0CD4AF37"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0"/>
                                    <TextBlock Text="History" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Settings -->
                            <Button Command="{Binding NavigateToSettingsCommand}" Margin="0,0,0,6"
                                    HorizontalContentAlignment="Left" Padding="14,12" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                                <Setter Property="Background" Value="#18D4AF37"/>
                                                <Setter Property="Foreground" Value="{StaticResource GoldGradient}"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#0CD4AF37"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" FontSize="18" Margin="0,0,10,0"/>
                                    <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        
                        <!-- Stats Summary -->
                        <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                            <!-- Quick Stats -->
                            <Border Margin="0,0,0,10" Padding="14,12" CornerRadius="12"
                                    Background="#10D4AF37" BorderBrush="#20D4AF37" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding StreakStatusText}" FontSize="13" 
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                                        <TextBlock FontSize="11" Foreground="{StaticResource GoldMutedBrush}">
                                            <Run Text="{Binding TotalTasksCompleted, Mode=OneWay}"/>
                                            <Run Text=" tasks completed"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                        
                        <!-- Theme Toggle -->
                        <Button Grid.Row="3" Style="{StaticResource GoldIconButton}" 
                                Command="{Binding ToggleThemeCommand}"
                                HorizontalAlignment="Left" Margin="0,15,0,0"
                                Content="☀" ToolTip="Toggle Theme"/>
                    </Grid>
                </Border>

                <!-- ============================================== -->
                <!-- CENTER - Multi-Page Content                    -->
                <!-- ============================================== -->
                <Grid Grid.Column="1">
                    <!-- ============================================== -->
                    <!-- HOME PAGE                                      -->
                    <!-- ============================================== -->
                    <Grid Margin="30,20,30,24"
                          Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="{Binding TimeGreeting}" FontSize="14" 
                                   Foreground="{StaticResource GoldMutedBrush}"/>
                        <TextBlock Text="{Binding TodayDateFormatted}" FontSize="28" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <!-- Motivational Banner -->
                    <Border Grid.Row="1" Margin="0,0,0,20" CornerRadius="18" Padding="24,20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#15D4AF37" Offset="0"/>
                                <GradientStop Color="#08FFD700" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#30D4AF37" Offset="0"/>
                                <GradientStop Color="#15FFD700" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.BorderThickness>1</Border.BorderThickness>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding MotivationalMessage}" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource GoldGradient}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}">
                                        <TextBlock.Text>
                                            <Binding Path="CompletedTodayTasks"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text=" / " FontSize="24" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock FontSize="24" Foreground="{StaticResource TextMutedBrush}">
                                        <TextBlock.Text>
                                            <Binding Path="TotalTodayTasks"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text=" tasks completed" FontSize="13" 
                                               Foreground="{StaticResource GoldMutedBrush}"
                                               VerticalAlignment="Bottom" Margin="8,0,0,4"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Mini Progress -->
                            <Border Grid.Column="1" Width="80" Height="80" Margin="20,0,0,0">
                                <Grid>
                                    <controls:CircularProgress Value="{Binding TodayProgress, Mode=OneWay}" StrokeThickness="6"/>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="16" FontWeight="Bold" Foreground="{StaticResource GoldGradient}">
                                        <TextBlock.Text>
                                            <Binding Path="TodayProgress" StringFormat="{}{0:0}%" Mode="OneWay"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <!-- Tasks Section -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Section Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Today's Tasks" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="13" Foreground="{StaticResource GoldMutedBrush}">
                                <TextBlock.Text>
                                    <Binding Path="RemainingTodayTasks" StringFormat="{}{0} remaining"/>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                        
                        <!-- Task List with Scroll -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- Empty State -->
                                <Border Margin="0,40,0,0"
                                        Visibility="{Binding HasNoTasks, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🎯" FontSize="72" HorizontalAlignment="Center" Opacity="0.8"/>
                                        <TextBlock Text="Ready to conquer the day?" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{StaticResource GoldGradient}"
                                                   HorizontalAlignment="Center" Margin="0,16,0,8"/>
                                        <TextBlock Text="Add your first task and start building momentum!"
                                                   FontSize="14" Foreground="{StaticResource GoldMutedBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                
                                <!-- Task Items -->
                                <ItemsControl ItemsSource="{Binding TodayTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,10" CornerRadius="14" Padding="16,14" Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#0CD4AF37"/>
                                                        <Setter Property="BorderBrush" Value="#18D4AF37"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#15D4AF37"/>
                                                                <Setter Property="BorderBrush" Value="#30D4AF37"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Opacity" Value="0.6"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDailyHighlight}" Value="True">
                                                                <Setter Property="Background" Value="#18D4AF37"/>
                                                                <Setter Property="BorderBrush" Value="#40D4AF37"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Check Button -->
                                                    <Button Style="{StaticResource GoldCheckButton}"
                                                            Command="{Binding DataContext.CompleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Tag="{Binding IsCompleted, Converter={StaticResource BoolToTag}}"
                                                            VerticalAlignment="Center"/>
                                                    
                                                    <!-- Energy Tag -->
                                                    <TextBlock Grid.Column="1" Text="{Binding EnergyEmoji}" 
                                                               FontSize="16" VerticalAlignment="Center"
                                                               Margin="10,0,0,0"
                                                               ToolTip="{Binding EnergyLabel}"/>
                                                    
                                                    <!-- Task Content -->
                                                    <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <!-- Task Title -->
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="15" TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            
                                                            <!-- Daily Highlight Badge -->
                                                            <Border Grid.Column="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                                    Visibility="{Binding IsDailyHighlight, Converter={StaticResource BoolToVisibility}}">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                        <GradientStop Color="#FFB8860B" Offset="0"/>
                                                                        <GradientStop Color="#FFD4AF37" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                                <TextBlock Text="★ HIGHLIGHT" FontSize="9" FontWeight="Bold"
                                                                           Foreground="#0A0A0F"/>
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                    
                                                    <!-- Actions -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                        <!-- Focus Button -->
                                                        <Button Style="{StaticResource GoldIconButton}"
                                                                Command="{Binding DataContext.EnterFocusModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Content="⚡" FontSize="13" Width="30" Height="30"
                                                                ToolTip="Focus Mode" Margin="0,0,4,0"
                                                                Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityInverse}}"/>
                                                        
                                                        <!-- Set Highlight Button -->
                                                        <Button Style="{StaticResource GoldIconButton}"
                                                                Command="{Binding DataContext.SetDailyHighlightCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Content="★" FontSize="13" Width="30" Height="30"
                                                                ToolTip="Set as Daily Highlight" Margin="0,0,4,0"
                                                                Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityInverse}}"/>
                                                        
                                                        <!-- Status Indicator -->
                                                        <Border Width="8" Height="8" CornerRadius="4"
                                                                VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{StaticResource TextMutedBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StatusColor}" Value="Green">
                                                                            <Setter Property="Background" Value="#FF4ADE80"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusColor}" Value="Yellow">
                                                                            <Setter Property="Background" Value="#FFFBBF24"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusColor}" Value="Red">
                                                                            <Setter Property="Background" Value="#FFEF4444"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        
                                                        <!-- Delete Button -->
                                                        <Button Style="{StaticResource GoldIconButton}"
                                                                Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Content="✕" FontSize="11" Width="30" Height="30"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid> <!-- End Home Page -->

                <!-- ============================================== -->
                <!-- ACHIEVEMENTS PAGE                              -->
                <!-- ============================================== -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsAchievementsPage, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="30,20,30,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,30">
                            <TextBlock Text="🏆" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="Achievements" FontSize="32" FontWeight="Bold"
                                       Foreground="{StaticResource GoldGradient}"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock HorizontalAlignment="Center" FontSize="14" 
                                       Foreground="{StaticResource GoldMutedBrush}">
                                <Run Text="{Binding UnlockedBadgesCount, Mode=OneWay}"/>
                                <Run Text=" / "/>
                                <Run Text="{Binding TotalBadges, Mode=OneWay}"/>
                                <Run Text=" unlocked"/>
                            </TextBlock>
                        </StackPanel>
                        
                        <!-- Badges Grid -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding AllBadges}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="8" Padding="20" CornerRadius="16" Width="200" Height="180">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#0CD4AF37"/>
                                                <Setter Property="BorderBrush" Value="#18D4AF37"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                        <Setter Property="Background" Value="#18D4AF37"/>
                                                        <Setter Property="BorderBrush" Value="#40D4AF37"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsUnlocked}" Value="False">
                                                        <Setter Property="Opacity" Value="0.4"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        
                                        <StackPanel>
                                            <TextBlock Text="{Binding Emoji}" FontSize="42" 
                                                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center" TextAlignment="Center"
                                                       TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11"
                                                       Foreground="{StaticResource GoldMutedBrush}"
                                                       HorizontalAlignment="Center" TextAlignment="Center"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>

                <!-- ============================================== -->
                <!-- HISTORY PAGE                                   -->
                <!-- ============================================== -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsHistoryPage, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="30,20,30,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,30">
                            <TextBlock Text="📖" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="History &amp; Reflections" FontSize="32" FontWeight="Bold"
                                       Foreground="{StaticResource GoldGradient}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Completed Tasks Summary -->
                        <Border Grid.Row="1" Margin="0,0,0,20" CornerRadius="16" Padding="24">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#15D4AF37" Offset="0"/>
                                    <GradientStop Color="#08FFD700" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="✨" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalTasksCompleted}" FontSize="32" FontWeight="Bold"
                                               Foreground="{StaticResource GoldGradient}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Total Completed" FontSize="12" 
                                               Foreground="{StaticResource GoldMutedBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="🔥" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding BestStreak}" FontSize="32" FontWeight="Bold"
                                               Foreground="{StaticResource GoldGradient}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Best Streak" FontSize="12" 
                                               Foreground="{StaticResource GoldMutedBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="🎯" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding PerfectDaysCount}" FontSize="32" FontWeight="Bold"
                                               Foreground="{StaticResource GoldGradient}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Perfect Days" FontSize="12" 
                                               Foreground="{StaticResource GoldMutedBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <!-- Completed Tasks List -->
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Recently Completed" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                            
                            <ItemsControl ItemsSource="{Binding CompletedTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" CornerRadius="14" Padding="16,14"
                                                Background="#0CD4AF37" BorderBrush="#18D4AF37" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <TextBlock Text="✓" FontSize="18" 
                                                           Foreground="{StaticResource GoldGradient}"
                                                           VerticalAlignment="Center"/>
                                                
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="15"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding CompletedAtFormatted}" FontSize="11"
                                                               Foreground="{StaticResource GoldMutedBrush}"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                                
                                                <TextBlock Grid.Column="2" Text="{Binding EnergyEmoji}" 
                                                           FontSize="16" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <!-- Empty State -->
                            <Border Margin="0,40,0,0" Padding="20"
                                    Visibility="{Binding HasCompletedTasks, Converter={StaticResource BoolToVisibilityInverse}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📝" FontSize="48" HorizontalAlignment="Center" Opacity="0.6"/>
                                    <TextBlock Text="No completed tasks yet" FontSize="16"
                                               Foreground="{StaticResource GoldMutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ============================================== -->
                <!-- SETTINGS PAGE                                  -->
                <!-- ============================================== -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="30,20,30,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,30">
                            <TextBlock Text="⚙" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="Settings" FontSize="32" FontWeight="Bold"
                                       Foreground="{StaticResource GoldGradient}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- Settings Cards -->
                        <StackPanel Grid.Row="1" MaxWidth="600">
                            <!-- Display Settings -->
                            <TextBlock Text="Display" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            
                            <Border Margin="0,0,0,20" Padding="20" CornerRadius="14"
                                    Background="#0CD4AF37" BorderBrush="#18D4AF37" BorderThickness="1">
                                <StackPanel>
                                    <!-- Full Screen Toggle -->
                                    <Grid Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Full Screen Mode" FontSize="14"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Maximize your workspace" FontSize="11"
                                                       Foreground="{StaticResource GoldMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Style="{StaticResource SecondaryButton}" Padding="16,8"
                                                Command="{Binding ToggleFullScreenCommand}"
                                                HorizontalAlignment="Right">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Enable"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFullScreen}" Value="True">
                                                                <Setter Property="Text" Value="Disable"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                    </Grid>
                                    
                                    <!-- Theme Toggle -->
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Dark Theme" FontSize="14"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Toggle between dark and light mode" FontSize="11"
                                                       Foreground="{StaticResource GoldMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Style="{StaticResource SecondaryButton}" Padding="16,8"
                                                Command="{Binding ToggleThemeCommand}"
                                                Content="Toggle Theme"
                                                HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- Data Management -->
                            <TextBlock Text="Data" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            
                            <Border Margin="0,0,0,20" Padding="20" CornerRadius="14"
                                    Background="#0CD4AF37" BorderBrush="#18D4AF37" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="Export Data" FontSize="14"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="Save your progress to JSON" FontSize="11"
                                                       Foreground="{StaticResource GoldMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Style="{StaticResource SecondaryButton}" Padding="16,8"
                                                Content="Export"
                                                HorizontalAlignment="Right"/>
                                    </Grid>
                                    
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Clear All Data" FontSize="14"
                                                       Foreground="#FF6B6B"/>
                                            <TextBlock Text="Reset everything (cannot be undone)" FontSize="11"
                                                       Foreground="{StaticResource GoldMutedBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Style="{StaticResource SecondaryButton}" Padding="16,8"
                                                Content="Clear Data"
                                                HorizontalAlignment="Right"
                                                Foreground="#FF6B6B"
                                                BorderBrush="#40FF6B6B"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            
                            <!-- About -->
                            <TextBlock Text="About" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            
                            <Border Padding="20" CornerRadius="14"
                                    Background="#0CD4AF37" BorderBrush="#18D4AF37" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Momentum" FontSize="16" FontWeight="Bold"
                                               Foreground="{StaticResource GoldGradient}"/>
                                    <TextBlock Text="Version 1.0.0" FontSize="12"
                                               Foreground="{StaticResource GoldMutedBrush}" Margin="0,4,0,12"/>
                                    <TextBlock Text="A modern Windows desktop app for tracking tasks, goals, and building productive habits."
                                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                
                </Grid> <!-- End Grid.Column="1" - All Pages Container -->

                <!-- ============================================== -->
                <!-- RIGHT PANEL - Quick Add & Goals                -->
                <!-- ============================================== -->
                <Border Grid.Column="2" 
                        Margin="0" 
                        CornerRadius="0,20,20,0"
                        BorderThickness="1,0,0,0"
                        BorderBrush="#15D4AF37">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#06D4AF37" Offset="0"/>
                            <GradientStop Color="#03D4AF37" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24,20,24,24">
                        <StackPanel>
                            <!-- Daily Highlight Card -->
                            <Border CornerRadius="16" Padding="16" Margin="0,0,0,20"
                                    Visibility="{Binding HasDailyHighlight, Converter={StaticResource BoolToVisibility}}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#25D4AF37" Offset="0"/>
                                        <GradientStop Color="#15FFD700" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#50D4AF37" Offset="0"/>
                                        <GradientStop Color="#30FFD700" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.BorderThickness>1</Border.BorderThickness>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#FFD4AF37" Opacity="0.3"/>
                                </Border.Effect>
                                
                                <StackPanel>
                                    <TextBlock Text="🌟 Daily Highlight" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource GoldGradient}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding DailyHighlightTitle}" FontSize="16" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource GoldButton}" Margin="0,12,0,0"
                                            Command="{Binding EnterFocusModeCommand}"
                                            CommandParameter="{Binding DailyHighlight}"
                                            Content="⚡ Focus on this" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>

                            <!-- Energy Suggestion -->
                            <Border CornerRadius="12" Padding="14" Margin="0,0,0,20"
                                    Background="#0CD4AF37" BorderBrush="#18D4AF37" BorderThickness="1"
                                    Visibility="{Binding EnergySuggestion, Converter={StaticResource StringToVisibility}}">
                                <TextBlock Text="{Binding EnergySuggestion}" FontSize="13"
                                           Foreground="{StaticResource GoldGradient}" TextWrapping="Wrap"/>
                            </Border>
                            
                            <!-- Quick Add Task -->
                            <TextBlock Text="✏️ Quick Add" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                            
                            <Border CornerRadius="14" Padding="16" Margin="0,0,0,24"
                                    Background="#0CD4AF37" BorderBrush="#18D4AF37" BorderThickness="1">
                                <StackPanel>
                                    <TextBox x:Name="TaskInput"
                                             Style="{StaticResource PremiumTextBox}"
                                             Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,10">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding AddTaskCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    
                                    <!-- Energy Tag Selector -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Energy:" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{StaticResource GoldMutedBrush}" Margin="0,0,10,0"/>
                                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding CycleNewTaskEnergyCommand}"
                                                HorizontalAlignment="Left" Padding="12,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding NewTaskEnergyEmoji}" FontSize="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding NewTaskEnergy}" FontSize="12"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    
                                    <Button Style="{StaticResource GoldButton}"
                                            Command="{Binding AddTaskCommand}"
                                            Content="+ Add Task" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>

                            <!-- Streak Protection -->
                            <Border CornerRadius="12" Padding="14" Margin="0,0,0,20"
                                    Background="#0CD4AF37" BorderBrush="#18D4AF37" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding StreakStatusText}" FontSize="13"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Button Grid.Column="1" Padding="10,6"
                                            Visibility="{Binding StreakPaused, Converter={StaticResource BoolToVisibilityInverse}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                <Setter Property="Content" Value="⏸️ Pause"/>
                                                <Setter Property="Command" Value="{Binding PauseStreakCommand}"/>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Grid.Column="1" Padding="10,6"
                                            Visibility="{Binding StreakPaused, Converter={StaticResource BoolToVisibility}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GoldButton}">
                                                <Setter Property="Content" Value="▶️ Resume"/>
                                                <Setter Property="Command" Value="{Binding ResumeStreakCommand}"/>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                            
                            <!-- Goals Section -->
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="🎯 Goals" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Grid>
                            
                            <!-- Add Goal -->
                            <Border CornerRadius="14" Padding="16" Margin="0,0,0,16"
                                    Background="#0CD4AF37" BorderBrush="#18D4AF37" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource PremiumTextBox}"
                                             Text="{Binding NewGoalTitle, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,10,0" Padding="12,10">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding AddGoalCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="1" Style="{StaticResource GoldButton}"
                                            Command="{Binding AddGoalCommand}"
                                            Content="+" Padding="14,10" FontSize="16"/>
                                </Grid>
                            </Border>
                            
                            <!-- Goals List -->
                            <ItemsControl ItemsSource="{Binding Goals}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" CornerRadius="14" Padding="16" Cursor="Hand"
                                                Background="#0CD4AF37" BorderBrush="#18D4AF37" BorderThickness="1">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontSize="12" Foreground="{StaticResource GoldMutedBrush}" Margin="0,4,0,0">
                                                            <TextBlock.Text>
                                                                <Binding Path="ProgressPercentage" StringFormat="{}{0:0}% complete"/>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Style="{StaticResource GoldButton}"
                                                                Command="{Binding DataContext.IncrementGoalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Content="+10%" Padding="10,6" FontSize="10" Margin="0,0,6,0"/>
                                                        <Button Style="{StaticResource GoldIconButton}"
                                                                Command="{Binding DataContext.DeleteGoalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Content="✕" FontSize="10" Width="26" Height="26"/>
                                                    </StackPanel>
                                                </Grid>
                                                
                                                <!-- Progress Bar -->
                                                <Grid Height="6" Margin="0,12,0,0">
                                                    <Border Background="#15D4AF37" CornerRadius="3"/>
                                                    <Border CornerRadius="3" HorizontalAlignment="Left">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                                                <Binding Path="ProgressPercentage" Mode="OneWay"/>
                                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" Mode="OneWay"/>
                                                            </MultiBinding>
                                                        </Border.Width>
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#FFB8860B" Offset="0"/>
                                                                <GradientStop Color="#FFD4AF37" Offset="0.5"/>
                                                                <GradientStop Color="#FFFFD700" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#FFD4AF37" Opacity="0.5"/>
                                                        </Border.Effect>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <!-- Spacer -->
                            <Border Height="20"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ============================================== -->
            <!-- CONFETTI OVERLAY                               -->
            <!-- ============================================== -->
            <Canvas x:Name="ConfettiCanvas" 
                    IsHitTestVisible="False"
                    Visibility="{Binding ShowConfetti, Converter={StaticResource BoolToVisibility}}"/>

            <!-- ============================================== -->
            <!-- FOCUS MODE OVERLAY                             -->
            <!-- ============================================== -->
            <Border x:Name="FocusModeOverlay"
                    Visibility="{Binding IsFocusMode, Converter={StaticResource BoolToVisibility}}"
                    CornerRadius="20">
                <Border.Background>
                    <SolidColorBrush Color="#E5080810"/>
                </Border.Background>
                
                <Grid>
                    <!-- Exit Button -->
                    <Button Style="{StaticResource GoldIconButton}"
                            Command="{Binding ExitFocusModeCommand}"
                            Content="✕" FontSize="16"
                            Width="44" Height="44"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,30,30,0"/>
                    
                    <!-- Focus Content - Two Column Layout -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="1200">
                        <!-- Header -->
                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,30">
                            <TextBlock Text="F O C U S   M O D E" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,0,0,15"
                                       Foreground="{StaticResource GoldGradient}"/>
                            
                            <TextBlock Text="{Binding FocusTask.Title}" 
                                       FontSize="28" FontWeight="Bold"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,0,0,8"/>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding FocusTask.EnergyEmoji}" FontSize="18" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding FocusTask.EnergyLabel}" FontSize="14"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource GoldMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Two Column Layout -->
                        <Grid Margin="0,120,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- LEFT: Vintage Clock -->
                            <Border Grid.Column="0" Background="Transparent" Padding="20"
                                    VerticalAlignment="Center">
                                <Viewbox Width="480" Height="480">
                                    <controls:VintageAnalogClock Minutes="{Binding PomodoroMinutes}"
                                                                  Seconds="{Binding PomodoroSeconds}"/>
                                </Viewbox>
                            </Border>
                            
                            <!-- RIGHT: Controls -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="380">
                                <!-- Digital Time Display -->
                                <Border CornerRadius="16" Padding="32,16"
                                        Background="#25D4AF37" BorderBrush="#40D4AF37" BorderThickness="2"
                                        HorizontalAlignment="Center" Margin="0,0,0,24">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#D4AF37" Opacity="0.5"/>
                                    </Border.Effect>
                                    <TextBlock Text="{Binding PomodoroDisplay}" 
                                               FontSize="48" FontWeight="Light"
                                               Foreground="{StaticResource GoldGradient}"/>
                                </Border>
                                
                                <!-- Time Adjustment Controls -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24"
                                            Visibility="{Binding IsPomodoroRunning, Converter={StaticResource BoolToVisibilityInverse}}">
                                    <TextBlock Text="Duration:" FontSize="14" VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="{StaticResource GoldGradient}" Margin="0,0,16,0"/>
                                    <Button Style="{StaticResource GoldIconButton}"
                                            Command="{Binding DecreasePomodoroTimeCommand}"
                                            Content="−" FontSize="20" Width="44" Height="44"
                                            Margin="0,0,10,0"/>
                                    <Border CornerRadius="12" Padding="20,10" 
                                            Background="#25D4AF37" BorderBrush="#40D4AF37" BorderThickness="2">
                                        <TextBlock FontSize="18" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}">
                                            <Run Text="{Binding PomodoroMinutes, Mode=OneWay}"/>
                                            <Run Text=" min"/>
                                        </TextBlock>
                                    </Border>
                                    <Button Style="{StaticResource GoldIconButton}"
                                            Command="{Binding IncreasePomodoroTimeCommand}"
                                            Content="+" FontSize="20" Width="44" Height="44"
                                            Margin="10,0,0,0"/>
                                </StackPanel>
                                
                                <!-- Timer Controls -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                                    <Button Style="{StaticResource GoldButton}"
                                            Command="{Binding StartPomodoroCommand}"
                                            Content="▶ Start" Padding="28,14" FontSize="15"
                                            Visibility="{Binding IsPomodoroRunning, Converter={StaticResource BoolToVisibilityInverse}}"
                                            Margin="0,0,10,0"/>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Command="{Binding PausePomodoroCommand}"
                                            Content="⏸ Pause" Padding="28,14" FontSize="15"
                                            Visibility="{Binding IsPomodoroRunning, Converter={StaticResource BoolToVisibility}}"
                                            Margin="0,0,10,0"/>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Command="{Binding ResetPomodoroCommand}"
                                            Content="↻ Reset" Padding="28,14" FontSize="15"/>
                                </StackPanel>
                                
                                <!-- Complete Task Button -->
                                <Button Style="{StaticResource GoldButton}"
                                        Command="{Binding CompleteFocusTaskCommand}"
                                        FontSize="16" Padding="40,16" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="✓" FontSize="20" Margin="0,0,10,0"/>
                                        <TextBlock Text="Mark Complete"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- MORNING CHECK-IN OVERLAY                       -->
            <!-- ============================================== -->
            <Border Visibility="{Binding ShowMorningCheckIn, Converter={StaticResource BoolToVisibility}}"
                    CornerRadius="20">
                <Border.Background>
                    <SolidColorBrush Color="#F0080810"/>
                </Border.Background>
                
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="20" MaxWidth="450" Padding="40">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF101018" Offset="0"/>
                            <GradientStop Color="#FF0C0C14" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#40D4AF37" Offset="0"/>
                            <GradientStop Color="#20FFD700" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="60" ShadowDepth="0" Color="#000000" Opacity="0.8"/>
                    </Border.Effect>
                    
                    <StackPanel>
                        <TextBlock Text="☀️" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="Good Morning!" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"
                                   Foreground="{StaticResource GoldGradient}"/>
                        <TextBlock Text="What's your main focus for today?" FontSize="14"
                                   HorizontalAlignment="Center" Margin="0,0,0,24"
                                   Foreground="{StaticResource GoldMutedBrush}"/>
                        
                        <TextBox Style="{StaticResource PremiumTextBox}"
                                 Text="{Binding MorningReflection, UpdateSourceTrigger=PropertyChanged}"
                                 Height="100" TextWrapping="Wrap" AcceptsReturn="True"
                                 Margin="0,0,0,20"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource GoldButton}"
                                    Command="{Binding SaveMorningCheckInCommand}"
                                    Content="Set Intention" Padding="24,12"
                                    Margin="0,0,10,0"/>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding DismissCheckInCommand}"
                                    Content="Skip" Padding="24,12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ============================================== -->
            <!-- EVENING CHECK-IN OVERLAY                       -->
            <!-- ============================================== -->
            <Border Visibility="{Binding ShowEveningCheckIn, Converter={StaticResource BoolToVisibility}}"
                    CornerRadius="20">
                <Border.Background>
                    <SolidColorBrush Color="#F0080810"/>
                </Border.Background>
                
                <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="20" MaxWidth="450" Padding="40">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF101018" Offset="0"/>
                            <GradientStop Color="#FF0C0C14" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#40D4AF37" Offset="0"/>
                            <GradientStop Color="#20FFD700" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="60" ShadowDepth="0" Color="#000000" Opacity="0.8"/>
                    </Border.Effect>
                    
                    <StackPanel>
                        <TextBlock Text="🌙" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="Evening Reflection" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"
                                   Foreground="{StaticResource GoldGradient}"/>
                        <TextBlock Text="What did you accomplish today?" FontSize="14"
                                   HorizontalAlignment="Center" Margin="0,0,0,24"
                                   Foreground="{StaticResource GoldMutedBrush}"/>
                        
                        <TextBox Style="{StaticResource PremiumTextBox}"
                                 Text="{Binding EveningReflection, UpdateSourceTrigger=PropertyChanged}"
                                 Height="100" TextWrapping="Wrap" AcceptsReturn="True"
                                 Margin="0,0,0,20"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource GoldButton}"
                                    Command="{Binding SaveEveningCheckInCommand}"
                                    Content="Save Reflection" Padding="24,12"
                                    Margin="0,0,10,0"/>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding DismissCheckInCommand}"
                                    Content="Skip" Padding="24,12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
