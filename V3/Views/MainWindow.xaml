<Window x:Class="MyTodo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyTodo.ViewModels"
        xmlns:controls="clr-namespace:MyTodo.Controls"
        Title="Momentum - SDE Placement &amp; DSA Cockpit"
        Icon="pack://application:,,,/Assets/app_icon.ico" 
        Height="880" Width="1440"
        MinHeight="720" MinWidth="1180"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      CornerRadius="16"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="8"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- Main Outer Window Border (Translucent Frosted Acrylic Glass) -->
    <Border x:Name="MainBorder"
            Background="{StaticResource BackgroundBrush}" 
            CornerRadius="16"
            Margin="4"
            BorderBrush="{StaticResource DarkBorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.35"/>
        </Border.Effect>
        
        <Grid>
            <!-- Pure Neutral Frosted Glass Surface Tint Layer -->
            <Border CornerRadius="16" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#10000000" Offset="0"/>
                        <GradientStop Color="#18000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Subtle Neutral Translucent Ambient Glass Highlights (No color) -->
            <Canvas IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse Width="500" Height="500" Canvas.Left="-160" Canvas.Top="-160" Opacity="0.04">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <!-- 3-Column Main Grid -->
            <Grid x:Name="MainContentGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFocusMode}" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <BlurEffect Radius="15"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- ============================================== -->
                <!-- LEFT SIDEBAR - Navigation & Placement Radar    -->
                <!-- ============================================== -->
                <Border Grid.Column="0" 
                        CornerRadius="16,0,0,16"
                        BorderThickness="0,0,1,0"
                        BorderBrush="{StaticResource DarkBorderBrush}"
                        Background="{StaticResource SurfaceBrush}">
                    
                    <Grid Margin="18,18,18,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Brand & Window Controls -->
                            <RowDefinition Height="Auto"/> <!-- Readiness Radar Pill -->
                            <RowDefinition Height="*"/>    <!-- Navigation Menu -->
                            <RowDefinition Height="Auto"/> <!-- Streak & Theme Footer -->
                        </Grid.RowDefinitions>
                        
                        <!-- Logo & Brand Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Width="32" Height="32" CornerRadius="8" Background="#18FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1">
                                <Path Data="M 9 9 L 16 16 L 9 23 M 15 9 L 22 16 L 15 23" 
                                      Stroke="#FFFFFFFF" StrokeThickness="2.2" 
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            
                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="MOMENTUM" FontSize="13" FontWeight="Bold" Foreground="#FFFFFFFF"/>
                                <TextBlock Text="Placement OS" FontSize="10.5" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            
                            <!-- Window Controls -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                                <Button Style="{StaticResource GoldIconButton}" Width="24" Height="24" Click="MinimizeButton_Click" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="9"/>
                                <Button Style="{StaticResource GoldIconButton}" Width="24" Height="24" Click="MaximizeButton_Click" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="3,0,0,0"/>
                                <Button Style="{StaticResource GoldIconButton}" Width="24" Height="24" Click="CloseButton_Click" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="3,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- SDE Readiness Radar Pill -->
                        <Border Grid.Row="1" Margin="0,0,0,16" CornerRadius="12" Padding="12,10"
                                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Width="42" Height="42" Margin="0,0,10,0">
                                    <Grid>
                                        <controls:CircularProgress Value="{Binding PlacementReadinessScore, Mode=OneWay}" StrokeThickness="4"/>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource GoldGradient}">
                                            <TextBlock.Text>
                                                <Binding Path="PlacementReadinessScore" StringFormat="{}{0:0}%"/>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Readiness Score" FontSize="10" Foreground="{StaticResource GoldMutedBrush}"/>
                                    <TextBlock Text="{Binding ReadinessRank}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Navigation Menu (Scrollable) -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- Home / Daily Momentum -->
                                <Button Command="{Binding NavigateToHomeCommand}" Margin="0,0,0,4" HorizontalContentAlignment="Left" Padding="12,9" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHomePage}" Value="True">
                                                    <Setter Property="Background" Value="#25FFFFFF"/>
                                                    <Setter Property="Foreground" Value="{StaticResource GoldGradient}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#12FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Daily Momentum" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- DSA Sheet & Spaced Repetition -->
                                <Button Command="{Binding NavigateToDsaVaultCommand}" Margin="0,0,0,4" HorizontalContentAlignment="Left" Padding="12,9" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDsaVaultPage}" Value="True">
                                                    <Setter Property="Background" Value="#25FFFFFF"/>
                                                    <Setter Property="Foreground" Value="{StaticResource GoldGradient}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#12FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid Width="200">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="DSA Sheet &amp; Revision" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FFEF4444" CornerRadius="8" Padding="6,1"
                                                Visibility="{Binding DueReviewCount, Converter={StaticResource CountToVisibility}}">
                                            <TextBlock Text="{Binding DueReviewCount}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Button>

                                <!-- Core CS Flashcards -->
                                <Button Command="{Binding NavigateToCoreCsCommand}" Margin="0,0,0,4" HorizontalContentAlignment="Left" Padding="12,9" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCoreCsPage}" Value="True">
                                                    <Setter Property="Background" Value="#25FFFFFF"/>
                                                    <Setter Property="Foreground" Value="{StaticResource GoldGradient}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#12FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Core CS Flashcards" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Placement Drive Kanban -->
                                <Button Command="{Binding NavigateToCompaniesCommand}" Margin="0,0,0,4" HorizontalContentAlignment="Left" Padding="12,9" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompaniesPage}" Value="True">
                                                    <Setter Property="Background" Value="#25FFFFFF"/>
                                                    <Setter Property="Foreground" Value="{StaticResource GoldGradient}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#12FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE821;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Placement Kanban" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Mock OA Arena -->
                                <Button Command="{Binding NavigateToMockArenaCommand}" Margin="0,0,0,4" HorizontalContentAlignment="Left" Padding="12,9" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMockArenaPage}" Value="True">
                                                    <Setter Property="Background" Value="#25FFFFFF"/>
                                                    <Setter Property="Foreground" Value="{StaticResource GoldGradient}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#12FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Mock OA Arena" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- STAR Behavioral & HR -->
                                <Button Command="{Binding NavigateToBehavioralCommand}" Margin="0,0,0,4" HorizontalContentAlignment="Left" Padding="12,9" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBehavioralPage}" Value="True">
                                                    <Setter Property="Background" Value="#25FFFFFF"/>
                                                    <Setter Property="Foreground" Value="{StaticResource GoldGradient}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#12FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="STAR HR &amp; Projects" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Analytics & Heatmap -->
                                <Button Command="{Binding NavigateToAnalyticsCommand}" Margin="0,0,0,4" HorizontalContentAlignment="Left" Padding="12,9" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAnalyticsPage}" Value="True">
                                                    <Setter Property="Background" Value="#25FFFFFF"/>
                                                    <Setter Property="Foreground" Value="{StaticResource GoldGradient}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#12FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Readiness &amp; Heatmap" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Achievements -->
                                <Button Command="{Binding NavigateToAchievementsCommand}" Margin="0,0,0,4" HorizontalContentAlignment="Left" Padding="12,9" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAchievementsPage}" Value="True">
                                                    <Setter Property="Background" Value="#25FFFFFF"/>
                                                    <Setter Property="Foreground" Value="{StaticResource GoldGradient}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#12FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="SDE Badges" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- History & Reflections -->
                                <Button Command="{Binding NavigateToHistoryCommand}" Margin="0,0,0,4" HorizontalContentAlignment="Left" Padding="12,9" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHistoryPage}" Value="True">
                                                    <Setter Property="Background" Value="#25FFFFFF"/>
                                                    <Setter Property="Foreground" Value="{StaticResource GoldGradient}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#12FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Reflections Log" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Settings -->
                                <Button Command="{Binding NavigateToSettingsCommand}" Margin="0,0,0,4" HorizontalContentAlignment="Left" Padding="12,9" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                                    <Setter Property="Background" Value="#25FFFFFF"/>
                                                    <Setter Property="Foreground" Value="{StaticResource GoldGradient}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#12FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Settings" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Streak & Theme Footer -->
                        <Border Grid.Row="3" Margin="0,12,0,0" Padding="10,8" CornerRadius="10"
                                Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="{Binding StreakStatusText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource GoldGradient}" VerticalAlignment="Center"/>
                                <Button HorizontalAlignment="Right" Style="{StaticResource GoldIconButton}"
                                        Command="{Binding ToggleThemeCommand}" Width="24" Height="24" Content="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="10" ToolTip="Toggle Theme"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ============================================== -->
                <!-- CENTER - Dynamic Multi-Page Views              -->
                <!-- ============================================== -->
                <Grid Grid.Column="1" Margin="24,20,24,20">

                    <!-- ========================================== -->
                    <!-- PAGE 1: DAILY MOMENTUM (HOME)           -->
                    <!-- ========================================== -->
                    <Grid Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header -->
                            <RowDefinition Height="Auto"/> <!-- Drive Alert Banner -->
                            <RowDefinition Height="Auto"/> <!-- Motivational Card & Progress -->
                            <RowDefinition Height="Auto"/> <!-- Spaced Repetition Due Today Deck -->
                            <RowDefinition Height="*"/>    <!-- Tasks List -->
                        </Grid.RowDefinitions>

                        <!-- Greeting Header -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="{Binding TimeGreeting}" FontSize="13" Foreground="{StaticResource GoldMutedBrush}"/>
                            <TextBlock Text="{Binding TodayDateFormatted}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Upcoming Drive Alert Banner -->
                        <Border Grid.Row="1" Margin="0,0,0,14" CornerRadius="12" Padding="14,10"
                                Background="#18FBBF24" BorderBrush="#40FBBF24" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding UpcomingDriveAlert}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#FFFDE047" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11"
                                        Command="{Binding NavigateToCompaniesCommand}" Content="View Kanban →"/>
                            </Grid>
                        </Border>

                        <!-- Momentum & Daily Tasks Progress Banner (Frosted Glass) -->
                        <Border Grid.Row="2" Margin="0,0,0,16" CornerRadius="16" Padding="20,16"
                                Background="{StaticResource GoldGlassCardBrush}"
                                BorderBrush="{StaticResource UltraGlassBorderBrush}"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="#000000" Opacity="0.25"/>
                            </Border.Effect>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MotivationalMessage}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource GoldGradient}" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding CompletedTodayTasks}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text=" / " FontSize="22" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding TotalTodayTasks}" FontSize="22" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text=" daily targets completed" FontSize="12" Foreground="{StaticResource GoldMutedBrush}" VerticalAlignment="Bottom" Margin="8,0,0,3"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Mini Circular Progress -->
                                <Border Grid.Column="1" Width="70" Height="70" Margin="16,0,0,0">
                                    <Grid>
                                        <controls:CircularProgress Value="{Binding TodayProgress, Mode=OneWay}" StrokeThickness="5"/>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="13" FontWeight="Bold" Foreground="{StaticResource GoldGradient}">
                                            <TextBlock.Text>
                                                <Binding Path="TodayProgress" StringFormat="{}{0:0}%"/>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Spaced Repetition Due Today Deck (Frosted Cyan Glass) -->
                        <Border Grid.Row="3" Margin="0,0,0,16" CornerRadius="16" Padding="18,14"
                                Background="{StaticResource GlassSurfaceBrush}"
                                BorderBrush="{StaticResource CyanGlassBorderBrush}"
                                BorderThickness="1"
                                Visibility="{Binding DueReviewCount, Converter={StaticResource CountToVisibility}}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#000000" Opacity="0.25"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Spaced Repetition Review Due Today" FontSize="13" FontWeight="Bold" Foreground="{StaticResource GoldGradient}"/>
                                    </StackPanel>
                                    <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource GoldMutedBrush}">
                                        <Run Text="{Binding DueReviewCount, Mode=OneWay}"/>
                                        <Run Text=" problems scheduled"/>
                                    </TextBlock>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding DueReviewProblems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="12"
                                                    Background="{StaticResource GoldGlassCardBrush}"
                                                    BorderBrush="{StaticResource GlassBorderSubtle}"
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,10,0"
                                                            Background="{Binding DifficultyColor, Converter={StaticResource HexToBrush}}"/>
                                                    
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <TextBlock FontSize="10" Foreground="{StaticResource GoldMutedBrush}">
                                                            <Run Text="{Binding TopicDisplay, Mode=OneWay}"/>
                                                            <Run Text=" • "/>
                                                            <Run Text="{Binding Pattern, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- Quick Review Confidence Buttons -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="10" Margin="0,0,6,0"
                                                                Command="{Binding DataContext.ReviewHardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" ToolTip="Review again tomorrow">
                                                            <TextBlock Text="Hard (1d)" Foreground="#EF4444" FontWeight="SemiBold"/>
                                                        </Button>
                                                        <Button Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="10" Margin="0,0,6,0"
                                                                Command="{Binding DataContext.ReviewGoodCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" ToolTip="Review in 3-4 days">
                                                            <TextBlock Text="Good (3d)" Foreground="#FBBF24" FontWeight="SemiBold"/>
                                                        </Button>
                                                        <Button Style="{StaticResource GoldButton}" Padding="8,4" FontSize="10"
                                                                Command="{Binding DataContext.ReviewEasyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" ToolTip="Mastered! Review in 7-14 days">
                                                            <TextBlock Text="Easy (7d)" FontWeight="SemiBold"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Today's Tasks Section -->
                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Today's Placement Tasks" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource GoldMutedBrush}">
                                    <TextBlock.Text>
                                        <Binding Path="RemainingTodayTasks" StringFormat="{}{0} remaining"/>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>

                            <!-- Task Items List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Empty Tasks Message -->
                                    <Border Margin="0,20,0,0" Visibility="{Binding HasNoTasks, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="36" HorizontalAlignment="Center" Foreground="{StaticResource GoldMutedBrush}" Opacity="0.5"/>
                                            <TextBlock Text="All targets clear for today!" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource GoldGradient}" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                                            <TextBlock Text="Use the Quick Add panel on the right to set today's problems &amp; revision." FontSize="12" Foreground="{StaticResource GoldMutedBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding TodayTasks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" CornerRadius="14" Padding="14,12"
                                                        Background="{StaticResource GlassSurfaceBrush}"
                                                        BorderBrush="{StaticResource GlassBorderSubtle}"
                                                        BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Button Style="{StaticResource GoldCheckButton}"
                                                                Command="{Binding DataContext.CompleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Tag="{Binding IsCompleted, Converter={StaticResource BoolToTag}}"
                                                                VerticalAlignment="Center"/>

                                                        <Border Grid.Column="1" Margin="8,0,0,0" Padding="6,2" CornerRadius="4" Background="#18FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" VerticalAlignment="Center" ToolTip="{Binding EnergyLabel}">
                                                            <TextBlock Text="{Binding EnergyEmoji}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource GoldMutedBrush}"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Title}" FontSize="13" TextWrapping="Wrap">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Border Grid.Column="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                                        Visibility="{Binding IsDailyHighlight, Converter={StaticResource BoolToVisibility}}"
                                                                        Background="#FFFFFFFF">
                                                                    <TextBlock Text="HIGHLIGHT" FontSize="8" FontWeight="Bold" Foreground="#0A0A0F"/>
                                                                </Border>
                                                            </Grid>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                                            <Button Style="{StaticResource GoldIconButton}" Command="{Binding DataContext.EnterFocusModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="11" Width="28" Height="28" ToolTip="Pomodoro Focus" Margin="0,0,4,0"
                                                                    Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityInverse}}"/>
                                                            <Button Style="{StaticResource GoldIconButton}" Command="{Binding DataContext.SetDailyHighlightCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" Content="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="11" Width="28" Height="28" ToolTip="Set as Daily Highlight" Margin="0,0,4,0"
                                                                    Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityInverse}}"/>
                                                            <Button Style="{StaticResource GoldIconButton}" Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9" Width="28" Height="28" ToolTip="Delete Task"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid> <!-- End Home Page -->

                    <!-- ========================================== -->
                    <!-- PAGE 2: DSA SHEET & REVISION (DsaVault) -->
                    <!-- ========================================== -->
                    <Grid Visibility="{Binding IsDsaVaultPage, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Title & Stats Summary -->
                            <RowDefinition Height="Auto"/> <!-- Safe LeetCode Live Sync Bar -->
                            <RowDefinition Height="Auto"/> <!-- Search & Filter Controls -->
                            <RowDefinition Height="*"/>    <!-- Problem List -->
                        </Grid.RowDefinitions>

                        <!-- Header & Metrics -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Curated SDE Sheet &amp; Pattern Matrix" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Master high-frequency placement patterns with intelligent spaced repetition" FontSize="12" Foreground="{StaticResource GoldMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Stats Pills -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Margin="0,0,8,0" Padding="12,6" CornerRadius="8" Background="#184ADE80" BorderBrush="#404ADE80" BorderThickness="1">
                                    <TextBlock FontSize="11" Foreground="#4ADE80">
                                        <Run Text="Solved: "/>
                                        <Run Text="{Binding TotalDsaSolved, Mode=OneWay}" FontWeight="Bold"/>
                                        <Run Text=" / "/>
                                        <Run Text="{Binding TotalDsaCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                                <Border Margin="0,0,8,0" Padding="10,6" CornerRadius="8" Background="#18FBBF24" BorderBrush="#40FBBF24" BorderThickness="1">
                                    <TextBlock FontSize="11" Foreground="#FBBF24">
                                        <Run Text="Med: "/>
                                        <Run Text="{Binding MediumDsaSolved, Mode=OneWay}" FontWeight="Bold"/>
                                    </TextBlock>
                                </Border>
                                <Border Padding="10,6" CornerRadius="8" Background="#18EF4444" BorderBrush="#40EF4444" BorderThickness="1">
                                    <TextBlock FontSize="11" Foreground="#EF4444">
                                        <Run Text="Hard: "/>
                                        <Run Text="{Binding HardDsaSolved, Mode=OneWay}" FontWeight="Bold"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- ============================================== -->
                        <!-- LEETCODE SAFE CONNECTION & REAL-TIME SYNC BAR  -->
                        <!-- ============================================== -->
                        <Border Grid.Row="1" Margin="0,0,0,16" CornerRadius="16" Padding="18,14"
                                Background="{StaticResource GoldGlassCardBrush}"
                                BorderBrush="{StaticResource CyanGlassBorderBrush}"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="#000000" Opacity="0.25"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top Row: Icon, Title, Security Badge & Profile Quick Glance -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="32" Height="32" CornerRadius="8" Background="#25FFA116" BorderBrush="#FFA116" BorderThickness="1" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFA116"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="LeetCode Live Sync" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <!-- Security Badge -->
                                                <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="10" Background="#184ADE80" BorderBrush="#404ADE80" BorderThickness="1">
                                                    <TextBlock Text="SECURE • Zero Passwords (Public GraphQL API)" FontSize="10" FontWeight="SemiBold" Foreground="#4ADE80"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LeetCodeStatusMessage}" FontSize="11" Foreground="{StaticResource GoldMutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Connected Live Stats Badges (Right aligned) -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Visibility="{Binding IsLeetCodeConnected, Converter={StaticResource BoolToVisibility}}">
                                        <Border Margin="0,0,6,0" Padding="10,4" CornerRadius="8" Background="#18FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1">
                                            <TextBlock FontSize="11" Foreground="#FFFFFFFF">
                                                <Run Text="@"/>
                                                <Run Text="{Binding LeetCodeUsername}" FontWeight="Bold"/>
                                            </TextBlock>
                                        </Border>
                                        <Border Margin="0,0,6,0" Padding="10,4" CornerRadius="8" Background="#184ADE80" BorderBrush="#404ADE80" BorderThickness="1">
                                            <TextBlock FontSize="11" Foreground="#4ADE80">
                                                <Run Text="Solved: "/>
                                                <Run Text="{Binding LeetCodeTotalSolved}" FontWeight="Bold"/>
                                            </TextBlock>
                                        </Border>
                                        <Border Margin="0,0,6,0" Padding="10,4" CornerRadius="8" Background="#18FBBF24" BorderBrush="#40FBBF24" BorderThickness="1">
                                            <TextBlock FontSize="11" Foreground="#FBBF24">
                                                <Run Text="Rank: #"/>
                                                <Run Text="{Binding LeetCodeRanking, StringFormat={}{0:N0}}" FontWeight="Bold"/>
                                            </TextBlock>
                                        </Border>
                                        <Button Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11"
                                                Command="{Binding ClearLeetCodeCommand}" Content="Disconnect" ToolTip="Disconnect current profile"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Bottom Row: Inputs & Action -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Username Input -->
                                    <TextBox Grid.Column="0" Style="{StaticResource PremiumTextBox}" FontSize="12" Padding="12,7"
                                             Text="{Binding LeetCodeUsername, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Enter your public LeetCode username (e.g. tourist, neetcode, or your own handle)">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding SyncLeetCodeCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>

                                    <!-- Sync Button -->
                                    <Button Grid.Column="1" Style="{StaticResource GoldButton}" Margin="10,0,0,0" Padding="18,7" FontSize="12"
                                            Command="{Binding SyncLeetCodeCommand}"
                                            IsEnabled="{Binding IsLeetCodeSyncing, Converter={StaticResource InverseBool}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding LeetCodeSyncButtonText}" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Sync Explanation / Info -->
                                    <TextBlock Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                        <Run Text="Solved problems in SDE Sheet are auto-marked as "/>
                                        <Run Text="Solved" Foreground="#4ADE80" FontWeight="SemiBold"/>
                                        <Run Text=" &amp; scheduled for revision."/>
                                    </TextBlock>

                                    <!-- Last Synced Timestamp -->
                                    <TextBlock Grid.Column="3" Text="{Binding LeetCodeLastSyncedDisplay}" FontSize="11"
                                               Foreground="{StaticResource GoldMutedBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Filter & Search Controls (Frosted Glass Container) -->
                        <Border Grid.Row="2" Margin="0,0,0,16" Padding="14,12" CornerRadius="14"
                                Background="{StaticResource GlassSurfaceBrush}"
                                BorderBrush="{StaticResource GlassBorderSubtle}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Search Box -->
                                <TextBox Style="{StaticResource PremiumTextBox}" Padding="10,6" FontSize="12"
                                         Text="{Binding DsaSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Search by problem name, pattern, or company..."/>

                                <!-- Topic Filter -->
                                <ComboBox Grid.Column="1" Margin="8,0,0,0" Padding="8,6" FontSize="11"
                                          SelectedValue="{Binding SelectedDsaTopicFilter}" SelectedValuePath="Content">
                                    <ComboBoxItem Content="All Topics" IsSelected="True"/>
                                    <ComboBoxItem Content="Arrays &amp; Hashing"/>
                                    <ComboBoxItem Content="Two Pointers"/>
                                    <ComboBoxItem Content="Sliding Window"/>
                                    <ComboBoxItem Content="Stack &amp; Queue"/>
                                    <ComboBoxItem Content="Binary Search"/>
                                    <ComboBoxItem Content="Linked List"/>
                                    <ComboBoxItem Content="Trees &amp; BST"/>
                                    <ComboBoxItem Content="Graphs &amp; Topological Sort"/>
                                    <ComboBoxItem Content="Dynamic Programming"/>
                                    <ComboBoxItem Content="Greedy &amp; Intervals"/>
                                    <ComboBoxItem Content="Heap / Priority Queue"/>
                                </ComboBox>

                                <!-- Difficulty Filter -->
                                <ComboBox Grid.Column="2" Margin="8,0,0,0" Padding="8,6" FontSize="11"
                                          SelectedValue="{Binding SelectedDsaDifficultyFilter}" SelectedValuePath="Content">
                                    <ComboBoxItem Content="All" IsSelected="True"/>
                                    <ComboBoxItem Content="Easy"/>
                                    <ComboBoxItem Content="Medium"/>
                                    <ComboBoxItem Content="Hard"/>
                                </ComboBox>

                                <!-- Status Filter -->
                                <ComboBox Grid.Column="3" Margin="8,0,0,0" Padding="8,6" FontSize="11"
                                          SelectedValue="{Binding SelectedDsaStatusFilter}" SelectedValuePath="Content">
                                    <ComboBoxItem Content="All" IsSelected="True"/>
                                    <ComboBoxItem Content="Solved"/>
                                    <ComboBoxItem Content="Unsolved"/>
                                    <ComboBoxItem Content="Due for Review"/>
                                </ComboBox>

                                <!-- Due Revision Toggle -->
                                <CheckBox Grid.Column="4" Margin="14,0,0,0" VerticalAlignment="Center"
                                          IsChecked="{Binding OnlyDueForReviewFilter}" Content="Only Reviews Due"
                                          Foreground="{StaticResource GoldGradient}" FontSize="11"/>

                                <!-- Add Problem Bar Expander Toggle -->
                                <Button Grid.Column="5" Style="{StaticResource GoldButton}" Padding="14,6" FontSize="11"
                                        Command="{Binding AddDsaProblemCommand}" Content="+ Add Problem"/>
                            </Grid>
                        </Border>

                        <!-- Problem List with Scroll -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" controls:SmoothScrollHelper.SmoothScroll="True">
                            <ItemsControl ItemsSource="{Binding FilteredDsaProblems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" CornerRadius="14" Padding="14"
                                                Background="{StaticResource GlassSurfaceBrush}"
                                                BorderBrush="{StaticResource GlassBorderSubtle}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/> <!-- Solved Checkbox -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Difficulty Tag -->
                                                        <ColumnDefinition Width="*"/>    <!-- Title & Pattern -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Complexities -->
                                                        <ColumnDefinition Width="Auto"/> <!-- LeetCode & Expand -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Check Toggle -->
                                                    <Button Style="{StaticResource GoldCheckButton}"
                                                            Command="{Binding DataContext.ToggleDsaSolvedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Tag="{Binding IsSolved, Converter={StaticResource BoolToTag}}"
                                                            VerticalAlignment="Center"/>

                                                    <!-- Difficulty Badge -->
                                                    <Border Grid.Column="1" Margin="12,0,0,0" Padding="8,3" CornerRadius="6" VerticalAlignment="Center"
                                                            Background="{Binding DifficultyColor, Converter={StaticResource HexToBrush}}" Opacity="0.9">
                                                        <TextBlock Text="{Binding DifficultyDisplay}" FontSize="10" FontWeight="Bold" Foreground="#0A0A0F"/>
                                                    </Border>

                                                    <!-- Problem Title & Meta -->
                                                    <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSolved}" Value="True">
                                                                                <Setter Property="Foreground" Value="#4ADE80"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <!-- Review Due Badge -->
                                                            <Border Margin="10,0,0,0" Padding="6,1" CornerRadius="4" Background="#25FBBF24"
                                                                    Visibility="{Binding IsDueForReview, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Text="{Binding ReviewDueText}" FontSize="9" FontWeight="Bold" Foreground="#FBBF24"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding TopicDisplay}" FontSize="11" Foreground="{StaticResource GoldGradient}"/>
                                                            <TextBlock Text=" • Pattern: " FontSize="11" Foreground="{StaticResource GoldMutedBrush}"/>
                                                            <TextBlock Text="{Binding Pattern}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            <TextBlock Text=" • " FontSize="11" Foreground="{StaticResource GoldMutedBrush}"
                                                                       Visibility="{Binding CompanyTags, Converter={StaticResource StringToVisibility}}"/>
                                                            <TextBlock Text="{Binding CompanyTags}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Visibility="{Binding CompanyTags, Converter={StaticResource StringToVisibility}}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Complexities -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,16,0">
                                                        <Border Padding="6,3" CornerRadius="6" Background="#12FFFFFF" Margin="0,0,6,0">
                                                            <TextBlock FontSize="10" Foreground="{StaticResource GoldMutedBrush}">
                                                                <Run Text="Time: "/>
                                                                <Run Text="{Binding TimeComplexity, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                                            </TextBlock>
                                                        </Border>
                                                        <Border Padding="6,3" CornerRadius="6" Background="#12FFFFFF">
                                                            <TextBlock FontSize="10" Foreground="{StaticResource GoldMutedBrush}">
                                                                <Run Text="Space: "/>
                                                                <Run Text="{Binding SpaceComplexity, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Actions -->
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- LeetCode Link -->
                                                        <Button Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="11" Margin="0,0,6,0"
                                                                Command="{Binding DataContext.OpenLeetCodeUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" Content="LeetCode ↗"/>

                                                        <!-- Expand Notes -->
                                                        <Button Style="{StaticResource GoldIconButton}" Width="30" Height="30" FontSize="11"
                                                                Command="{Binding DataContext.ToggleDsaExpandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" Content="&#xE81C;" FontFamily="Segoe MDL2 Assets" ToolTip="View Intuition Notes &amp; Code"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Expanded Intuition & Notes Drawer -->
                                                <Border Margin="0,12,0,0" Padding="14" CornerRadius="10" Background="#10FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1"
                                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                    <StackPanel>
                                                        <!-- Aha Moment -->
                                                        <TextBlock Text="Intuition &amp; Key Pattern:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GoldGradient}"/>
                                                        <TextBlock Text="{Binding IntuitionNotes}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>

                                                        <!-- Code Snippet -->
                                                        <TextBlock Text="Optimal Code Snippet:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GoldMutedBrush}"
                                                                   Visibility="{Binding CodeSnippet, Converter={StaticResource StringToVisibility}}"/>
                                                        <TextBox Style="{StaticResource PremiumTextBox}" FontFamily="Consolas, Cascadia Code" FontSize="11"
                                                                 Text="{Binding CodeSnippet}" IsReadOnly="True" AcceptsReturn="True" Height="70" Margin="0,4,0,10"
                                                                 Visibility="{Binding CodeSnippet, Converter={StaticResource StringToVisibility}}"/>

                                                        <!-- Spaced Repetition Buttons -->
                                                        <Grid Margin="0,4,0,0">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="Record Review: " FontSize="11" Foreground="{StaticResource GoldMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <Button Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="10" Margin="0,0,6,0"
                                                                        Command="{Binding DataContext.ReviewHardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}">
                                                                    <TextBlock Text="Hard (1d)" Foreground="#EF4444"/>
                                                                </Button>
                                                                <Button Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="10" Margin="0,0,6,0"
                                                                        Command="{Binding DataContext.ReviewGoodCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}">
                                                                    <TextBlock Text="Good (3d)" Foreground="#FBBF24"/>
                                                                </Button>
                                                                <Button Style="{StaticResource GoldButton}" Padding="8,4" FontSize="10"
                                                                        Command="{Binding DataContext.ReviewEasyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}">
                                                                    <TextBlock Text="Mastered (7d)"/>
                                                                </Button>
                                                            </StackPanel>

                                                            <!-- Delete Problem -->
                                                            <Button HorizontalAlignment="Right" Style="{StaticResource GoldIconButton}" Width="26" Height="26"
                                                                    Command="{Binding DataContext.DeleteDsaProblemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9" ToolTip="Delete Problem"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid> <!-- End DSA Vault -->

                    <!-- ========================================== -->
                    <!-- PAGE 3: CORE CS & FLASHCARDS (CoreCs)   -->
                    <!-- ========================================== -->
                    <Grid Visibility="{Binding IsCoreCsPage, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header & Study Deck Toggle -->
                            <RowDefinition Height="Auto"/> <!-- Subject Filter & Search -->
                            <RowDefinition Height="*"/>    <!-- Deck or Grid Content Area -->
                        </Grid.RowDefinitions>

                        <!-- Header & Mode Switcher -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Core CS Fundamentals &amp; High-Yield Flashcards" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Active recall study deck &amp; cheat-sheet for OS, DBMS, Networks, OOP &amp; System Design" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- Mode Switcher Pills -->
                                <Border Background="#15FFFFFF" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="3" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding ToggleStudyDeckModeCommand}" Padding="12,6" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStudyDeckMode}" Value="True">
                                                            <Setter Property="Background" Value="#30FFFFFF"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="Study Deck" FontSize="11" FontWeight="SemiBold"/>
                                        </Button>

                                        <Button Command="{Binding ToggleStudyDeckModeCommand}" Padding="12,6" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAllCardsMode}" Value="True">
                                                            <Setter Property="Background" Value="#30FFFFFF"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="All Cards List" FontSize="11" FontWeight="SemiBold"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Mastered Stats Pill -->
                                <Border Padding="14,6" CornerRadius="10" Background="#2010B981" BorderBrush="#5010B981" BorderThickness="1">
                                    <TextBlock FontSize="12" Foreground="#10B981">
                                        <Run Text="Mastered: "/>
                                        <Run Text="{Binding TotalCoreCsMastered, Mode=OneWay}" FontWeight="Bold"/>
                                        <Run Text=" / "/>
                                        <Run Text="{Binding TotalCoreCsCount, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Subject Filters & Search -->
                        <Border Grid.Row="1" Margin="0,0,0,16" Padding="12,10" CornerRadius="12" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Style="{StaticResource ModernTextBox}" Padding="10,6" FontSize="12"
                                         Text="{Binding CoreCsSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Search question, keyword, or concept..."/>

                                <ComboBox Grid.Column="1" HorizontalAlignment="Right" Width="220" Padding="8,6" FontSize="11"
                                          SelectedValue="{Binding SelectedCoreCsSubjectFilter}" SelectedValuePath="Content">
                                    <ComboBoxItem Content="All Subjects" IsSelected="True"/>
                                    <ComboBoxItem Content="Operating Systems"/>
                                    <ComboBoxItem Content="DBMS &amp; SQL"/>
                                    <ComboBoxItem Content="Computer Networks"/>
                                    <ComboBoxItem Content="OOP &amp; Design Patterns"/>
                                    <ComboBoxItem Content="System Design / LLD"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- VIEW A: INTERACTIVE FLASHCARD STUDY DECK -->
                        <Grid Grid.Row="2" Visibility="{Binding IsStudyDeckMode, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>    <!-- Center Flashcard -->
                                <RowDefinition Height="Auto"/> <!-- Bottom Controls Toolbar -->
                            </Grid.RowDefinitions>

                            <!-- Center Flashcard Container (Click to Flip!) -->
                            <Border Grid.Row="0" Margin="40,10,40,20" CornerRadius="20" Padding="28,24" Cursor="Hand"
                                    Background="{StaticResource GoldGlassCardBrush}"
                                    BorderBrush="{StaticResource GoldGlassBorderBrush}"
                                    BorderThickness="1.5">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding FlipCurrentFlashcardCommand}"/>
                                </Border.InputBindings>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.4"/>
                                </Border.Effect>

                                <Grid DataContext="{Binding CurrentFlashcard}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Card Top Metadata -->
                                        <RowDefinition Height="*"/>    <!-- Front / Back Card Body -->
                                        <RowDefinition Height="Auto"/> <!-- Flip Hint Footer -->
                                    </Grid.RowDefinitions>

                                    <!-- Top Metadata Row -->
                                    <Grid Grid.Row="0" Margin="0,0,0,16">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Subject Tag -->
                                            <Border Padding="10,4" CornerRadius="8" Background="{Binding SubjectColor, Converter={StaticResource HexToBrush}}" Opacity="0.95">
                                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="#0A0A0F">
                                                    <Run Text="{Binding SubjectEmoji, Mode=OneWay}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding SubjectDisplay, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border>

                                            <!-- Frequency Badge -->
                                            <Border Margin="10,0,0,0" Padding="8,4" CornerRadius="6" Background="#18FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1">
                                                <TextBlock Text="{Binding Frequency, StringFormat='{}{0} Priority'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GoldGradient}"/>
                                            </Border>

                                            <!-- Mastery Status Badge -->
                                            <Border Margin="10,0,0,0" Padding="8,4" CornerRadius="6"
                                                    Visibility="{Binding IsMastered, Converter={StaticResource BoolToVisibility}}"
                                                    Background="#2510B981" BorderBrush="#5010B981" BorderThickness="1">
                                                <TextBlock Text="Mastered" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Card Counter -->
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Text="{Binding DataContext.FlashcardProgressText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Grid>

                                    <!-- CARD FRONT (QUESTION VIEW) -->
                                    <Grid Grid.Row="1" Visibility="{Binding IsFlipped, Converter={StaticResource BoolToVisibilityInverse}}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0">
                                            <TextBlock Text="QUESTION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentSecondaryBrush}" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Question}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap" TextAlignment="Center" LineHeight="30" Margin="0,0,0,18"/>
                                            
                                            <!-- Keywords Preview -->
                                            <Border Background="#12FFFFFF" CornerRadius="8" Padding="12,6" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center">
                                                    <Run Text="Key Concepts: " FontWeight="SemiBold" Foreground="{StaticResource GoldGradient}"/>
                                                    <Run Text="{Binding HighYieldKeywords, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- CARD BACK (ANSWER & EXPLANATION VIEW) -->
                                    <Grid Grid.Row="1" Visibility="{Binding IsFlipped, Converter={StaticResource BoolToVisibility}}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel Margin="10,0">
                                                <!-- Quick Summary Box -->
                                                <Border CornerRadius="12" Padding="14,12" Background="#18FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" Margin="0,0,0,14">
                                                    <StackPanel>
                                                        <TextBlock Text="Quick Interview Summary:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <TextBlock Text="{Binding ShortAnswer}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="20"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Detailed Explanation -->
                                                <Border CornerRadius="12" Padding="14,12" Background="#12FFFFFF" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="1">
                                                    <StackPanel>
                                                        <TextBlock Text="Detailed Technical Explanation:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                                        <TextBlock Text="{Binding DetailedExplanation}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="19"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>

                                    <!-- Bottom Click-To-Flip Instruction -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Click anywhere on card to reveal detailed answer"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFlipped}" Value="True">
                                                            <Setter Property="Text" Value="Click anywhere on card to flip back to question"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Bottom Study Deck Controls Toolbar -->
                            <Grid Grid.Row="1" Margin="40,0,40,10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding PreviousFlashcardCommand}" Padding="16,9" Content="Previous Card" ToolTip="Go to previous card"/>
                                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ShuffleFlashcardsCommand}" Margin="10,0,0,0" Padding="14,9" Content="Shuffle Deck" ToolTip="Shuffle cards randomly"/>
                                </StackPanel>

                                <Button Style="{StaticResource GoldButton}" HorizontalAlignment="Center" Command="{Binding FlipCurrentFlashcardCommand}" Width="160" Height="38" Content="Flip Card" FontSize="13" FontWeight="Bold" ToolTip="Flip card (Space)"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding MarkCurrentNeedsReviewCommand}" Padding="14,9" Content="Needs Review" ToolTip="Mark as needing review and advance"/>
                                    <Button Style="{StaticResource ModernButton}" Command="{Binding MarkCurrentMasteredCommand}" Margin="10,0,0,0" Padding="16,9" Content="Mark Mastered" Background="#FF10B981" Foreground="#FFFFFFFF" FontWeight="Bold" ToolTip="Mark as mastered and advance!"/>
                                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding NextFlashcardCommand}" Margin="10,0,0,0" Padding="16,9" Content="Next Card" ToolTip="Go to next card"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- VIEW B: ALL CARDS LIST (CHEAT-SHEET GRID) -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsAllCardsMode, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding FilteredCoreCsQuestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,12" CornerRadius="14" Padding="18,16"
                                                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <!-- Card Top: Subject & Frequency Badge -->
                                                <Grid Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Padding="8,3" CornerRadius="6" Background="{Binding SubjectColor, Converter={StaticResource HexToBrush}}" Opacity="0.95">
                                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#0A0A0F">
                                                                <Run Text="{Binding SubjectEmoji, Mode=OneWay}"/>
                                                                <Run Text=" "/>
                                                                <Run Text="{Binding SubjectDisplay, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </Border>
                                                        <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4" Background="#18FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1">
                                                            <TextBlock Text="{Binding Frequency, StringFormat='Freq: {0}'}" FontSize="10" Foreground="{StaticResource GoldGradient}"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11"
                                                            Command="{Binding DataContext.ToggleCoreCsMasteredCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Mark as Mastered"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMastered}" Value="True">
                                                                            <Setter Property="Text" Value="Mastered"/>
                                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                </Grid>

                                                <!-- Question -->
                                                <TextBlock Text="{Binding Question}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                                <!-- High-Yield Keywords Pill -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <TextBlock Text="High-Yield Keywords: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{Binding HighYieldKeywords}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GoldGradient}"/>
                                                </StackPanel>

                                                <!-- Flip / Show Answer Button -->
                                                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="12,6" FontSize="11"
                                                        Command="{Binding DataContext.ToggleFlashcardAnswerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Show Detailed Answer"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFlipped}" Value="True">
                                                                        <Setter Property="Text" Value="Hide Detailed Answer"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>

                                                <!-- Answer Drawer -->
                                                <Border Margin="0,10,0,0" Padding="14" CornerRadius="10" Background="#12FFFFFF" BorderBrush="{StaticResource DarkBorderBrush}" BorderThickness="1"
                                                        Visibility="{Binding IsFlipped, Converter={StaticResource BoolToVisibility}}">
                                                    <StackPanel>
                                                        <TextBlock Text="Quick Summary:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding ShortAnswer}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>

                                                        <TextBlock Text="Detailed Explanation:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                        <TextBlock Text="{Binding DetailedExplanation}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid> <!-- End Core CS -->

                    <!-- ========================================== -->
                    <!-- PAGE 4: PLACEMENT KANBAN (Companies)    -->
                    <!-- ========================================== -->
                    <Grid Visibility="{Binding IsCompaniesPage, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Title & Top Stats -->
                            <RowDefinition Height="Auto"/> <!-- Add Company Quick Bar -->
                            <RowDefinition Height="*"/>    <!-- 5 Horizontal Kanban Columns -->
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Campus &amp; Job Placement Kanban Pipeline" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Track company drives from application through OA and Technical interviews to final Offer" FontSize="12" Foreground="{StaticResource GoldMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Margin="0,0,8,0" Padding="12,6" CornerRadius="8" Background="#18FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1">
                                    <TextBlock FontSize="11" Foreground="#FFFFFFFF">
                                        <Run Text="Active Drives: "/>
                                        <Run Text="{Binding ActiveCompaniesCount, Mode=OneWay}" FontWeight="Bold"/>
                                    </TextBlock>
                                </Border>
                                <Border Padding="12,6" CornerRadius="8" Background="#204ADE80" BorderBrush="#504ADE80" BorderThickness="1">
                                    <TextBlock FontSize="11" Foreground="#4ADE80">
                                        <Run Text="Offers Secured: "/>
                                        <Run Text="{Binding OffersCount, Mode=OneWay}" FontWeight="Bold"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Add Company Quick Bar -->
                        <Border Grid.Row="1" Margin="0,0,0,16" Padding="14,10" CornerRadius="12" Background="#12FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Style="{StaticResource PremiumTextBox}" Padding="8,5" FontSize="11" Text="{Binding NewCompanyName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Company Name (e.g. Google, Amazon)">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding AddCompanyCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBox Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource PremiumTextBox}" Padding="8,5" FontSize="11" Text="{Binding NewCompanyRole, UpdateSourceTrigger=PropertyChanged}" ToolTip="Role (e.g. SDE-1)"/>
                                <TextBox Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource PremiumTextBox}" Padding="8,5" FontSize="11" Text="{Binding NewCompanyPackage, UpdateSourceTrigger=PropertyChanged}" ToolTip="CTC (e.g. 24 LPA)"/>
                                <TextBox Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource PremiumTextBox}" Padding="8,5" FontSize="11" Text="{Binding NewCompanyEvent, UpdateSourceTrigger=PropertyChanged}" ToolTip="Upcoming Event (e.g. Online Assessment)"/>
                                <TextBox Grid.Column="4" Margin="8,0,0,0" Style="{StaticResource PremiumTextBox}" Padding="8,5" FontSize="11" Text="{Binding NewCompanyFocus, UpdateSourceTrigger=PropertyChanged}" ToolTip="Focus Topics (e.g. DP, Graphs, OS)"/>

                                <Button Grid.Column="5" Margin="8,0,0,0" Style="{StaticResource GoldButton}" Padding="14,6" FontSize="11"
                                        Command="{Binding AddCompanyCommand}" Content="+ Add Drive"/>
                            </Grid>
                        </Border>

                        <!-- Kanban Columns Board -->
                        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <Grid MinWidth="1100">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 1: Wishlist / Applied -->
                                <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="14" Padding="12" Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Wishlist &amp; Applied" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding AppliedApplications}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,10" CornerRadius="10" Padding="12" Background="#15FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <TextBlock Text="{Binding CompanyName}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GoldGradient}"/>
                                                                    <TextBlock Text="{Binding PackageCtc}" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="#4ADE80"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Role}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,6"/>
                                                                <TextBlock Text="{Binding UpcomingEventTitle}" FontSize="10" Foreground="#FBBF24" Margin="0,0,0,4"/>
                                                                <TextBlock Text="{Binding EventCountdown}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GoldMutedBrush}" Margin="0,0,0,8"/>
                                                                
                                                                <Grid>
                                                                    <Button HorizontalAlignment="Left" Style="{StaticResource GoldIconButton}" Width="24" Height="24"
                                                                            Command="{Binding DataContext.DeleteCompanyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="8"/>
                                                                    <Button HorizontalAlignment="Right" Style="{StaticResource GoldButton}" Padding="10,4" FontSize="10"
                                                                            Command="{Binding DataContext.MoveCompanyNextCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" Content="OA →"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <!-- Column 2: Online Assessment (OA) -->
                                <Border Grid.Column="1" Margin="0,0,8,0" CornerRadius="14" Padding="12" Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Online Assessment (OA)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding OaApplications}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,10" CornerRadius="10" Padding="12" Background="#15FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <TextBlock Text="{Binding CompanyName}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GoldGradient}"/>
                                                                    <TextBlock Text="{Binding PackageCtc}" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="#4ADE80"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Role}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,6"/>
                                                                <TextBlock Text="{Binding UpcomingEventTitle}" FontSize="10" Foreground="#FFFDE047" Margin="0,0,0,4"/>
                                                                <TextBlock Text="{Binding EventCountdown}" FontSize="9" FontWeight="Bold" Foreground="#FBBF24" Margin="0,0,0,8"/>
                                                                <TextBlock Text="{Binding FocusTopics, StringFormat='Focus: {0}'}" FontSize="10" Foreground="{StaticResource GoldMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                                                <Grid>
                                                                    <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Padding="6,3" FontSize="9"
                                                                            Command="{Binding DataContext.MoveCompanyPrevCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" Content="←"/>
                                                                    <Button HorizontalAlignment="Right" Style="{StaticResource GoldButton}" Padding="10,4" FontSize="10"
                                                                            Command="{Binding DataContext.MoveCompanyNextCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" Content="Tech →"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <!-- Column 3: Technical Round -->
                                <Border Grid.Column="2" Margin="0,0,8,0" CornerRadius="14" Padding="12" Background="#10FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Technical Round" FontSize="13" FontWeight="Bold" Foreground="#FFFFFFFF" Margin="0,0,0,12"/>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding TechnicalApplications}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,10" CornerRadius="10" Padding="12" Background="#18FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <TextBlock Text="{Binding CompanyName}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GoldGradient}"/>
                                                                    <TextBlock Text="{Binding PackageCtc}" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="#4ADE80"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Role}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,6"/>
                                                                <TextBlock Text="{Binding UpcomingEventTitle}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                                <TextBlock Text="{Binding EventCountdown}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                                                                <TextBlock Text="{Binding FocusTopics, StringFormat='Focus: {0}'}" FontSize="10" Foreground="{StaticResource GoldMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                                                <Grid>
                                                                    <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Padding="6,3" FontSize="9"
                                                                            Command="{Binding DataContext.MoveCompanyPrevCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" Content="←"/>
                                                                    <Button HorizontalAlignment="Right" Style="{StaticResource GoldButton}" Padding="10,4" FontSize="10"
                                                                            Command="{Binding DataContext.MoveCompanyNextCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" Content="HR →"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <!-- Column 4: HR / Leadership -->
                                <Border Grid.Column="3" Margin="0,0,8,0" CornerRadius="14" Padding="12" Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="HR &amp; Leadership" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding HrApplications}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,10" CornerRadius="10" Padding="12" Background="#15FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <TextBlock Text="{Binding CompanyName}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GoldGradient}"/>
                                                                    <TextBlock Text="{Binding PackageCtc}" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="#4ADE80"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Role}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,6"/>
                                                                <TextBlock Text="{Binding UpcomingEventTitle}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                                <TextBlock Text="{Binding EventCountdown}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>

                                                                <Grid>
                                                                    <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Padding="6,3" FontSize="9"
                                                                            Command="{Binding DataContext.MoveCompanyPrevCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" Content="←"/>
                                                                    <Button HorizontalAlignment="Right" Style="{StaticResource GoldButton}" Padding="10,4" FontSize="10"
                                                                            Command="{Binding DataContext.MoveCompanyNextCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" Content="Offer →"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <!-- Column 5: Offer Secured! -->
                                <Border Grid.Column="4" CornerRadius="14" Padding="12" Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Offer Secured" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding OfferedApplications}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,10" CornerRadius="10" Padding="14" Background="#15FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1">
                                                            <StackPanel>
                                                                <TextBlock Text="OFFER RECEIVED" FontSize="9" FontWeight="Bold" Foreground="#4ADE80" Margin="0,0,0,4"/>
                                                                <TextBlock Text="{Binding CompanyName}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource GoldGradient}"/>
                                                                <TextBlock Text="{Binding PackageCtc}" FontSize="14" FontWeight="Bold" Foreground="#4ADE80" Margin="0,2,0,4"/>
                                                                <TextBlock Text="{Binding Role}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid> <!-- End Kanban -->

                    <!-- ========================================== -->
                    <!-- PAGE 5: MOCK OA ARENA (MockArena)       -->
                    <!-- ========================================== -->
                    <Grid Visibility="{Binding IsMockArenaPage, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Title & Controls -->
                            <RowDefinition Height="*"/>    <!-- Arena Split: Left Problem & Timer, Right Code Editor -->
                        </Grid.RowDefinitions>

                        <!-- Header & Sprint Settings -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Timed Mock OA &amp; Interview Sprint Arena" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Simulate online assessment pressure with countdown timer and solution scratchpad" FontSize="12" Foreground="{StaticResource GoldMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="11" Margin="0,0,8,0"
                                        Command="{Binding PickRandomMockProblemCommand}" Content="Pick Random Problem"/>
                                <Button Style="{StaticResource GoldButton}" Padding="16,6" FontSize="11"
                                        Command="{Binding StartMockSessionCommand}"
                                        Visibility="{Binding IsMockRunning, Converter={StaticResource BoolToVisibilityInverse}}" Content="Start Sprint"/>
                                <Button Style="{StaticResource SecondaryButton}" Padding="16,6" FontSize="11"
                                        Command="{Binding PauseMockSessionCommand}"
                                        Visibility="{Binding IsMockRunning, Converter={StaticResource BoolToVisibility}}" Content="Pause Sprint"/>
                            </StackPanel>
                        </Grid>

                        <!-- Arena Split View -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="380"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Timer & Problem Details -->
                            <Border Grid.Column="0" Margin="0,0,12,0" CornerRadius="16" Padding="18" Background="#12FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- Glowing Countdown Timer -->
                                        <Border CornerRadius="14" Padding="20,12" Margin="0,0,0,16"
                                                Background="#18FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="2" HorizontalAlignment="Center">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="#000000" Opacity="0.25"/>
                                            </Border.Effect>
                                            <TextBlock Text="{Binding MockDisplayTime}" FontSize="40" FontWeight="Light" Foreground="{StaticResource GoldGradient}"/>
                                        </Border>

                                        <!-- Target Duration Selector -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16"
                                                    Visibility="{Binding IsMockRunning, Converter={StaticResource BoolToVisibilityInverse}}">
                                            <Button Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="10" Margin="0,0,6,0"
                                                    Content="30m Sprint" Command="{Binding ResetMockSessionCommand}"/>
                                            <Button Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="10" Margin="0,0,6,0"
                                                    Content="45m Interview" Command="{Binding ResetMockSessionCommand}"/>
                                            <Button Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="10"
                                                    Content="60m Full OA" Command="{Binding ResetMockSessionCommand}"/>
                                        </StackPanel>

                                        <!-- Selected Problem Info -->
                                        <Border Padding="14" CornerRadius="12" Background="#15FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" Margin="0,0,0,16">
                                            <StackPanel>
                                                <TextBlock Text="CURRENT CHALLENGE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GoldMutedBrush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding CurrentMockProblem.Title, FallbackValue='Click Pick Random Problem above'}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Border Padding="6,2" CornerRadius="4" Background="{Binding CurrentMockProblem.DifficultyColor, Converter={StaticResource HexToBrush}, FallbackValue='#E2E8F0'}">
                                                        <TextBlock Text="{Binding CurrentMockProblem.DifficultyDisplay, FallbackValue='Medium'}" FontSize="10" FontWeight="Bold" Foreground="#0A0A0F"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding CurrentMockProblem.TopicDisplay, FallbackValue='Topic'}" FontSize="11" Foreground="{StaticResource GoldGradient}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Self-Checklist -->
                                        <TextBlock Text="Interview Self-Evaluation:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                        <TextBlock Text="• Clarify constraints &amp; assumptions" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="• Dry-run code on sample inputs" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="• Check edge cases: null, empty, 1 element" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="• State Time &amp; Space complexity" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                                        <Button Style="{StaticResource GoldButton}" Padding="16,10" HorizontalAlignment="Stretch"
                                                Command="{Binding SubmitMockSessionCommand}" Content="Submit Solution"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- Right: Code Scratchpad & Notes -->
                            <Border Grid.Column="1" CornerRadius="16" Padding="18" Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Language & Complexities Bar -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Editor Language: " FontSize="11" Foreground="{StaticResource GoldMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox Width="100" Padding="6,4" FontSize="11" SelectedValue="{Binding MockLanguage}" SelectedValuePath="Content">
                                                <ComboBoxItem Content="C++" IsSelected="True"/>
                                                <ComboBoxItem Content="Java"/>
                                                <ComboBoxItem Content="Python"/>
                                                <ComboBoxItem Content="C#"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="Time: " FontSize="11" Foreground="{StaticResource GoldMutedBrush}" VerticalAlignment="Center"/>
                                            <TextBox Style="{StaticResource PremiumTextBox}" Width="70" Padding="6,3" FontSize="11" Text="{Binding MockTimeComplexity, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,10,0"/>
                                            <TextBlock Text="Space: " FontSize="11" Foreground="{StaticResource GoldMutedBrush}" VerticalAlignment="Center"/>
                                            <TextBox Style="{StaticResource PremiumTextBox}" Width="70" Padding="6,3" FontSize="11" Text="{Binding MockSpaceComplexity, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Monospace Code Editor Area -->
                                    <TextBox Grid.Row="1" Style="{StaticResource PremiumTextBox}"
                                             FontFamily="Consolas, Cascadia Code, Courier New" FontSize="13"
                                             Text="{Binding MockCodeScratchpad, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                                    <!-- Notes Scratchpad -->
                                    <TextBox Grid.Row="2" Style="{StaticResource PremiumTextBox}" Height="70" FontSize="11"
                                             Text="{Binding MockNotesScratchpad, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" ToolTip="Quick approach notes &amp; edge cases"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid> <!-- End Mock Arena -->

                    <!-- ========================================== -->
                    <!-- PAGE 6: STAR BEHAVIORAL & HR (Behavioral)-->
                    <!-- ========================================== -->
                    <Grid Visibility="{Binding IsBehavioralPage, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="STAR Method Behavioral &amp; Project Interview Vault" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Situation, Task, Action, Result structured narratives to clear HR &amp; managerial interview rounds" FontSize="12" Foreground="{StaticResource GoldMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding BehavioralQuestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,12" CornerRadius="14" Padding="18" Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldGradient}"/>
                                                        <TextBlock Text="{Binding QuestionTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11"
                                                            Command="{Binding DataContext.ToggleBehavioralExpandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Content="View STAR Story"/>
                                                </Grid>

                                                <!-- STAR Breakdown Drawer -->
                                                <Border Margin="0,12,0,0" Padding="16" CornerRadius="10" Background="#10FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1"
                                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                    <StackPanel>
                                                        <!-- Situation -->
                                                        <TextBlock Text="SITUATION (Context &amp; Setting):" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Situation}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,3,0,10"/>

                                                        <!-- Task -->
                                                        <TextBlock Text="TASK (The Obstacle or Goal):" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GoldGradient}"/>
                                                        <TextBlock Text="{Binding Task}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,3,0,10"/>

                                                        <!-- Action -->
                                                        <TextBlock Text="ACTION (What You Specifically Did):" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Action}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,3,0,10"/>

                                                        <!-- Result -->
                                                        <TextBlock Text="RESULT (Quantified Impact):" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GoldGradient}"/>
                                                        <TextBlock Text="{Binding Result}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,3,0,10"/>

                                                        <!-- Takeaway -->
                                                        <Border Padding="10" CornerRadius="8" Background="#15FFFFFF">
                                                            <TextBlock FontSize="11" Foreground="{StaticResource GoldGradient}">
                                                                <Run Text="Takeaway: " FontWeight="Bold"/>
                                                                <Run Text="{Binding KeyTakeaway, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid> <!-- End Behavioral -->

                    <!-- ========================================== -->
                    <!-- PAGE 7: READINESS & HEATMAP (Analytics) -->
                    <!-- ========================================== -->
                    <Grid Visibility="{Binding IsAnalyticsPage, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Placement Readiness Trajectory &amp; Consistency Heatmap" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="16-week daily activity matrix and preparation score analytics" FontSize="12" Foreground="{StaticResource GoldMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Top 4 Metric Cards -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Overall Readiness (Frosted Gold Glass) -->
                                    <Border Grid.Column="0" Margin="0,0,10,0" Padding="18" CornerRadius="16"
                                            Background="{StaticResource GlassSurfaceBrush}"
                                            BorderBrush="{StaticResource GoldGlassBorderBrush}"
                                            BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#000000" Opacity="0.25"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="SDE Readiness" FontSize="11" Foreground="{StaticResource GoldMutedBrush}"/>
                                            <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource GoldGradient}" Margin="0,4,0,2">
                                                <Run Text="{Binding PlacementReadinessScore, Mode=OneWay}"/>
                                                <Run Text="%"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding ReadinessRank}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- DSA Mastery (Frosted Emerald Glass) -->
                                    <Border Grid.Column="1" Margin="0,0,10,0" Padding="18" CornerRadius="16"
                                            Background="{StaticResource GlassSurfaceBrush}"
                                            BorderBrush="{StaticResource GlassBorderSubtle}"
                                            BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#4ADE80" Opacity="0.15"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="DSA Solved" FontSize="11" Foreground="{StaticResource GoldMutedBrush}"/>
                                            <TextBlock FontSize="26" FontWeight="Bold" Foreground="#4ADE80" Margin="0,4,0,2">
                                                <Run Text="{Binding TotalDsaSolved, Mode=OneWay}"/>
                                                <Run Text=" / "/>
                                                <Run Text="{Binding TotalDsaCount, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="Pattern Bank" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Core CS (Frosted Glass) -->
                                    <Border Grid.Column="2" Margin="0,0,10,0" Padding="18" CornerRadius="16"
                                            Background="{StaticResource GlassSurfaceBrush}"
                                            BorderBrush="{StaticResource CyanGlassBorderBrush}"
                                            BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#000000" Opacity="0.25"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="Core CS Mastered" FontSize="11" Foreground="{StaticResource GoldMutedBrush}"/>
                                            <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,2">
                                                <Run Text="{Binding TotalCoreCsMastered, Mode=OneWay}"/>
                                                <Run Text=" / "/>
                                                <Run Text="{Binding TotalCoreCsCount, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="OS, DBMS, CN Cards" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Mock Sessions (Frosted Glass) -->
                                    <Border Grid.Column="3" Padding="18" CornerRadius="16"
                                            Background="{StaticResource GlassSurfaceBrush}"
                                            BorderBrush="{StaticResource GlassBorderSubtle}"
                                            BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#000000" Opacity="0.25"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="Mock OAs Completed" FontSize="11" Foreground="{StaticResource GoldMutedBrush}"/>
                                            <TextBlock Text="{Binding MockHistory.Count}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,2"/>
                                            <TextBlock Text="Timed Pressure Tests" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Activity Heatmap Card (Frosted Glass Acrylic) -->
                                <Border Margin="0,0,0,20" Padding="22,18" CornerRadius="18"
                                        Background="{StaticResource GoldGlassCardBrush}"
                                        BorderBrush="{StaticResource UltraGlassBorderBrush}"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#000000" Opacity="0.25"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7E6;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FF9800" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Consistency Heatmap (16 Weeks)" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding StreakStatusText}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource GoldGradient}"/>
                                        </Grid>

                                        <!-- Custom ActivityHeatmap Control -->
                                        <controls:ActivityHeatmap ActivityData="{Binding HeatmapActivityData}" HorizontalAlignment="Center" Margin="0,4,0,14"/>

                                        <!-- Legend -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="Less " FontSize="10" Foreground="{StaticResource GoldMutedBrush}" VerticalAlignment="Center"/>
                                            <Border Width="10" Height="10" CornerRadius="2" Background="#15FFFFFF" Margin="2,0"/>
                                            <Border Width="10" Height="10" CornerRadius="2" Background="#55FFFFFF" Margin="2,0"/>
                                            <Border Width="10" Height="10" CornerRadius="2" Background="#A5FFFFFF" Margin="2,0"/>
                                            <Border Width="10" Height="10" CornerRadius="2" Background="#FFFFFFFF" Margin="2,0"/>
                                            <TextBlock Text=" More" FontSize="10" Foreground="{StaticResource GoldMutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid> <!-- End Analytics -->

                    <!-- ========================================== -->
                    <!-- PAGE 8: SDE BADGES (Achievements)       -->
                    <!-- ========================================== -->
                    <ScrollViewer Visibility="{Binding IsAchievementsPage, Converter={StaticResource BoolToVisibility}}" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="10,0,10,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,24" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="36" HorizontalAlignment="Center" Foreground="{StaticResource GoldGradient}" Margin="0,0,0,10"/>
                                <TextBlock Text="SDE Placement Badges" FontSize="28" FontWeight="Bold" Foreground="{StaticResource GoldGradient}" HorizontalAlignment="Center"/>
                                <TextBlock HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource GoldMutedBrush}" Margin="0,4,0,0">
                                    <Run Text="{Binding UnlockedBadgesCount, Mode=OneWay}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding TotalBadges, Mode=OneWay}"/>
                                    <Run Text=" badges unlocked"/>
                                </TextBlock>
                            </StackPanel>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding AllBadges}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="8" Padding="18" CornerRadius="16" Height="160" Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                                            <Setter Property="Background" Value="#18FFFFFF"/>
                                                            <Setter Property="BorderBrush" Value="#35FFFFFF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsUnlocked}" Value="False">
                                                            <Setter Property="Opacity" Value="0.4"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel VerticalAlignment="Center">
                                                <Border Width="44" Height="44" CornerRadius="10" Background="#20FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                    <TextBlock Text="{Binding Emoji}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource GoldGradient}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource GoldMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <!-- ========================================== -->
                    <!-- PAGE 9: REFLECTIONS LOG (History)       -->
                    <!-- ========================================== -->
                    <ScrollViewer Visibility="{Binding IsHistoryPage, Converter={StaticResource BoolToVisibility}}" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="10,0,10,20">
                            <StackPanel>
                                <TextBlock Text="Reflections &amp; Completed Targets" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                <ItemsControl ItemsSource="{Binding CompletedTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" CornerRadius="10" Padding="14,10" Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                                                <Grid>
                                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#4ADE80" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Title}" Margin="26,0,0,0" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding CompletedAtFormatted}" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource GoldMutedBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- ========================================== -->
                    <!-- PAGE 10: SETTINGS (Settings)             -->
                    <!-- ========================================== -->
                    <ScrollViewer Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVisibility}}" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="620" HorizontalAlignment="Center" Margin="0,20,0,20">
                            <TextBlock Text="Settings &amp; Workspace Preferences" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                            
                            <!-- LeetCode Safe Sync Settings Card (Frosted Glass) -->
                            <Border Padding="20" CornerRadius="16"
                                    Background="{StaticResource GlassSurfaceBrush}"
                                    BorderBrush="{StaticResource CyanGlassBorderBrush}"
                                    BorderThickness="1" Margin="0,0,0,16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#000000" Opacity="0.25"/>
                                </Border.Effect>
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="6" Background="#25FFA116" BorderBrush="#FFA116" BorderThickness="1" Margin="0,0,10,0">
                                                <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFA116"/>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="LeetCode Safe Auto-Sync" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="Read-only public API synchronization (zero passwords needed)" FontSize="11" Foreground="{StaticResource GoldMutedBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,3" CornerRadius="10" Background="#184ADE80" BorderBrush="#404ADE80" BorderThickness="1">
                                            <TextBlock Text="SECURE (Read-Only GraphQL)" FontSize="10" FontWeight="SemiBold" Foreground="#4ADE80"/>
                                        </Border>
                                    </Grid>

                                    <!-- Handle Input Field -->
                                    <TextBlock Text="LeetCode Handle / Username:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource PremiumTextBox}" FontSize="12" Padding="12,7"
                                                 Text="{Binding LeetCodeUsername, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Enter your LeetCode username">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding SyncLeetCodeCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <Button Grid.Column="1" Style="{StaticResource GoldButton}" Margin="10,0,0,0" Padding="18,7" FontSize="12"
                                                Command="{Binding SyncLeetCodeCommand}"
                                                IsEnabled="{Binding IsLeetCodeSyncing, Converter={StaticResource InverseBool}}"
                                                Content="{Binding LeetCodeSyncButtonText}"/>
                                    </Grid>

                                    <!-- Status message -->
                                    <Border Padding="10,8" CornerRadius="8" Background="#12FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="{Binding LeetCodeStatusMessage}" FontSize="11" Foreground="{StaticResource GoldGradient}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="10"
                                                    Command="{Binding ClearLeetCodeCommand}" Content="Disconnect"
                                                    Visibility="{Binding IsLeetCodeConnected, Converter={StaticResource BoolToVisibility}}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Padding="18" CornerRadius="14" Background="{StaticResource GlassSurfaceBrush}" BorderBrush="{StaticResource GlassBorderSubtle}" BorderThickness="1" Margin="0,0,0,14">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Full Screen Mode" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Maximize screen area for timed code sprints" FontSize="11" Foreground="{StaticResource GoldMutedBrush}"/>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="16,6" Command="{Binding ToggleFullScreenCommand}" Content="Toggle Fullscreen"/>
                                </Grid>
                            </Border>

                            <Border Padding="18" CornerRadius="14" Background="{StaticResource GlassSurfaceBrush}" BorderBrush="{StaticResource GlassBorderSubtle}" BorderThickness="1" Margin="0,0,0,14">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Dark / Luxury Gold Theme" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Switch visual theme accents" FontSize="11" Foreground="{StaticResource GoldMutedBrush}"/>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="16,6" Command="{Binding ToggleThemeCommand}" Content="Toggle Theme"/>
                                </Grid>
                            </Border>

                            <Border Padding="18" CornerRadius="14" Background="{StaticResource GlassSurfaceBrush}" BorderBrush="{StaticResource GlassBorderSubtle}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="About Momentum" FontSize="14" FontWeight="Bold" Foreground="{StaticResource GoldGradient}"/>
                                    <TextBlock Text="Version 4.0 (Placement Edition)" FontSize="11" Foreground="{StaticResource GoldMutedBrush}" Margin="0,2,0,8"/>
                                    <TextBlock Text="Designed specifically for final-year engineering students preparing for technical on-campus and off-campus placements. Built with WPF .NET 8." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                </Grid> <!-- End Center Grid -->

                <!-- ============================================== -->
                <!-- RIGHT PANEL - Daily Focus, Quick Add & Goals   -->
                <!-- ============================================== -->
                <Border Grid.Column="2" 
                        Width="360"
                        CornerRadius="0,16,16,0"
                        BorderThickness="1,0,0,0"
                        BorderBrush="{StaticResource DarkBorderBrush}"
                        Background="{StaticResource SurfaceBrush}"
                        Visibility="{Binding ShowRightPanel, Converter={StaticResource BoolToVisibility}}">

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20,18,20,18">
                        <StackPanel>
                            <!-- Daily Highlight Card (Obsidian Cyber) -->
                            <Border CornerRadius="14" Padding="16" Margin="0,0,0,16"
                                    Background="{StaticResource GoldGlassCardBrush}"
                                    BorderBrush="{StaticResource GoldGlassBorderBrush}"
                                    BorderThickness="1"
                                    Visibility="{Binding HasDailyHighlight, Converter={StaticResource BoolToVisibility}}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#000000" Opacity="0.3"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="DAILY HIGHLIGHT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GoldGradient}" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding DailyHighlightTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource GoldButton}" Margin="0,10,0,0" Padding="14,6" FontSize="11"
                                            Command="{Binding EnterFocusModeCommand}" CommandParameter="{Binding DailyHighlight}"
                                            Content="Focus on this"/>
                                </StackPanel>
                            </Border>

                            <!-- Quick Add Task (Frosted Glass) -->
                            <TextBlock Text="Quick Add Target" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                            <Border CornerRadius="16" Padding="16" Margin="0,0,0,18"
                                    Background="{StaticResource GlassSurfaceBrush}"
                                    BorderBrush="{StaticResource GlassBorderSubtle}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBox Style="{StaticResource PremiumTextBox}" FontSize="12" Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding AddTaskCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>

                                    <!-- Energy Selector -->
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Mode:" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource GoldMutedBrush}"/>
                                        <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="10,4"
                                                Command="{Binding CycleNewTaskEnergyCommand}">
                                            <TextBlock Text="{Binding NewTaskEnergy}" FontSize="11" FontWeight="SemiBold"/>
                                        </Button>
                                    </Grid>

                                    <Button Style="{StaticResource GoldButton}" Padding="14,8" FontSize="12"
                                            Command="{Binding AddTaskCommand}" Content="+ Add Daily Target"/>
                                </StackPanel>
                            </Border>

                            <!-- Placement Goals & Milestones -->
                            <TextBlock Text="Placement Milestones" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                            
                            <Border CornerRadius="16" Padding="14,12" Margin="0,0,0,12"
                                    Background="{StaticResource GlassSurfaceBrush}"
                                    BorderBrush="{StaticResource GlassBorderSubtle}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource PremiumTextBox}" FontSize="11" Padding="8,6"
                                             Text="{Binding NewGoalTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding AddGoalCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="1" Style="{StaticResource GoldButton}" Padding="12,6" FontSize="12"
                                            Command="{Binding AddGoalCommand}" Content="+"/>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Goals}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" CornerRadius="12" Padding="12" Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontSize="11" Foreground="{StaticResource GoldMutedBrush}">
                                                            <TextBlock.Text>
                                                                <Binding Path="ProgressPercentage" StringFormat="{}{0:0}% complete"/>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Style="{StaticResource GoldButton}" Padding="8,4" FontSize="9" Margin="0,0,4,0"
                                                                Command="{Binding DataContext.IncrementGoalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" Content="+10%"/>
                                                        <Button Style="{StaticResource GoldIconButton}" Width="22" Height="22"
                                                                Command="{Binding DataContext.DeleteGoalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="8"/>
                                                    </StackPanel>
                                                </Grid>
                                                <!-- Progress Bar -->
                                                <Grid Height="4" Margin="0,8,0,0">
                                                    <Border Background="#20FFFFFF" CornerRadius="2"/>
                                                    <Border CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource GoldGradient}">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                                                <Binding Path="ProgressPercentage" Mode="OneWay"/>
                                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" Mode="OneWay"/>
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ============================================== -->
            <!-- CONFETTI OVERLAY                               -->
            <!-- ============================================== -->
            <Canvas x:Name="ConfettiCanvas" IsHitTestVisible="False"
                    Visibility="{Binding ShowConfetti, Converter={StaticResource BoolToVisibility}}"/>

            <!-- ============================================== -->
            <!-- FOCUS MODE / POMODORO OVERLAY                  -->
            <!-- ============================================== -->
            <Border x:Name="FocusModeOverlay"
                    Visibility="{Binding IsFocusMode, Converter={StaticResource BoolToVisibility}}"
                    CornerRadius="20" Background="#E0101014">
                <Grid>
                    <Button Style="{StaticResource GoldIconButton}"
                            Command="{Binding ExitFocusModeCommand}"
                            Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="44" Height="44"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,24,0"/>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="800">
                        <TextBlock Text="P O M O D O R O   D E E P   W O R K" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12" Foreground="{StaticResource GoldGradient}"/>
                        <TextBlock Text="{Binding FocusTask.Title}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,24" TextWrapping="Wrap"/>

                        <Border CornerRadius="20" Padding="40,20" Background="#18FFFFFF" BorderBrush="#35FFFFFF" BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,24">
                            <TextBlock Text="{Binding PomodoroDisplay}" FontSize="64" FontWeight="Light" Foreground="{StaticResource GoldGradient}"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                            <Button Style="{StaticResource GoldButton}" Command="{Binding StartPomodoroCommand}" Content="Start" Padding="28,12" FontSize="14"
                                    Visibility="{Binding IsPomodoroRunning, Converter={StaticResource BoolToVisibilityInverse}}" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding PausePomodoroCommand}" Content="Pause" Padding="28,12" FontSize="14"
                                    Visibility="{Binding IsPomodoroRunning, Converter={StaticResource BoolToVisibility}}" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding ResetPomodoroCommand}" Content="Reset" Padding="28,12" FontSize="14" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource GoldButton}" Command="{Binding CompleteFocusTaskCommand}" Content="Mark Completed" Padding="28,12" FontSize="14"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- MORNING CHECK-IN OVERLAY                       -->
            <!-- ============================================== -->
            <Border Visibility="{Binding ShowMorningCheckIn, Converter={StaticResource BoolToVisibility}}"
                    CornerRadius="20" Background="#E0101014">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="18" MaxWidth="440" Padding="32"
                        Background="#E6101014" BorderBrush="#35FFFFFF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="36" HorizontalAlignment="Center" Foreground="{StaticResource GoldGradient}" Margin="0,0,0,10"/>
                        <TextBlock Text="Good Morning" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource GoldGradient}"/>
                        <TextBlock Text="What's your primary DSA or placement target today?" FontSize="13" HorizontalAlignment="Center" Foreground="{StaticResource GoldMutedBrush}" Margin="0,4,0,18"/>
                        <TextBox Style="{StaticResource PremiumTextBox}" Text="{Binding MorningReflection, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource GoldButton}" Command="{Binding SaveMorningCheckInCommand}" Content="Set Target" Padding="20,10" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding DismissCheckInCommand}" Content="Skip" Padding="20,10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ============================================== -->
            <!-- EVENING CHECK-IN OVERLAY                       -->
            <!-- ============================================== -->
            <Border Visibility="{Binding ShowEveningCheckIn, Converter={StaticResource BoolToVisibility}}"
                    CornerRadius="20" Background="#E0101014">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="18" MaxWidth="440" Padding="32"
                        Background="#E6101014" BorderBrush="#35FFFFFF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="36" HorizontalAlignment="Center" Foreground="{StaticResource GoldGradient}" Margin="0,0,0,10"/>
                        <TextBlock Text="Evening Reflection" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource GoldGradient}"/>
                        <TextBlock Text="What did you solve or revise today? How did you move forward?" FontSize="13" HorizontalAlignment="Center" Foreground="{StaticResource GoldMutedBrush}" Margin="0,4,0,18"/>
                        <TextBox Style="{StaticResource PremiumTextBox}" Text="{Binding EveningReflection, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource GoldButton}" Command="{Binding SaveEveningCheckInCommand}" Content="Save Reflection" Padding="20,10" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding DismissCheckInCommand}" Content="Skip" Padding="20,10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
