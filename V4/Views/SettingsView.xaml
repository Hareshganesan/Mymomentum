<UserControl x:Class="Momentum.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Section header: tinted icon tile + title + one-line description -->
        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TileGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Row" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Hover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="1240">
            <TextBlock Text="Settings" Style="{StaticResource H1}"/>
            <TextBlock Text="Your profile, plan, LeetCode link and data — all stored on this PC." Style="{StaticResource Muted}" FontSize="14" Margin="0,6,0,24"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ================= Left column ================= -->
                <StackPanel>
                    <!-- Profile -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Medium"
                                           Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="17" FontWeight="SemiBold" Tag="Your name"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="2,8,0,0">
                                    <Run Text="@"/><Run Text="{Binding Username, Mode=OneWay}"/><Run Text=" · local account on this PC"/>
                                </TextBlock>
                                <Button Content="{Binding RecoveryText}" Style="{StaticResource LinkButton}" Command="{Binding RecoveryCodeCommand}" HorizontalAlignment="Left"
                                        Margin="2,8,0,0" FontSize="12" FontWeight="Normal" ToolTip="Lets you reset your password if you forget it"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Plan -->
                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE787;" Style="{StaticResource TileGlyph}"/></Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Your plan" Style="{StaticResource H2}"/>
                                    <TextBlock Text="Shapes how much Today asks of you." Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Placements start" Style="{StaticResource Overline}" Margin="0,22,0,6"/>
                            <DatePicker SelectedDate="{Binding TargetDate}" Height="40"/>

                            <TextBlock Text="Time per day" Style="{StaticResource Overline}" Margin="0,18,0,8"/>
                            <UniformGrid Columns="4">
                                <RadioButton Style="{StaticResource ChipRadio}" Content="45 min" GroupName="m" Margin="0,0,6,0" IsChecked="{Binding DailyMinutes, Converter={StaticResource Equals}, ConverterParameter=45}"/>
                                <RadioButton Style="{StaticResource ChipRadio}" Content="1.5 h" GroupName="m" Margin="0,0,6,0" IsChecked="{Binding DailyMinutes, Converter={StaticResource Equals}, ConverterParameter=90}"/>
                                <RadioButton Style="{StaticResource ChipRadio}" Content="2.5 h" GroupName="m" Margin="0,0,6,0" IsChecked="{Binding DailyMinutes, Converter={StaticResource Equals}, ConverterParameter=150}"/>
                                <RadioButton Style="{StaticResource ChipRadio}" Content="4+ h" GroupName="m" Margin="0" IsChecked="{Binding DailyMinutes, Converter={StaticResource Equals}, ConverterParameter=240}"/>
                            </UniformGrid>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Language" Style="{StaticResource Overline}" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" Height="40"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Target companies" Style="{StaticResource Overline}" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding TargetCompanies, UpdateSourceTrigger=PropertyChanged}" Tag="Amazon, Microsoft…"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Changes apply from tomorrow, or press Rebuild on Today." Style="{StaticResource Caption}" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================= Right column ================= -->
                <StackPanel Grid.Column="2">
                    <!-- LeetCode -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE943;" Style="{StaticResource TileGlyph}"/></Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="LeetCode" Style="{StaticResource H2}"/>
                                    <TextBlock Text="Public profile, no password. Syncs every time you open Momentum." Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </StackPanel>
                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding LeetCodeUsername, UpdateSourceTrigger=LostFocus}" Tag="your-handle"/>
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Command="{Binding SyncCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sync" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding SyncStatus}" Style="{StaticResource Caption}" Margin="2,10,0,0" TextWrapping="Wrap" TextTrimming="None"/>

                            <TextBlock Text="Full history" Style="{StaticResource Overline}" Margin="0,18,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ConnectLeetCodeCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Sign in with LeetCode"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLeetCodeConnected}" Value="True"><Setter Property="Text" Value="Reconnect"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                                <Button Content="Disconnect" Style="{StaticResource LinkButton}" Command="{Binding DisconnectLeetCodeCommand}" Margin="14,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsLeetCodeConnected, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ConnectStatus}" Style="{StaticResource Caption}" Margin="2,8,0,0" TextWrapping="Wrap" TextTrimming="None"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="2,4,0,0" TextWrapping="Wrap" TextTrimming="None"
                                       Text="Use your LeetCode username/email or GitHub. Google sign-in is blocked by Google inside apps."/>

                            <TextBlock Text="Most private: import from a file" Style="{StaticResource Overline}" Margin="0,18,0,6"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="2,0,0,8"
                                       Text="No login inside Momentum and nothing saved. While signed in to LeetCode in your own browser, open the problem list page, press Ctrl+A then Ctrl+C, and click Paste. (Or save the page with Ctrl+S as HTML Only and import the file.)"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="1. Open the page in my browser" Style="{StaticResource SecondaryButton}" Command="{Binding OpenSolvedPageCommand}"/>
                                <Button Content="2. Paste copied list" Style="{StaticResource SecondaryButton}" Command="{Binding PasteSolvedCommand}" Margin="8,0,0,0"/>
                                <Button Content="or import saved file" Style="{StaticResource LinkButton}" Command="{Binding ImportSolvedFileCommand}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <ToggleButton x:Name="AdvancedToggle" Style="{StaticResource Chip}" Content="Paste the cookie manually instead" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                            <StackPanel Visibility="{Binding IsChecked, ElementName=AdvancedToggle, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                                <TextBlock Text="LEETCODE_SESSION cookie" Style="{StaticResource Overline}" Margin="0,0,0,6"/>
                                <PasswordBox x:Name="SessionBox" PasswordChanged="SessionBox_PasswordChanged"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"
                                           Text="The public API only shows your last 20 solves. Paste this cookie (from your browser, for leetcode.com) to import older ones. It stays on this PC and is only sent to leetcode.com."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Appearance -->
                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE790;" Style="{StaticResource TileGlyph}"/></Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Appearance" Style="{StaticResource H2}"/>
                                    <TextBlock Text="Quiet Graphite, in dark or light." Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </StackPanel>
                            <UniformGrid Columns="2" Margin="0,18,0,0">
                                <Button Style="{StaticResource Row}" Margin="0,0,8,0" Command="{Binding DarkCommand}" Padding="8">
                                    <StackPanel>
                                        <Border Height="70" CornerRadius="10" BorderThickness="2"
                                                BorderBrush="{Binding IsDark, Converter={StaticResource BoolToBrush}, ConverterParameter=Accent|Border}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#0B0C0E" Offset="0"/>
                                                    <GradientStop Color="#141619" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border Width="60" Height="26" CornerRadius="6" Background="#191C20" BorderBrush="#292C31" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"/>
                                        </Border>
                                        <TextBlock Text="Dark" FontWeight="SemiBold" Margin="2,8,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Row}" Margin="8,0,0,0" Command="{Binding LightCommand}" Padding="8">
                                    <StackPanel>
                                        <Border Height="70" CornerRadius="10" BorderThickness="2"
                                                BorderBrush="{Binding IsDark, Converter={StaticResource BoolToBrush}, ConverterParameter=Border|Accent}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#F6F6F5" Offset="0"/>
                                                    <GradientStop Color="#FFFFFF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border Width="60" Height="26" CornerRadius="6" Background="#FFFFFF" BorderBrush="#E1E1DE" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"/>
                                        </Border>
                                        <TextBlock Text="Light" FontWeight="SemiBold" Margin="2,8,0,0"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Data -->
                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Style="{StaticResource IconTile}"><TextBlock Text="&#xE8B7;" Style="{StaticResource TileGlyph}"/></Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Your data" Style="{StaticResource H2}"/>
                                    <TextBlock Text="Saved automatically. Back it up before switching PCs." Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Style="{StaticResource Row}" Command="{Binding ExportCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Foreground="{DynamicResource Text}"/>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Export backup"/><TextBlock Text="Save everything to a .json file" Style="{StaticResource Caption}"/></StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource Row}" Command="{Binding ImportCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}" Foreground="{DynamicResource Text}"/>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Import backup"/><TextBlock Text="Replace this account's progress with a backup" Style="{StaticResource Caption}"/></StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource Row}" Command="{Binding OpenFolderCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" Foreground="{DynamicResource Text}"/>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Open data folder"/><TextBlock Text="{Binding DataPath}" Style="{StaticResource Caption}"/></StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource Row}" Command="{Binding ResetCommand}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" Foreground="{DynamicResource Danger}"/>
                                    <StackPanel Grid.Column="1"><TextBlock Text="Reset progress" Foreground="{DynamicResource Danger}"/><TextBlock Text="Keeps your profile and LeetCode link" Style="{StaticResource Caption}"/></StackPanel>
                                </Grid>
                            </Button>
                            <TextBlock Text="Shortcuts: Ctrl+1…9 switch pages · Review: Space reveal, 1–4 grade, S skip" Style="{StaticResource Caption}" Margin="10,14,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
