<UserControl x:Class="Momentum.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Width="440" Margin="0,60" Padding="36,32" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ContentControl Content="{StaticResource LogoMark}" Width="34" Height="34" Focusable="False"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Momentum" FontWeight="Medium" FontSize="17" Foreground="{DynamicResource Text}"/>
                        <TextBlock Text="Placement prep coach" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" Margin="0,26,0,6"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}"/>

                <!-- Accounts on this PC -->
                <ItemsControl ItemsSource="{Binding Accounts}" Margin="0,16,0,0"
                              Visibility="{Binding NeedsConfirm, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,6,6" FontWeight="Normal" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="{Binding}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Visibility="{Binding IsResetting, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Recovery code" Style="{StaticResource Overline}" Margin="0,14,0,6"/>
                    <PasswordBox x:Name="RecoveryBox" PasswordChanged="Recovery_Changed" KeyDown="Field_KeyDown"/>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,6,0,0"
                               Text="Leave empty to confirm with Windows Hello (your Windows PIN, fingerprint or face)."/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsCreating, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Your name" Style="{StaticResource Overline}" Margin="0,18,0,6"/>
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Tag="Shown on your dashboard"/>
                </StackPanel>

                <TextBlock Text="Username" Style="{StaticResource Overline}" Margin="0,16,0,6"/>
                <TextBox x:Name="UserBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. haresh"/>

                <TextBlock Text="{Binding PasswordLabel}" Style="{StaticResource Overline}" Margin="0,14,0,6"/>
                <PasswordBox x:Name="PasswordBox" PasswordChanged="Password_Changed" KeyDown="Field_KeyDown"/>
                <Button Content="Forgot password?" Style="{StaticResource LinkButton}" Command="{Binding ForgotCommand}" HorizontalAlignment="Right"
                        Margin="0,6,0,0" FontSize="12" FontWeight="Normal" Visibility="{Binding CanForget, Converter={StaticResource BoolToVis}}"/>

                <StackPanel Visibility="{Binding NeedsConfirm, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Confirm password" Style="{StaticResource Overline}" Margin="0,14,0,6"/>
                    <PasswordBox x:Name="ConfirmBox" PasswordChanged="Confirm_Changed" KeyDown="Field_KeyDown"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsCreating, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="LeetCode username (optional)" Style="{StaticResource Overline}" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding LeetCode, UpdateSourceTrigger=PropertyChanged}" Tag="Auto-syncs your solved problems — no password"/>
                </StackPanel>

                <CheckBox Content="Keep me signed in" IsChecked="{Binding Remember}" Margin="0,16,0,0" FontSize="13"/>

                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap"
                           Visibility="{Binding Error, Converter={StaticResource StringToVis}}"/>

                <Button Content="{Binding SubmitText}" Style="{StaticResource PrimaryButton}" Command="{Binding SubmitCommand}"
                        HorizontalAlignment="Stretch" Margin="0,18,0,0" Padding="18,11" FontSize="14"/>
                <Button Content="{Binding ToggleText}" Style="{StaticResource LinkButton}" Command="{Binding ToggleModeCommand}"
                        HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="12.5" FontWeight="Normal"/>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,0"
                           Text="Accounts are local to this PC. Passwords are stored only as secure hashes."/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
