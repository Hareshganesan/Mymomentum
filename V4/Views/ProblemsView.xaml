<UserControl x:Class="Momentum.Views.ProblemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Momentum.Views">
    <Grid Margin="32,24,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Grid Grid.ColumnSpan="4" Margin="0,0,12,18">
            <StackPanel>
                <TextBlock Text="Problems" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="14"
                           Text="A pattern-first roadmap of ~160 interview problems. Learn to recognise the pattern, not memorise the answer."/>
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}" Command="{Binding StartAddCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="Add problem" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Pattern roadmap -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <ListBox ItemsSource="{Binding Patterns}" SelectedItem="{Binding SelectedPattern, Mode=TwoWay}" Style="{StaticResource PlainList}"
                     ItemContainerStyle="{StaticResource RowItem}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Index}" Style="{StaticResource Caption}" Width="20" VerticalAlignment="Center"
                                           Visibility="{Binding IsAll, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"
                                           FontWeight="{Binding IsAll, Converter={x:Static local:ViewHelpers.BoolToBold}}"/>
                                <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource Caption}" Margin="6,0,0,0"/>
                            </Grid>
                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="3" Margin="0,7,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Problem list -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Pattern explainer -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding PatternHeader, Converter={StaticResource NullToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="When to reach for it" Style="{StaticResource Overline}"/>
                        <TextBlock Text="{Binding PatternHeader.Cue}" Style="{StaticResource Body}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="The recipe" Style="{StaticResource Overline}"/>
                        <TextBlock Text="{Binding PatternHeader.Recipe}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Filters -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" Tag="Search title, pattern, company or your notes"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0">
                    <ComboBox Width="110" SelectedValue="{Binding DifficultyFilter}" SelectedValuePath="Content">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Easy"/>
                        <ComboBoxItem Content="Medium"/>
                        <ComboBoxItem Content="Hard"/>
                    </ComboBox>
                    <ComboBox Width="120" Margin="8,0,0,0" SelectedValue="{Binding StatusFilter}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="Any status" Tag="All"/>
                        <ComboBoxItem Content="To do" Tag="Todo"/>
                        <ComboBoxItem Content="Solved" Tag="Solved"/>
                        <ComboBoxItem Content="Due for review" Tag="Due"/>
                        <ComboBoxItem Content="Starred" Tag="Starred"/>
                    </ComboBox>
                </StackPanel>
                <ComboBox Grid.Column="2" ItemsSource="{Binding Companies}" SelectedItem="{Binding Company}" MaxDropDownHeight="360"/>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding ResultText}" Style="{StaticResource Caption}" Margin="12,6,0,8"/>
                    <ListBox ItemsSource="{Binding Filtered}" SelectedItem="{Binding SelectedProblem, Mode=TwoWay}" Style="{StaticResource PlainList}"
                             ItemContainerStyle="{StaticResource RowItem}" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="72"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Border Width="18" Height="18" CornerRadius="9" BorderThickness="1.5" BorderBrush="{DynamicResource BorderStrong}"/>
                                        <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource Success}"
                                                Visibility="{Binding IsSolved, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="{DynamicResource OnAccent}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Warning}"
                                                Visibility="{Binding IsAttempted, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="13.5" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource Warning}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding Starred, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="&#xE70B;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource TextFaint}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"
                                                       ToolTip="Has notes"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding PatternName}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="5" Padding="8,2" Margin="8,0" VerticalAlignment="Center"
                                            Background="{Binding IsDue, Converter={StaticResource BoolToBrush}, ConverterParameter=AccentSoft|Surface2}"
                                            Visibility="{Binding DueText, Converter={StaticResource StringToVis}}">
                                        <TextBlock Text="{Binding DueText}" FontSize="11.5"
                                                   Foreground="{Binding IsDue, Converter={StaticResource BoolToBrush}, ConverterParameter=Accent|TextFaint}"/>
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding DifficultyText}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Margin="0,0,6,0" Foreground="{Binding Difficulty, Converter={StaticResource DifficultyBrush}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Side panel: detail or add form -->
        <Border Grid.Row="1" Grid.Column="3" Width="400" Margin="16,0,0,0" Style="{StaticResource Card}" Padding="0"
                Visibility="{Binding ShowSidePanel, Converter={StaticResource BoolToVis}}">
            <Grid>
                <!-- Detail -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="22,18,22,22" DataContext="{Binding SelectedProblem}">
                        <Grid>
                            <TextBlock Text="{Binding PatternName}" Style="{StaticResource Overline}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource IconButton}" ToolTip="Star"
                                        Command="{Binding DataContext.ToggleStarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <TextBlock Text="{Binding Starred, Converter={x:Static local:ViewHelpers.StarGlyph}}" FontFamily="{StaticResource IconFont}"
                                               Foreground="{Binding Starred, Converter={StaticResource BoolToBrush}, ConverterParameter=Warning|TextMuted}"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Close"
                                        Command="{Binding DataContext.CloseDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="20" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <WrapPanel>
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,6">
                                <TextBlock Text="{Binding DifficultyText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Difficulty, Converter={StaticResource DifficultyBrush}}"/>
                            </Border>
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,6">
                                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding CompaniesText, StringFormat=Commonly reported at {0}}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Visibility="{Binding HasCompanies, Converter={StaticResource BoolToVis}}"/>

                        <Button Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" HorizontalAlignment="Stretch"
                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Open on LeetCode"/>
                                <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Grade / status -->
                        <Border Style="{StaticResource Inset}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H3}" Text="{Binding IsSolved, Converter={x:Static local:ViewHelpers.SolvedPrompt}}"/>
                                <TextBlock Text="{Binding ReviewSummary}" Style="{StaticResource Caption}" Margin="0,3,0,10" TextWrapping="Wrap"/>
                                <UniformGrid Columns="2">
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Command="{Binding DataContext.GradeAgainCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <TextBlock Text="Needed help" Foreground="{DynamicResource Danger}"/>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" Command="{Binding DataContext.GradeHardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <TextBlock Text="Struggled" Foreground="{DynamicResource Warning}"/>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Command="{Binding DataContext.GradeGoodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <TextBlock Text="Solved it" Foreground="{DynamicResource Success}"/>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.GradeEasyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <TextBlock Text="Easy" Foreground="{DynamicResource Accent}"/>
                                    </Button>
                                </UniformGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{StaticResource LinkButton}" Content="Mark as attempted" FontSize="12" FontWeight="Normal"
                                            Visibility="{Binding IsTodo, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.AttemptedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <Button Style="{StaticResource LinkButton}" Content="Reset progress" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextFaint}"
                                            Visibility="{Binding IsTodo, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                            Command="{Binding DataContext.ResetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Hint -->
                        <TextBlock Text="Hint" Style="{StaticResource Overline}" Margin="0,20,0,6" Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}"/>
                        <Grid Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Content="Reveal hint — try 10 minutes first"
                                    Visibility="{Binding DataContext.ShowHint, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                    Command="{Binding DataContext.ShowHintCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Border Style="{StaticResource Inset}" Visibility="{Binding DataContext.ShowHint, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Body}"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="Pattern cue" Style="{StaticResource Overline}" Margin="0,20,0,6"/>
                        <TextBlock Text="{Binding PatternCue}" Style="{StaticResource Muted}"/>

                        <TextBlock Text="Key insight (your words)" Style="{StaticResource Overline}" Margin="0,20,0,6"/>
                        <TextBox Style="{StaticResource MultilineBox}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                 Tag="The one idea that cracks it, plus complexity. This is what you'll see when reviewing."/>

                        <TextBlock Text="Mistakes to avoid" Style="{StaticResource Overline}" Margin="0,16,0,6"/>
                        <TextBox Style="{StaticResource MultilineBox}" MinHeight="56" Text="{Binding Mistakes, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                 Tag="Off-by-one? Forgot an edge case? Wrong data structure first?"/>

                        <Button Style="{StaticResource LinkButton}" Content="Delete this custom problem" Foreground="{DynamicResource Danger}" FontSize="12"
                                HorizontalAlignment="Left" Margin="0,18,0,0" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Add form -->
                <StackPanel Margin="22,18,22,22" Visibility="{Binding IsAdding, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <TextBlock Text="Add a problem" Style="{StaticResource H2}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" Command="{Binding CancelAddCommand}"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                               Text="From a contest, college test or an interview experience post. It joins the same review cycle."/>
                    <TextBlock Text="Link" Style="{StaticResource Overline}" Margin="0,18,0,6"/>
                    <TextBox Text="{Binding NewUrl, UpdateSourceTrigger=PropertyChanged}" Tag="https://leetcode.com/problems/…"/>
                    <TextBlock Text="Title" Style="{StaticResource Overline}" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" Tag="Filled in from the link"/>
                    <TextBlock Text="Difficulty" Style="{StaticResource Overline}" Margin="0,14,0,6"/>
                    <ComboBox ItemsSource="{Binding Difficulties}" SelectedItem="{Binding NewDifficulty}"/>
                    <TextBlock Text="Pattern" Style="{StaticResource Overline}" Margin="0,14,0,6"/>
                    <ComboBox ItemsSource="{Binding PatternDefs}" SelectedValuePath="Key" DisplayMemberPath="Name" SelectedValue="{Binding NewPattern}" MaxDropDownHeight="360"/>
                    <TextBlock Text="Companies (optional)" Style="{StaticResource Overline}" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding NewCompanies, UpdateSourceTrigger=PropertyChanged}" Tag="Amazon, Flipkart"/>
                    <Button Content="Add to sheet" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="0,20,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
