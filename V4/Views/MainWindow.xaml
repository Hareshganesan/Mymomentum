<Window x:Class="Momentum.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Momentum.Views"
        Title="Momentum" Width="1440" Height="900" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Icon="/Assets/app_icon.ico"
        FontFamily="{StaticResource UiFont}" Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" FontWeight="Normal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Title bar (draggable) ================= -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
            <ContentControl Content="{StaticResource LogoMark}" Focusable="False" Width="20" Height="20"/>
            <TextBlock Text="Momentum" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource Text}" VerticalAlignment="Center" Margin="9,0,0,0"/>
        </StackPanel>

        <StackPanel x:Name="TitleActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Consecutive days with practice (app + LeetCode)">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StreakText}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Width="1" Height="14" Background="{DynamicResource Border}" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding SyncText}" FontSize="12" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="0,0,2,0"/>
            <Button Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="12" Content="&#xE895;" Command="{Binding SyncCommand}" ToolTip="Sync LeetCode now"/>
            <Button Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="12" Content="&#xE706;" Command="{Binding ToggleThemeCommand}" ToolTip="Light / dark"/>
            <Button Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="12" Content="&#xF3B1;" Command="{Binding SignOutCommand}" ToolTip="Sign out"/>
            <Border Width="1" Height="14" Background="{DynamicResource Border}" Margin="8,0,0,0"/>
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize"/>
            <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize"/>
            <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
        </StackPanel>

        <!-- ================= Navigation rail ================= -->
        <Border x:Name="NavRail" Grid.Row="1" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,12,10,12">
                <!-- Readiness: compact, links to the breakdown -->
                <Button DockPanel.Dock="Bottom" Style="{StaticResource BaseButton}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                        Padding="10,8" HorizontalContentAlignment="Stretch" Command="{Binding NavigateCommand}" CommandParameter="insights"
                        ToolTip="Readiness — open the breakdown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Readiness" FontSize="11.5" Foreground="{DynamicResource TextFaint}"/>
                            <TextBlock Text="{Binding ReadinessLevel}" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource Text}" Margin="0,1,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Readiness, StringFormat={}{0:0}}" FontSize="18" FontWeight="Medium"
                                   Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <ListBox ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}" Style="{StaticResource PlainList}"
                         ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15" Width="16" TextAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Badge}" FontSize="11.5" FontWeight="Medium" Typography.NumeralAlignment="Tabular"
                                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                                           Visibility="{Binding Badge, Converter={StaticResource CountToVis}}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================= Page ================= -->
        <ContentControl x:Name="PageHost" Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False"/>

        <!-- Notification -->
        <Border Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
                Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                CornerRadius="8" Padding="14,9" MaxWidth="560"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Toast}" Foreground="{DynamicResource Text}" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ================= Login (covers everything until signed in) ================= -->
        <Grid x:Name="LoginLayer" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{DynamicResource Bg}" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click"/>
            </StackPanel>
            <views:LoginView x:Name="Login"/>
        </Grid>

        <!-- ================= Launch animation ("hello") ================= -->
        <Grid x:Name="SplashLayer" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{DynamicResource Bg}" MouseDown="Splash_MouseDown" Cursor="Hand" ClipToBounds="True">
            <Canvas x:Name="GreetingCanvas" Opacity="0"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox Width="440">
                    <Canvas Width="232" Height="104">
                        <!-- Hand-drawn monoline script: h-e-l-l-o in one continuous stroke. -->
                        <Path x:Name="SplashHello" Stroke="{DynamicResource Text}" StrokeThickness="4.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M8,88 C20,80 38,58 44,38 C48,24 46,12 40,12 C33,12 30,24 30,40 L30,90 C30,74 36,58 48,58 C58,58 60,68 60,78 C60,86 62,90 68,90 C76,90 86,82 92,74 C96,68 96,60 90,60 C82,60 78,70 78,78 C78,86 84,91 92,91 C98,91 104,87 108,83 C116,74 130,52 134,36 C138,22 136,12 129,12 C122,12 120,24 120,40 C120,60 120,78 121,84 C122,89 126,91 131,91 C136,91 140,88 143,84 C151,74 165,52 169,36 C173,22 171,12 164,12 C157,12 155,24 155,40 C155,60 155,78 156,84 C157,89 161,91 166,91 C171,91 175,88 178,84 C182,74 190,60 200,60 C210,60 214,70 213,78 C212,86 206,91 199,91 C192,91 188,85 189,77 C190,68 197,61 205,61 C211,61 216,63 222,60"/>
                    </Canvas>
                </Viewbox>
                <StackPanel x:Name="SplashBrand" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0" Opacity="0">
                    <ContentControl Content="{StaticResource LogoMark}" Focusable="False" Width="20" Height="20"/>
                    <TextBlock Text="Momentum" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="9,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
