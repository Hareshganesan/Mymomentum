<UserControl x:Class="Momentum.Views.PipelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32,24,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="2" Margin="0,0,12,16">
            <StackPanel>
                <TextBlock Text="Applications" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="14"
                           Text="Track every drive. Add the next round's date and Momentum shifts your daily plan toward that company."/>
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="Add application" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Stats -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ActiveCount}" Style="{StaticResource Stat}" FontSize="20"/>
                    <TextBlock Text="in progress" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding UpcomingCount}" Style="{StaticResource Stat}" FontSize="20"/>
                    <TextBlock Text="rounds this week" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding OfferCount}" Style="{StaticResource Stat}" FontSize="20" Foreground="{DynamicResource Success}"/>
                    <TextBlock Text="offers" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Border>
            <Button Style="{StaticResource GhostButton}" Command="{Binding ToggleArchivedCommand}" VerticalAlignment="Center">
                <TextBlock Text="{Binding Archived.Count, StringFormat=Archived ({0})}"/>
            </Button>
        </StackPanel>

        <!-- Board -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource Inset}" Margin="0,0,0,12" MaxWidth="900" HorizontalAlignment="Left" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Muted}"
                               Text="No applications yet. Add the companies visiting your campus (or that you're applying to off-campus) — even wishlist ones. When an OA date is close, Today will prioritise that company's commonly asked problems."/>
                </Border>
                <ItemsControl ItemsSource="{Binding Columns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="236" Margin="0,0,12,0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="12" Padding="10" VerticalAlignment="Top" MinHeight="200">
                                <StackPanel>
                                    <Grid Margin="6,4,6,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource H3}"/>
                                            <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Pill}">
                                            <TextBlock Text="{Binding Items.Count}" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
                                        </Border>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource BaseButton}" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Border}"
                                                        Padding="12,10" Margin="0,0,0,8" HorizontalContentAlignment="Stretch" FontWeight="Normal" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Company}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                                            <Run Text="{Binding Role, Mode=OneWay}"/><Run Text="{Binding Ctc, Mode=OneWay, StringFormat={} · {0}}"/>
                                                        </TextBlock>
                                                        <Border CornerRadius="6" Padding="6,3" Margin="0,8,0,0" HorizontalAlignment="Left"
                                                                Background="{Binding IsSoon, Converter={StaticResource BoolToBrush}, ConverterParameter=WarningSoft|Surface}"
                                                                Visibility="{Binding EventText, Converter={StaticResource StringToVis}}">
                                                            <TextBlock Text="{Binding EventText}" FontSize="11.5" TextWrapping="Wrap"
                                                                       Foreground="{Binding IsSoon, Converter={StaticResource BoolToBrush}, ConverterParameter=Warning|TextMuted}"/>
                                                        </Border>
                                                        <Grid Margin="0,8,0,0">
                                                            <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11" Content="&#xE76B;" HorizontalAlignment="Left"
                                                                    ToolTip="Move back" CommandParameter="{Binding}"
                                                                    Command="{Binding DataContext.PrevCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                            <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="11" Content="&#xE76C;" HorizontalAlignment="Right"
                                                                    ToolTip="Advance to next stage" CommandParameter="{Binding}"
                                                                    Command="{Binding DataContext.NextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Archived -->
                <Border Style="{StaticResource Card}" Margin="0,4,12,0" HorizontalAlignment="Left" MinWidth="400"
                        Visibility="{Binding ShowArchived, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Archived" Style="{StaticResource Overline}"/>
                        <TextBlock Text="Nothing archived." Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Visibility="{Binding Archived.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}"/>
                        <ItemsControl ItemsSource="{Binding Archived}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Style="{StaticResource Body}"><Run Text="{Binding Company, Mode=OneWay}"/><Run Text="{Binding Role, Mode=OneWay, StringFormat={} · {0}}" Foreground="{DynamicResource TextFaint}"/></TextBlock>
                                        <Button Style="{StaticResource LinkButton}" Content="Restore" HorizontalAlignment="Right" FontSize="12" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Editor -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Width="380" Margin="16,0,0,0" Style="{StaticResource Card}" Padding="0"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,18,22,22" DataContext="{Binding Selected}">
                    <Grid>
                        <TextBlock Text="Application" Style="{StaticResource Overline}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right"
                                Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </Grid>
                    <TextBox Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" FontSize="18" FontWeight="SemiBold" Tag="Company" Margin="0,6,0,0"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Role" Style="{StaticResource Overline}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Role, UpdateSourceTrigger=PropertyChanged}" Tag="SDE-1 / Intern"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CTC" Style="{StaticResource Overline}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Ctc, UpdateSourceTrigger=PropertyChanged}" Tag="18 LPA"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Stage" Style="{StaticResource Overline}" Margin="0,14,0,6"/>
                    <ComboBox ItemsSource="{Binding DataContext.StageChoices, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Stage}"/>

                    <TextBlock Text="Next round" Style="{StaticResource Overline}" Margin="0,14,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NextEventTitle, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. Online assessment"/>
                        <DatePicker Grid.Column="2" SelectedDate="{Binding NextEventDate}" Height="38"/>
                    </Grid>

                    <TextBlock Text="Link" Style="{StaticResource Overline}" Margin="0,14,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Tag="Careers page or portal"/>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8A7;" Margin="6,0,0,0" ToolTip="Open link"
                                Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </Grid>

                    <TextBlock Text="Notes — rounds, questions asked, contacts" Style="{StaticResource Overline}" Margin="0,14,0,6"/>
                    <TextBox Style="{StaticResource MultilineBox}" MinHeight="110" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             Tag="What did they ask? What would you prepare differently?"/>

                    <Border Style="{StaticResource Inset}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Prep pack" Style="{StaticResource Overline}"/>
                            <TextBlock Text="{Binding PrepText}" Style="{StaticResource Muted}" Margin="0,6,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Practise their problems" Style="{StaticResource SecondaryButton}" Padding="12,6"
                                        Command="{Binding DataContext.PracticeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <Button Content="Company mock" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="8,0,0,0"
                                        Command="{Binding DataContext.MockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Archive (rejected)" Style="{StaticResource GhostButton}"
                                Command="{Binding DataContext.ArchiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <Button Content="Delete" Style="{StaticResource GhostButton}" Foreground="{DynamicResource Danger}"
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
