<UserControl x:Class="Momentum.Views.PipelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Momentum.Views"
             xmlns:vm="clr-namespace:Momentum.ViewModels">
    <UserControl.Resources>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource Stat}">
            <Setter Property="FontSize" Value="22"/>
        </Style>
        <Style x:Key="MiniArrow" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
        <DataTemplate x:Key="JourneyRow">
                                                <Button Style="{StaticResource BaseButton}" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Divider}"
                                                        Padding="14,10" HorizontalContentAlignment="Stretch" FontWeight="Normal" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40"/>
                                                            <ColumnDefinition Width="200"/>
                                                            <ColumnDefinition Width="*" MinWidth="320"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="30" Height="30" CornerRadius="7" Background="{DynamicResource Hover}" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Initial}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Company}" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Style="{StaticResource Caption}">
                                                                <Run Text="{Binding Role, Mode=OneWay}"/><Run Text="{Binding EmailBadge, Mode=OneWay, StringFormat={}  {0}}"/>
                                                            </TextBlock>
                                                            <TextBlock Text="Campus drive" FontSize="11" Foreground="{DynamicResource Accent}" Visibility="{Binding IsCampus, Converter={StaticResource BoolToVis}}"/>
                                                        </StackPanel>

                                                        <!-- The journey track -->
                                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Track}" Margin="8,0,16,0" VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="14"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>
                                                                        <Border Height="2" HorizontalAlignment="Stretch" Margin="50,0,-50,0" VerticalAlignment="Center"
                                                                                Background="{Binding LineDone, Converter={StaticResource BoolToBrush}, ConverterParameter=AccentLine|Border}"
                                                                                Visibility="{Binding HasNext, Converter={StaticResource BoolToVis}}"/>
                                                                        <Ellipse Width="10" Height="10" HorizontalAlignment="Left" Margin="0,0,0,0"
                                                                                 Fill="{Binding IsPassed, Converter={StaticResource BoolToBrush}, ConverterParameter=Accent|Surface}"
                                                                                 Stroke="{Binding State, Converter={x:Static local:ViewHelpers.TrackStroke}}" StrokeThickness="1.5"/>
                                                                        <Ellipse Width="16" Height="16" HorizontalAlignment="Left" Margin="-3,0,0,0" Stroke="{DynamicResource Accent}" StrokeThickness="1.5"
                                                                                 Fill="{DynamicResource AccentSoft}" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}"/>
                                                                        <Grid Width="16" Height="16" HorizontalAlignment="Left" Margin="-3,0,0,0" Visibility="{Binding IsRejectedHere, Converter={StaticResource BoolToVis}}"
                                                                              ToolTip="Rejected at this stage">
                                                                            <Ellipse Stroke="{DynamicResource Danger}" StrokeThickness="1.5" Fill="{DynamicResource DangerSoft}"/>
                                                                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="7" Foreground="{DynamicResource Danger}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                        <StackPanel Grid.Row="1" Margin="0,5,0,0">
                                                                            <TextBlock Text="{Binding Label}" FontSize="11.5"
                                                                                       Foreground="{Binding IsCurrent, Converter={StaticResource BoolToBrush}, ConverterParameter=Text|TextFaint}"/>
                                                                            <TextBlock Text="{Binding Date}" FontSize="10.5" Foreground="{DynamicResource TextFaint}" Typography.NumeralAlignment="Tabular"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                            <TextBlock Text="Quiet for" Style="{StaticResource Caption}" FontSize="11"/>
                                                            <TextBlock Text="{Binding QuietText}" FontSize="13" FontWeight="Medium" Typography.NumeralAlignment="Tabular"
                                                                       Foreground="{Binding IsSilent, Converter={StaticResource BoolToBrush}, ConverterParameter=Warning|Text}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource MiniArrow}" Content="&#xE76B;" ToolTip="Move back a stage" CommandParameter="{Binding}"
                                                                    Command="{Binding DataContext.PrevCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                            <Button Style="{StaticResource MiniArrow}" Content="&#xE76C;" ToolTip="Advance a stage" CommandParameter="{Binding}"
                                                                    Command="{Binding DataContext.NextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Margin="32,24,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Header ================= -->
        <Grid Grid.ColumnSpan="2" Margin="0,0,8,16">
            <StackPanel>
                <TextBlock Text="Applications" Style="{StaticResource H1}"/>
                <TextBlock Text="Every drive in one place — updated from your inbox, aged automatically." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding MailStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="380"
                           Visibility="{Binding IsMailConnected, Converter={StaticResource BoolToVis}}"/>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding SyncMailCommand}" Margin="0,0,8,0"
                        Visibility="{Binding IsMailConnected, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SyncLabel}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Content="Connect inbox" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleMailSetupCommand}" Margin="0,0,8,0"
                        Visibility="{Binding IsMailConnected, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE713;" Command="{Binding ToggleMailSetupCommand}" ToolTip="Inbox settings" Margin="0,0,8,0"
                        Visibility="{Binding IsMailConnected, Converter={StaticResource BoolToVis}}"/>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Add" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= Insights ================= -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,36,0">
                    <TextBlock Text="Applied" Style="{StaticResource Overline}"/>
                    <TextBlock Text="{Binding TotalApplied}" Style="{StaticResource StatValue}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,36,0" ToolTip="Share of applications that got an online test, interview, offer or a decision">
                    <TextBlock Text="Response rate" Style="{StaticResource Overline}"/>
                    <TextBlock Text="{Binding ResponseRate}" Style="{StaticResource StatValue}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource BaseButton}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,36,0"
                        HorizontalContentAlignment="Left" Command="{Binding SetFilterCommand}" CommandParameter="followup" ToolTip="Show only these">
                    <StackPanel>
                        <TextBlock Text="Waiting 3+ weeks" Style="{StaticResource Overline}"/>
                        <TextBlock Text="{Binding SilentCount}" Style="{StaticResource StatValue}" Margin="0,2,0,0"
                                   Foreground="{DynamicResource Warning}"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="3" Margin="0,0,36,0">
                    <TextBlock Text="Offers" Style="{StaticResource Overline}"/>
                    <TextBlock Text="{Binding OfferCount}" Style="{StaticResource StatValue}" Margin="0,2,0,0" Foreground="{DynamicResource Success}"/>
                </StackPanel>

                <!-- Funnel -->
                <ItemsControl Grid.Column="4" ItemsSource="{Binding Funnel}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,0">
                                <Grid>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding Count}" Style="{StaticResource Caption}" Foreground="{DynamicResource Text}" HorizontalAlignment="Right"
                                               Typography.NumeralAlignment="Tabular"/>
                                </Grid>
                                <ProgressBar Value="{Binding Ratio, Mode=OneWay}" Foreground="{DynamicResource Accent}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ================= Inbox setup (toggle) ================= -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="{Binding ShowMailSetup, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Track applications from your inbox" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding MailStatus}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="None"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                               Text="Momentum reads only job-related emails (read-only): confirmations, online tests, interviews, offers and rejections. Portals, coding sites and college mail are ignored. Silent applications are archived after 45 days."/>
                    <Button Content="Disconnect inbox" Style="{StaticResource GhostButton}" Foreground="{DynamicResource Danger}" HorizontalAlignment="Left" Margin="-8,10,0,0"
                            Command="{Binding DisconnectMailCommand}" Visibility="{Binding IsMailConnected, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Gmail · read-only (recommended)" Style="{StaticResource H3}"/>
                    <TextBlock Text="Google Client ID" Style="{StaticResource Overline}" Margin="0,10,0,6"/>
                    <TextBox Text="{Binding GoogleClientId, UpdateSourceTrigger=PropertyChanged}" Tag="...apps.googleusercontent.com"/>
                    <TextBlock Text="Client secret" Style="{StaticResource Overline}" Margin="0,10,0,6"/>
                    <PasswordBox x:Name="GoogleSecret"/>
                    <TextBlock Text="Saved (encrypted). Leave blank to keep it." Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Visibility="{Binding HasGoogleSecret, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Sign in with Google" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="GoogleSignIn_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Other mail · app password" Style="{StaticResource H3}"/>
                    <TextBlock Text="Email address" Style="{StaticResource Overline}" Margin="0,10,0,6"/>
                    <TextBox Text="{Binding MailAddress, UpdateSourceTrigger=PropertyChanged}" Tag="you@yahoo.com"/>
                    <TextBlock Text="App password" Style="{StaticResource Overline}" Margin="0,10,0,6"/>
                    <PasswordBox x:Name="MailPwd"/>
                    <Button Content="Connect" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="ConnectMail_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Toolbar: search + filters ================= -->
        <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" Tag="Search companies"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource ChipRadio}" Content="All" GroupName="pf" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=all}"/>
                <RadioButton Style="{StaticResource ChipRadio}" Content="Needs follow-up" GroupName="pf" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=followup}"/>
                <RadioButton Style="{StaticResource ChipRadio}" Content="Heard back this week" GroupName="pf" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=recent}"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding ToggleArchivedCommand}" VerticalAlignment="Center">
                <TextBlock Text="{Binding Archived.Count, StringFormat=Archived ({0})}"/>
            </Button>
        </Grid>

        <!-- ================= Board ================= -->
        <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Inset}" Margin="0,0,0,12" MaxWidth="900" HorizontalAlignment="Left"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Muted}"
                               Text="No applications yet. Connect your inbox to import them automatically, or add companies by hand."/>
                </Border>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,18">
                                <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding Accent, Converter={x:Static local:ViewHelpers.ResourceBrush}}"/>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding Count}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1" CornerRadius="10">
                                    <ItemsControl ItemsSource="{Binding Groups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <ContentControl Content="{Binding Lead}" ContentTemplate="{StaticResource JourneyRow}" Focusable="False"
                                                                    Visibility="{Binding IsSingle, Converter={StaticResource BoolToVis}}"/>
                                                    <StackPanel Visibility="{Binding IsMulti, Converter={StaticResource BoolToVis}}">
                                                        <Button Style="{StaticResource BaseButton}" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Divider}"
                                                                Padding="14,10" HorizontalContentAlignment="Stretch" FontWeight="Normal" CommandParameter="{Binding}"
                                                                Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="40"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="30" Height="30" CornerRadius="7" Background="{DynamicResource Hover}" HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding Initial}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Company}" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource Text}"/>
                                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" Text="{Binding Chevron}" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            </Grid>
                                                        </Button>
                                                        <ItemsControl ItemsSource="{Binding Roles}" ItemTemplate="{StaticResource JourneyRow}" Margin="28,0,0,0"
                                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Archived -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,4,8,0"
                        Visibility="{Binding ShowArchived, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Archived — rejected or no response" Style="{StaticResource Overline}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Archived}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,8,24,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Company}" FontSize="13" Foreground="{DynamicResource Text}"/>
                                                <TextBlock Text="{Binding AgeText}" Style="{StaticResource Caption}"/>
                                            </StackPanel>
                                            <Button Style="{StaticResource LinkButton}" Content="Restore" HorizontalAlignment="Right" FontSize="12" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- ================= Detail drawer ================= -->
        <Border Grid.Row="3" Grid.RowSpan="2" Grid.Column="1" Width="360" Margin="12,0,0,0" Style="{StaticResource Card}" Padding="0"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,16,18,18" DataContext="{Binding Selected}">
                    <Grid>
                        <TextBlock Text="{Binding AgeText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,40,0"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right"
                                Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </Grid>
                    <TextBox Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" FontSize="17" FontWeight="Medium" Tag="Company" Margin="0,8,0,0"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Role" Style="{StaticResource Overline}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Role, UpdateSourceTrigger=PropertyChanged}" Tag="SDE-1 / Intern"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CTC" Style="{StaticResource Overline}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding Ctc, UpdateSourceTrigger=PropertyChanged}" Tag="18 LPA"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Stage" Style="{StaticResource Overline}" Margin="0,12,0,6"/>
                    <ComboBox ItemsSource="{Binding DataContext.StageChoices, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Stage}"/>
                    <StackPanel Visibility="{Binding IsRejected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Got as far as" Style="{StaticResource Overline}" Margin="0,12,0,6"/>
                        <ComboBox ItemsSource="{x:Static vm:ApplicationCard.ReachedChoices}" SelectedItem="{Binding ReachedStage}"/>
                    </StackPanel>
                    <TextBlock Text="Next round" Style="{StaticResource Overline}" Margin="0,12,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NextEventTitle, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. Online assessment"/>
                        <DatePicker Grid.Column="2" SelectedDate="{Binding NextEventDate}" Height="36"/>
                    </Grid>

                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="10,5"
                                Command="{Binding DataContext.OpenGmailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE715;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="Open in Gmail" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Practise their problems" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="10,5"
                                Command="{Binding DataContext.PracticeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <Button Content="Company mock" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="10,5"
                                Command="{Binding DataContext.MockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding PrepText}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None"/>

                    <!-- Timeline from inbox -->
                    <StackPanel Visibility="{Binding HasEmails, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
                        <TextBlock Text="{Binding EmailBadge, StringFormat=Timeline · {0}}" Style="{StaticResource Overline}" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding Emails}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,6,0,0" HorizontalAlignment="Left"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Subject}" FontSize="12.5" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subject}"/>
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run Text="{Binding Date, Mode=OneWay, StringFormat=d MMM}"/><Run Text=" · "/><Run Text="{Binding Stage, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding From, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Text="Notes" Style="{StaticResource Overline}" Margin="0,16,0,6"/>
                    <TextBox Style="{StaticResource MultilineBox}" MinHeight="80" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             Tag="Rounds, questions asked, contacts…"/>
                    <TextBlock Text="Link" Style="{StaticResource Overline}" Margin="0,12,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Tag="Careers page or portal"/>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8A7;" Margin="4,0,0,0" ToolTip="Open link"
                                Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </Grid>

                    <TextBlock Text="Duplicate? Merge into" Style="{StaticResource Overline}" Margin="0,16,0,6"/>
                    <ComboBox x:Name="MergeBox" ItemsSource="{Binding DataContext.MergeTargets, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              DisplayMemberPath="Company" MaxDropDownHeight="300" SelectionChanged="MergeBox_SelectionChanged"/>

                    <StackPanel Orientation="Horizontal" Margin="-8,16,0,0">
                        <Button Content="Archive" Style="{StaticResource GhostButton}"
                                Command="{Binding DataContext.ArchiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <Button Content="Delete" Style="{StaticResource GhostButton}" Foreground="{DynamicResource Danger}"
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
