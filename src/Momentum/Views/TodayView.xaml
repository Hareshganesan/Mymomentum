<UserControl x:Class="Momentum.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Momentum.Controls">
    <UserControl.Resources>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SmallPrimary" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentLine}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Completed task titles: quieter + struck through -->
        <Style x:Key="TaskTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Plan row: separator above, quiet hover -->
        <Style x:Key="PlanRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Hover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Overline}"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,24,32,32" MaxWidth="1320">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= Header ================= -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding Greeting}" Style="{StaticResource H1}"/>
                    <TextBlock Text="{Binding DateText}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,2"
                            ToolTip="Placement start date — change it in Settings">
                    <TextBlock Text="&#xE787;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource TextFaint}"/>
                    <TextBlock Margin="8,0,0,0" FontSize="12.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center">
                        <Run Text="{Binding CountdownText, Mode=OneWay}" Foreground="{DynamicResource Text}"/><Run Text="  ·  "/><Run Text="{Binding CountdownSub, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- ================= Overview metrics ================= -->
            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Readiness -->
                <Border Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Readiness" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding ReadinessScore, StringFormat={}{0:0}}" Style="{StaticResource Stat}"/>
                            <TextBlock Text="/100" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="4,0,0,6"/>
                            <TextBlock Text="{Binding ReadinessLevel}" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="12,0,0,5"/>
                        </StackPanel>
                        <Button Style="{StaticResource LinkButton}" Command="{Binding NextBestCommand}" HorizontalAlignment="Left"
                                HorizontalContentAlignment="Left" Margin="0,8,0,0" ToolTip="Next best step">
                            <TextBlock Text="{Binding NextBestText}" TextWrapping="Wrap" FontSize="12.5" FontWeight="Medium"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Problem sheet -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Problem sheet" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding PaceStatus}" FontSize="12" FontWeight="Medium" HorizontalAlignment="Right"
                                       Foreground="{Binding IsOnTrack, Converter={StaticResource BoolToBrush}, ConverterParameter=Success|Warning}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding SheetSolved}" Style="{StaticResource Stat}"/>
                            <TextBlock Text="{Binding SheetTotal, StringFormat={} / {0} solved}" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="4,0,0,5"
                                       Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>
                        <ProgressBar Value="{Binding SheetProgress, Mode=OneWay}" Foreground="{DynamicResource Accent}" Margin="0,10,0,8"/>
                        <TextBlock Text="{Binding PaceText}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None"/>
                    </StackPanel>
                </Border>

                <!-- Spaced review -->
                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Spaced review" Style="{StaticResource SectionLabel}"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding DueTotal}" Style="{StaticResource Stat}"/>
                            <TextBlock Text="due today" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="6,0,0,5"/>
                        </StackPanel>
                        <Grid Grid.Row="2" Margin="0,10,0,0" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DueDetail}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Start review" Style="{StaticResource SmallPrimary}" Command="{Binding StartReviewCommand}"
                                    Visibility="{Binding DueTotal, Converter={StaticResource CountToVis}}" Margin="10,0,0,0"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= Main: plan + supporting panel ================= -->
            <Grid x:Name="MainGrid" Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="GapCol" Width="16"/>
                    <ColumnDefinition x:Name="SideCol" Width="320"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Today's plan (primary focus) + pattern progress -->
                <StackPanel VerticalAlignment="Top">
                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <Grid Margin="18,14,12,12">
                            <StackPanel>
                                <TextBlock Text="Today's plan" Style="{StaticResource H2}"/>
                                <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource Caption}" Margin="0,3,0,0" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                            <Button Style="{StaticResource GhostButton}" Command="{Binding RegenerateCommand}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    ToolTip="Rebuild today's plan from your latest progress">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="Rebuild" Margin="6,0,0,0" FontSize="12.5"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Plan}" Margin="16,0,16,12" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="4" CornerRadius="2" Margin="2,0"
                                            Background="{Binding IsDone, Converter={StaticResource BoolToBrush}, ConverterParameter=Accent|ProgressTrack}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Plan}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PlanRow}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Completion: auto-tracked circle, or a checkbox for manual items -->
                                                <Grid VerticalAlignment="Center">
                                                    <Border Width="18" Height="18" CornerRadius="9" BorderThickness="1.5" HorizontalAlignment="Left"
                                                            BorderBrush="{Binding IsDone, Converter={StaticResource BoolToBrush}, ConverterParameter=Success|BorderStrong}"
                                                            Background="{Binding IsDone, Converter={StaticResource BoolToBrush}, ConverterParameter=Success|Surface}"
                                                            Visibility="{Binding IsAuto, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="Ticks itself off when you do it">
                                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="{DynamicResource Bg}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}"/>
                                                    </Border>
                                                    <CheckBox IsChecked="{Binding IsDone}" Visibility="{Binding IsManual, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>

                                                <TextBlock Grid.Column="1" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource TextFaint}"/>

                                                <StackPanel Grid.Column="2" Margin="4,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource TaskTitle}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                 Fill="{Binding Problem.Difficulty, Converter={StaticResource DifficultyBrush}}"
                                                                 Visibility="{Binding HasDifficulty, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <TextBlock Grid.Column="3" Text="{Binding MinutesText}" Style="{StaticResource Caption}" VerticalAlignment="Center" MinWidth="44" TextAlignment="Right"
                                                           Typography.NumeralAlignment="Tabular" Margin="0,0,10,0"/>

                                                <!-- Actions per kind -->
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsNewProblem, Converter={StaticResource BoolToVis}}">
                                                        <Button Style="{StaticResource SmallButton}" CommandParameter="{Binding}" ToolTip="Open on LeetCode"
                                                                Command="{Binding DataContext.OpenProblemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Open"/>
                                                                <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource SmallPrimary}" Content="Mark solved" CommandParameter="{Binding}"
                                                                Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                                                Command="{Binding DataContext.StartGradingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    </StackPanel>
                                                    <Button Style="{StaticResource SmallPrimary}" Content="Review" CommandParameter="{Binding}"
                                                            Visibility="{Binding IsReview, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.ReviewItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    <Button Style="{StaticResource SmallButton}" Content="Study"
                                                            Visibility="{Binding IsCards, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.StudyCardsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" Content="&#xE74D;" CommandParameter="{Binding}" ToolTip="Remove task"
                                                            Visibility="{Binding IsTask, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Inline grading after a solve -->
                                            <StackPanel Visibility="{Binding IsGrading, Converter={StaticResource BoolToVis}}" Margin="54,12,0,2">
                                                <TextBlock Text="How did it go? This sets when you'll see it again." Style="{StaticResource Caption}"/>
                                                <UniformGrid Columns="4" Margin="0,8,0,10">
                                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.GradeAgainCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <StackPanel><TextBlock Text="Needed help" Foreground="{DynamicResource Danger}" HorizontalAlignment="Center"/><TextBlock Text="again tomorrow" Style="{StaticResource Caption}" HorizontalAlignment="Center"/></StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.GradeHardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <StackPanel><TextBlock Text="Struggled" Foreground="{DynamicResource Warning}" HorizontalAlignment="Center"/><TextBlock Text="in 2 days" Style="{StaticResource Caption}" HorizontalAlignment="Center"/></StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.GradeGoodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <StackPanel><TextBlock Text="Solved it" Foreground="{DynamicResource Success}" HorizontalAlignment="Center"/><TextBlock Text="in 4 days" Style="{StaticResource Caption}" HorizontalAlignment="Center"/></StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource SecondaryButton}" CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.GradeEasyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <StackPanel><TextBlock Text="Easy" Foreground="{DynamicResource Text}" HorizontalAlignment="Center"/><TextBlock Text="in a week" Style="{StaticResource Caption}" HorizontalAlignment="Center"/></StackPanel>
                                                    </Button>
                                                </UniformGrid>
                                                <TextBox Text="{Binding Problem.Notes, UpdateSourceTrigger=PropertyChanged}"
                                                         Tag="Key insight in one line — what you'd tell yourself next time (optional)"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="18,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TaskBox" Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" Tag="Add a task for today — press Enter"
                                         KeyDown="TaskBox_KeyDown"/>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Add" Command="{Binding AddTaskCommand}" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>


                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Pattern roadmap" Style="{StaticResource H2}"/>
                            <TextBlock Text="Sheet problems solved per pattern" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Patterns}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="8,5" Margin="0,0,12,0" CommandParameter="{Binding Key}"
                                            Command="{Binding DataContext.OpenPatternCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Foreground="{Binding IsFocus, Converter={StaticResource BoolToBrush}, ConverterParameter=Accent|Text}"/>
                                            <ProgressBar Grid.Column="1" Value="{Binding Ratio, Mode=OneWay}" Height="3" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource Caption}" TextAlignment="Right"
                                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                </StackPanel>

                <!-- Supporting information: one panel, sections divided -->
                <Border x:Name="RightPanel" Grid.Column="2" Style="{StaticResource Card}" Padding="18,16" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Current focus pattern" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding FocusPatternName}" Style="{StaticResource H3}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None"/>
                        <TextBlock Text="{Binding FocusPatternCue}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                        <ProgressBar Value="{Binding FocusPatternProgress, Mode=OneWay}" Margin="0,12,0,6"/>
                        <Grid>
                            <TextBlock Text="{Binding FocusPatternStats}" Style="{StaticResource Caption}" Typography.NumeralAlignment="Tabular"/>
                            <Button Style="{StaticResource LinkButton}" Content="Open pattern" HorizontalAlignment="Right" FontSize="12" Command="{Binding FocusPatternCommand}"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Divider}" Margin="-18,16"/>

                        <Grid>
                            <TextBlock Text="Coming up" Style="{StaticResource SectionLabel}"/>
                            <Button Style="{StaticResource LinkButton}" Content="Applications" HorizontalAlignment="Right" FontSize="12" Command="{Binding OpenPipelineCommand}"/>
                        </Grid>
                        <TextBlock Text="No assessments or interviews in the next 3 weeks." Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"
                                   Visibility="{Binding Upcoming.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}"/>
                        <ItemsControl ItemsSource="{Binding Upcoming}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Company}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding When}" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{Binding IsSoon, Converter={StaticResource BoolToBrush}, ConverterParameter=Warning|TextMuted}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Height="1" Background="{DynamicResource Divider}" Margin="-18,16"/>

                        <Grid>
                            <TextBlock Text="Consistency" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding ActivitySummary}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                        </Grid>
                        <controls:Heatmap Data="{Binding Activity}" Weeks="18" Cell="12" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        <Grid Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Less" Style="{StaticResource Caption}" FontSize="11" Margin="0,0,5,0"/>
                                <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource HeatEmpty}" Margin="1,0"/>
                                <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource Heat1}" Margin="1,0"/>
                                <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource Heat2}" Margin="1,0"/>
                                <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource Heat3}" Margin="1,0"/>
                                <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource Heat4}" Margin="1,0"/>
                                <TextBlock Text="More" Style="{StaticResource Caption}" FontSize="11" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
