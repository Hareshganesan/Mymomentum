<UserControl x:Class="Momentum.Views.InsightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Momentum.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="1280">
            <TextBlock Text="Insights" Style="{StaticResource H1}"/>
            <TextBlock Text="Where you stand, and exactly what moves the needle." Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,20"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Readiness breakdown -->
                <Border Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Readiness breakdown" Style="{StaticResource H2}"/>
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource H2}">
                                <Run Text="{Binding Readiness.Score, Mode=OneWay}"/><Run Text="/100" Foreground="{DynamicResource TextFaint}"/>
                            </TextBlock>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Readiness.Parts}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,12,0,0">
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource H3}"/>
                                            <TextBlock Text="{Binding PointsText}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding Ratio, Mode=OneWay}" Margin="0,6,0,4"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"/>
                                        <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" FontSize="12.5" Margin="0,2,0,0" CommandParameter="{Binding NavKey}"
                                                Command="{Binding DataContext.GoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <TextBlock Text="{Binding Action}" TextWrapping="Wrap"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <!-- LeetCode -->
                    <Border Style="{StaticResource Card}" Padding="22">
                        <StackPanel>
                            <TextBlock Text="LeetCode" Style="{StaticResource H2}"/>
                            <TextBlock Text="Link your username in Settings to pull in your solved count, streak and skill tags." Style="{StaticResource Muted}" Margin="0,8,0,0"
                                       Visibility="{Binding HasLeetCode, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                            <StackPanel Visibility="{Binding HasLeetCode, Converter={StaticResource BoolToVis}}">
                                <UniformGrid Columns="4" Margin="0,12,0,0">
                                    <StackPanel><TextBlock Text="{Binding LeetCode.Total}" Style="{StaticResource Stat}" FontSize="24"/><TextBlock Text="solved" Style="{StaticResource Caption}"/></StackPanel>
                                    <StackPanel><TextBlock Text="{Binding LeetCode.Easy}" Style="{StaticResource Stat}" FontSize="24" Foreground="{DynamicResource EasyBrush}"/><TextBlock Text="easy" Style="{StaticResource Caption}"/></StackPanel>
                                    <StackPanel><TextBlock Text="{Binding LeetCode.Medium}" Style="{StaticResource Stat}" FontSize="24" Foreground="{DynamicResource MediumBrush}"/><TextBlock Text="medium" Style="{StaticResource Caption}"/></StackPanel>
                                    <StackPanel><TextBlock Text="{Binding LeetCode.Hard}" Style="{StaticResource Stat}" FontSize="24" Foreground="{DynamicResource HardBrush}"/><TextBlock Text="hard" Style="{StaticResource Caption}"/></StackPanel>
                                </UniformGrid>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0">
                                    <Run Text="Rank "/><Run Text="{Binding LeetCode.Ranking, Mode=OneWay, StringFormat=N0}"/><Run Text=" · "/><Run Text="{Binding LeetCode.ActiveDays, Mode=OneWay}"/><Run Text=" active days · current streak "/><Run Text="{Binding LeetCode.Streak, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Weekly activity -->
                    <Border Style="{StaticResource Card}" Padding="22" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Last 12 weeks" Style="{StaticResource H2}"/>
                            <ItemsControl ItemsSource="{Binding Weeks}" Margin="0,14,0,0" Height="122">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Bottom" Margin="3,0" ToolTip="{Binding Value}">
                                            <Border Height="{Binding Height}" CornerRadius="4,4,0,0" Background="{DynamicResource Accent}"/>
                                            <TextBlock Text="{Binding Label}" FontSize="9.5" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Review forecast -->
                    <Border Style="{StaticResource Card}" Padding="22" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Review forecast" Style="{StaticResource H2}"/>
                            <TextBlock Text="{Binding ForecastSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            <ItemsControl ItemsSource="{Binding Forecast}" Margin="0,14,0,0" Height="118">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Bottom" Margin="2,0" ToolTip="{Binding Value}">
                                            <TextBlock Text="{Binding Value}" FontSize="10" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                            <Border Height="{Binding Height}" CornerRadius="3,3,0,0" Background="{DynamicResource ProgressNeutral}"/>
                                            <TextBlock Text="{Binding Label}" FontSize="9.5" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Pattern mastery -->
            <Border Style="{StaticResource Card}" Padding="22" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Pattern mastery" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding Weakest}" Style="{StaticResource Muted}" Margin="0,4,0,8"/>
                    <ItemsControl ItemsSource="{Binding Patterns}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Margin="0,0,12,2" Padding="10,8" CommandParameter="{Binding Key}"
                                        Command="{Binding DataContext.PatternCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar Grid.Column="1" Value="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Detail}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Consistency — past year" Style="{StaticResource H2}"/>
                    <controls:Heatmap Data="{Binding Activity}" Weeks="52" Cell="13" Margin="0,14,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
