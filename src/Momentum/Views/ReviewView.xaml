<UserControl x:Class="Momentum.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Momentum.Views"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <Style x:Key="GradeLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GradeSub" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,24,32,32">
            <!-- ============ Idle: choose a session ============ -->
            <StackPanel Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}" MaxWidth="980" HorizontalAlignment="Left">
                <TextBlock Text="Review" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="14"
                           Text="Spaced repetition: each item comes back right before you'd forget it. Ten focused minutes here protect hours of past work."/>

                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="&#xE943;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource Accent}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding DueProblems}" Style="{StaticResource Stat}" Margin="0,10,0,0"/>
                            <TextBlock Text="problems due" Style="{StaticResource Muted}"/>
                            <Button Content="Review problems" Style="{StaticResource SecondaryButton}" Margin="0,14,0,0" HorizontalAlignment="Left"
                                    Command="{Binding StartProblemsCommand}" IsEnabled="{Binding DueProblems, Converter={x:Static local:ReviewView.NonZero}}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource Accent}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding DueCards}" Style="{StaticResource Stat}" Margin="0,10,0,0"/>
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding NewCards, StringFormat=cards due · {0} new available today}"/>
                            <Button Content="Study cards" Style="{StaticResource SecondaryButton}" Margin="0,14,0,0" HorizontalAlignment="Left"
                                    Command="{Binding StartCardsCommand}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="&#xE7C1;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource Warning}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding WeakCount}" Style="{StaticResource Stat}" Margin="0,10,0,0"/>
                            <TextBlock Text="weak spots (recalled poorly before)" Style="{StaticResource Muted}"/>
                            <Button Content="Practise ahead" Style="{StaticResource SecondaryButton}" Margin="0,14,0,0" HorizontalAlignment="Left"
                                    Command="{Binding PracticeWeakCommand}" IsEnabled="{Binding WeakCount, Converter={x:Static local:ReviewView.NonZero}}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}">
                                <Run Text="{Binding DueProblems, Mode=OneWay}"/><Run Text=" problems + "/><Run Text="{Binding DueCards, Mode=OneWay}"/><Run Text=" cards waiting"/>
                            </TextBlock>
                            <TextBlock Text="{Binding UpcomingText}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Start today's review" Style="{StaticResource PrimaryButton}" Padding="20,11" FontSize="14"
                                Command="{Binding StartMixedCommand}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Inset}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="How grading works" Style="{StaticResource Overline}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                   Text="Forgot → back tomorrow and the item gets a little harder. Fuzzy → a short interval. Recalled → the interval grows (4 days → 10 days → weeks). Instant → it grows faster. Be honest: the schedule only works if the grades are real."/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="Shortcuts: Space to reveal · 1 2 3 4 to grade · S to skip"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ Active session ============ -->
            <Grid Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" MaxWidth="820">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Column="1" Value="{Binding Progress, Mode=OneWay}" Margin="14,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Content="Skip" Command="{Binding SkipCommand}"/>
                            <Button Style="{StaticResource GhostButton}" Content="End session" Command="{Binding EndCommand}"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Card}" Padding="32,28" MinHeight="260">
                        <StackPanel DataContext="{Binding Current}">
                            <TextBlock Text="{Binding Kicker}" Style="{StaticResource Overline}"/>
                            <TextBlock Text="{Binding Front}" Style="{StaticResource H1}" FontSize="24" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding Prompt}" Style="{StaticResource Muted}" Margin="0,12,0,0"/>

                            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Visibility="{Binding IsProblem, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Re-solve on LeetCode" FontSize="12.5"/>
                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Answer -->
                            <StackPanel Margin="0,22,0,0" Visibility="{Binding DataContext.IsRevealed, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,20"/>

                                <!-- Card answer -->
                                <TextBlock Text="{Binding Card.Answer}" Style="{StaticResource Body}" FontSize="14.5" LineHeight="23"
                                           Visibility="{Binding IsCard, Converter={StaticResource BoolToVis}}"/>

                                <!-- Problem answer -->
                                <StackPanel Visibility="{Binding IsProblem, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Pattern" Style="{StaticResource Overline}"/>
                                    <TextBlock Text="{Binding Problem.PatternName}" Style="{StaticResource H3}" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Problem.PatternCue}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>

                                    <TextBlock Text="Key idea" Style="{StaticResource Overline}" Margin="0,16,0,4"/>
                                    <TextBlock Text="{Binding Problem.Hint}" Style="{StaticResource Body}"/>

                                    <TextBlock Text="Your notes" Style="{StaticResource Overline}" Margin="0,16,0,6"/>
                                    <TextBox Style="{StaticResource MultilineBox}" MinHeight="56" Text="{Binding Problem.Notes, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                             Tag="No notes yet. Write the one-line insight now — future you will thank you."/>
                                    <StackPanel Visibility="{Binding Problem.Mistakes, Converter={StaticResource StringToVis}}">
                                        <TextBlock Text="Mistakes you made before" Style="{StaticResource Overline}" Margin="0,14,0,4"/>
                                        <TextBlock Text="{Binding Problem.Mistakes}" Style="{StaticResource Body}" Foreground="{DynamicResource Warning}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Reveal / grade -->
                    <Button Content="Reveal answer  (Space)" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" Padding="20,13" FontSize="14"
                            Command="{Binding RevealCommand}" HorizontalAlignment="Stretch"
                            Visibility="{Binding IsRevealed, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>

                    <UniformGrid Columns="4" Margin="0,16,0,0" Visibility="{Binding IsRevealed, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource GradeButton}" Margin="0,0,8,0" Command="{Binding AgainCommand}">
                            <StackPanel>
                                <TextBlock Text="{Binding AgainLabel}" Style="{StaticResource GradeLabel}" Foreground="{DynamicResource Danger}"/>
                                <TextBlock Style="{StaticResource GradeSub}" Text="{Binding AgainInterval, StringFormat=1 · {0}}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GradeButton}" Margin="0,0,8,0" Command="{Binding HardCommand}">
                            <StackPanel>
                                <TextBlock Text="{Binding HardLabel}" Style="{StaticResource GradeLabel}" Foreground="{DynamicResource Warning}"/>
                                <TextBlock Style="{StaticResource GradeSub}" Text="{Binding HardInterval, StringFormat=2 · {0}}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GradeButton}" Margin="0,0,8,0" Command="{Binding GoodCommand}">
                            <StackPanel>
                                <TextBlock Text="{Binding GoodLabel}" Style="{StaticResource GradeLabel}" Foreground="{DynamicResource Success}"/>
                                <TextBlock Style="{StaticResource GradeSub}" Text="{Binding GoodInterval, StringFormat=3 · {0}}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GradeButton}" Command="{Binding EasyCommand}">
                            <StackPanel>
                                <TextBlock Text="{Binding EasyLabel}" Style="{StaticResource GradeLabel}" Foreground="{DynamicResource Accent}"/>
                                <TextBlock Style="{StaticResource GradeSub}" Text="{Binding EasyInterval, StringFormat=4 · {0}}"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Grid>

            <!-- ============ Complete ============ -->
            <Border Style="{StaticResource Card}" Padding="36" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0"
                    Visibility="{Binding IsComplete, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource SuccessSoft}" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="{DynamicResource Success}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Session complete" Style="{StaticResource H1}" Margin="0,16,0,6"/>
                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Muted}" FontSize="14"/>
                    <TextBlock Text="{Binding UpcomingText}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button Content="Back to Today" Style="{StaticResource PrimaryButton}" Command="{Binding GoTodayCommand}"/>
                        <Button Content="Review menu" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding BackCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
