<UserControl x:Class="Momentum.Views.CoreCsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Momentum.Views">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Core CS" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="14">
                    <Run Text="The OS, DBMS, SQL, Networks, OOP and System Design questions interviewers actually ask. "/>
                    <Run Text="{Binding KnownCount, Mode=OneWay}"/><Run Text=" of "/><Run Text="{Binding TotalCount, Mode=OneWay}"/><Run Text=" known."/>
                </TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding StartAddCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Add card" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding StudyCommand}">
                    <TextBlock>
                        <Run Text="Study"/><Run Text="{Binding DueCount, Mode=OneWay, StringFormat={} {0} due}"/><Run Text=" + new"/>
                    </TextBlock>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Subject tabs -->
        <ListBox Grid.Row="1" ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject, Mode=TwoWay}" Margin="0,0,0,14"
                 Style="{StaticResource PlainList}" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Margin" Value="0,0,10,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="bd" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentLine}"/>
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" Margin="0,2,0,6"/>
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="3"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" Tag="Search questions and answers"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource ChipRadio}" Content="All" GroupName="cf" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=All}"/>
                    <RadioButton Style="{StaticResource ChipRadio}" Content="New" GroupName="cf" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=New}"/>
                    <RadioButton Style="{StaticResource ChipRadio}" Content="Due" GroupName="cf" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Due}"/>
                    <RadioButton Style="{StaticResource ChipRadio}" Content="Shaky" GroupName="cf" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Shaky}"/>
                    <RadioButton Style="{StaticResource ChipRadio}" Content="Known" GroupName="cf" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Known}"/>
                    <RadioButton Style="{StaticResource ChipRadio}" Content="Starred" GroupName="cf" IsChecked="{Binding Filter, Converter={StaticResource Equals}, ConverterParameter=Starred}"/>
                </StackPanel>
            </Grid>

            <ListBox Grid.Row="1" ItemsSource="{Binding Cards}" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource BareItem}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="0" Margin="0,0,6,6">
                            <StackPanel>
                                <Button Style="{StaticResource BaseButton}" Background="Transparent" BorderThickness="0" Padding="18,14" FontWeight="Normal"
                                        HorizontalContentAlignment="Stretch" CommandParameter="{Binding}"
                                        Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Pill}" Width="52" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Subject}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Question}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                                   TextWrapping="Wrap" Margin="12,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding StateText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Foreground="{Binding IsDue, Converter={StaticResource BoolToBrush}, ConverterParameter=Accent|TextFaint}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding IsExpanded, Converter={x:Static local:ViewHelpers.RevealGlyph}}"
                                                   FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" BorderBrush="{DynamicResource Border}"
                                        BorderThickness="0,1,0,0" Padding="82,14,18,16">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Answer}" Style="{StaticResource Body}" FontSize="13.5" LineHeight="21"/>
                                        <Grid Margin="0,14,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,6,0" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.ForgotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <TextBlock Text="Didn't know" Foreground="{DynamicResource Danger}"/>
                                                </Button>
                                                <Button Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,6,0" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.ShakyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <TextBlock Text="Shaky" Foreground="{DynamicResource Warning}"/>
                                                </Button>
                                                <Button Style="{StaticResource SecondaryButton}" Padding="12,6" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.KnewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <TextBlock Text="Knew it" Foreground="{DynamicResource Success}"/>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource IconButton}" CommandParameter="{Binding}" ToolTip="Star"
                                                        Command="{Binding DataContext.StarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <TextBlock Text="{Binding Starred, Converter={x:Static local:ViewHelpers.StarGlyph}}" FontFamily="{StaticResource IconFont}"
                                                               Foreground="{Binding Starred, Converter={StaticResource BoolToBrush}, ConverterParameter=Warning|TextMuted}"/>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" CommandParameter="{Binding}" ToolTip="Delete card"
                                                        Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Add card -->
            <Border Grid.Column="1" Grid.RowSpan="2" Width="380" Margin="16,0,0,0" Style="{StaticResource Card}" VerticalAlignment="Top"
                    Visibility="{Binding IsAdding, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="New card" Style="{StaticResource H2}"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" Command="{Binding CancelAddCommand}"/>
                    </Grid>
                    <TextBlock Text="Add questions from interview experiences or your college syllabus." Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                    <TextBlock Text="Subject" Style="{StaticResource Overline}" Margin="0,16,0,6"/>
                    <ComboBox ItemsSource="{Binding SubjectChoices}" SelectedValuePath="Key" DisplayMemberPath="Name" SelectedValue="{Binding NewSubject}"/>
                    <TextBlock Text="Question" Style="{StaticResource Overline}" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding NewQuestion, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. What is a semaphore?"/>
                    <TextBlock Text="Answer" Style="{StaticResource Overline}" Margin="0,14,0,6"/>
                    <TextBox Style="{StaticResource MultilineBox}" MinHeight="140" Text="{Binding NewAnswer, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Definition first, then the one detail that shows depth."/>
                    <Button Content="Add card" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
