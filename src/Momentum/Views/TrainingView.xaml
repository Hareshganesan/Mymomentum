<UserControl x:Class="Momentum.Views.TrainingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Momentum.Views"
             xmlns:vm="clr-namespace:Momentum.ViewModels">
    <Grid Margin="24,20,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================== -->
        <!-- LEFT COLUMN: PROBLEM SELECTOR & SEARCH                         -->
        <!-- ============================================================== -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title & Progress -->
                    <RowDefinition Height="Auto"/> <!-- Search & Filter -->
                    <RowDefinition Height="*"/>    <!-- Problem List -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="4,0,4,12">
                    <TextBlock Text="Training Coach" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding ProgressSummary}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Search & Filters -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" 
                             Tag="Search question, pattern..." Margin="0,0,0,8"/>
                    
                    <ComboBox SelectedValue="{Binding SelectedPattern, Mode=TwoWay}" SelectedValuePath="Tag" MaxDropDownHeight="320">
                        <ComboBoxItem Content="All Patterns" Tag="All"/>
                        <ComboBoxItem Content="Arrays &amp; Hashing" Tag="arrays"/>
                        <ComboBoxItem Content="Two Pointers" Tag="two-pointers"/>
                        <ComboBoxItem Content="Sliding Window" Tag="sliding-window"/>
                        <ComboBoxItem Content="Stack &amp; Monotonic" Tag="stack"/>
                        <ComboBoxItem Content="Binary Search" Tag="binary-search"/>
                        <ComboBoxItem Content="Linked List" Tag="linked-list"/>
                        <ComboBoxItem Content="Trees &amp; BST" Tag="trees"/>
                        <ComboBoxItem Content="Graphs (BFS/DFS)" Tag="graphs"/>
                        <ComboBoxItem Content="Dynamic Programming" Tag="dp-1d"/>
                        <ComboBoxItem Content="Intervals" Tag="intervals"/>
                        <ComboBoxItem Content="Heap / Priority Queue" Tag="heap"/>
                        <ComboBoxItem Content="Bit Manipulation" Tag="bits"/>
                        <ComboBoxItem Content="Backtracking" Tag="backtracking"/>
                    </ComboBox>
                </StackPanel>

                <!-- Problem List -->
                <ListBox Grid.Row="2" ItemsSource="{Binding FilteredProblems}" SelectedItem="{Binding SelectedProblem, Mode=TwoWay}"
                         Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource RowItem}"
                         VirtualizingPanel.IsVirtualizing="True" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Mastery status indicator -->
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" 
                                           Foreground="{DynamicResource Success}" VerticalAlignment="Center"
                                           Visibility="{Binding OptimalMastered, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="&#xE73C;" FontFamily="{StaticResource IconFont}" FontSize="10" 
                                           Foreground="{DynamicResource Warning}" VerticalAlignment="Center"
                                           Visibility="{Binding BruteForceStudied, Converter={StaticResource BoolToVis}}"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding PatternName}" Style="{StaticResource Caption}" FontSize="11" Margin="0,1,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="2" CornerRadius="4" Padding="5,2" Background="{DynamicResource Surface2}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DifficultyText}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{Binding Difficulty, Converter={StaticResource DifficultyBrush}}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- RIGHT COLUMN: MAIN TRAINING COCKPIT                            -->
        <!-- ============================================================== -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Question Header & Badges -->
                    <RowDefinition Height="Auto"/> <!-- Mode Selector Tabs -->
                    <RowDefinition Height="*"/>    <!-- Training Content -->
                    <RowDefinition Height="Auto"/> <!-- Bottom Mastery Actions -->
                </Grid.RowDefinitions>

                <!-- Row 0: Question Header & Navigation -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <WrapPanel Margin="0,0,0,6">
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,4">
                                <TextBlock Text="{Binding SelectedProblem.DifficultyText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding SelectedProblem.Difficulty, Converter={StaticResource DifficultyBrush}}"/>
                            </Border>
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,4">
                                <TextBlock Text="{Binding Training.PatternName}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                            </Border>
                            <Border Style="{StaticResource Pill}" Margin="0,0,6,4"
                                    Visibility="{Binding SelectedProblem.HasCompanies, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SelectedProblem.CompaniesText}" FontSize="11" Foreground="{DynamicResource TextFaint}"/>
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="{Binding SelectedProblem.Title}" Style="{StaticResource H1}" FontSize="22"/>
                        <TextBlock Text="{Binding Training.GoalSummary}" Style="{StaticResource Muted}" Margin="0,3,0,0" FontSize="13"/>
                    </StackPanel>

                    <!-- Nav Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource SecondaryButton}" Content="← Prev" Command="{Binding PrevProblemCommand}" Margin="0,0,6,0" Padding="10,5"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="Next →" Command="{Binding NextProblemCommand}" Margin="0,0,10,0" Padding="10,5"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" Command="{Binding OpenLeetCodeCommand}" ToolTip="Open on LeetCode"/>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Mode Selector Tabs (Brute Force vs Optimal vs Teach Me) -->
                <Border Grid.Row="1" Background="{DynamicResource Surface2}" CornerRadius="8" Padding="4" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Brute Force Tab -->
                        <Button Grid.Column="0" Style="{StaticResource BaseButton}" Padding="10,7"
                                Command="{Binding SelectModeCommand}" CommandParameter="BruteForce"
                                Background="{Binding IsBruteForceMode, Converter={StaticResource BoolToBrush}, ConverterParameter=Surface|Transparent}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE73C;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Warning}" Margin="0,0,6,0"/>
                                <TextBlock Text="1. Brute Force Approach" FontWeight="Medium"
                                           Foreground="{Binding IsBruteForceMode, Converter={StaticResource BoolToBrush}, ConverterParameter=Text|TextMuted}"/>
                            </StackPanel>
                        </Button>

                        <!-- Optimal Tab -->
                        <Button Grid.Column="1" Style="{StaticResource BaseButton}" Padding="10,7"
                                Command="{Binding SelectModeCommand}" CommandParameter="Optimal"
                                Background="{Binding IsOptimalMode, Converter={StaticResource BoolToBrush}, ConverterParameter=Surface|Transparent}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" Margin="0,0,6,0"/>
                                <TextBlock Text="2. Optimal Solution" FontWeight="Medium"
                                           Foreground="{Binding IsOptimalMode, Converter={StaticResource BoolToBrush}, ConverterParameter=Text|TextMuted}"/>
                            </StackPanel>
                        </Button>

                        <!-- Teach Me Tab -->
                        <Button Grid.Column="2" Style="{StaticResource BaseButton}" Padding="10,7"
                                Command="{Binding SelectModeCommand}" CommandParameter="TeachMe"
                                Background="{Binding IsTeachMeMode, Converter={StaticResource BoolToBrush}, ConverterParameter=Surface|Transparent}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE7BE;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,6,0"/>
                                <TextBlock Text="3. Interactive Visualizer &amp; Coach" FontWeight="Medium"
                                           Foreground="{Binding IsTeachMeMode, Converter={StaticResource BoolToBrush}, ConverterParameter=Text|TextMuted}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Row 2: Training Content (Scrollable) -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- ============================================== -->
                        <!-- MODE 1: BRUTE FORCE                            -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding IsBruteForceMode, Converter={StaticResource BoolToVis}}">
                            <!-- Concept Card -->
                            <Border Style="{StaticResource Inset}" Margin="0,0,0,12" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="THE NAIVE MENTAL MODEL" Style="{StaticResource Overline}" Foreground="{DynamicResource Warning}"/>
                                    <TextBlock Text="{Binding Training.BruteForceConcept}" Style="{StaticResource Body}" Margin="0,6,0,0"/>
                                    
                                    <TextBlock Text="Step-by-Step Logic:" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Text}" Margin="0,12,0,4"/>
                                    <TextBlock Text="{Binding Training.BruteForceAlgorithm}" Style="{StaticResource Muted}" FontFamily="{StaticResource UiFont}"/>
                                </StackPanel>
                            </Border>

                            <!-- Complexity Badges & Bottleneck Alert -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Inset}" Margin="0,0,6,0" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="Time Complexity" Style="{StaticResource Caption}"/>
                                        <TextBlock Text="{Binding Training.BruteForceTime}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Danger}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource Inset}" Margin="6,0,0,0" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="Space Complexity" Style="{StaticResource Caption}"/>
                                        <TextBlock Text="{Binding Training.BruteForceSpace}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Text}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Bottleneck Warning -->
                            <Border Margin="0,0,0,14" CornerRadius="8" Padding="14" Background="#18EF4444" BorderBrush="#40EF4444" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource Danger}" Margin="0,0,6,0"/>
                                        <TextBlock Text="The Bottleneck: Why This Fails in Interviews (TLE)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Danger}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Training.BruteForceBottleneck}" Style="{StaticResource Body}" FontSize="12.5"/>
                                </StackPanel>
                            </Border>

                            <!-- Brute Force Code Block -->
                            <Border Style="{StaticResource Inset}" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Header with Language Switcher & Copy Button -->
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="BRUTE FORCE CODE" Style="{StaticResource Overline}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                            <Button Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,6,0"
                                                    Command="{Binding SelectLanguageCommand}" CommandParameter="Python"
                                                    Background="{Binding IsPython, Converter={StaticResource BoolToBrush}, ConverterParameter=Accent|Transparent}"
                                                    Foreground="{Binding IsPython, Converter={StaticResource BoolToBrush}, ConverterParameter=OnAccent|TextMuted}">
                                                <TextBlock Text="Python"/>
                                            </Button>

                                            <Button Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,6,0"
                                                    Command="{Binding SelectLanguageCommand}" CommandParameter="Cpp"
                                                    Background="{Binding IsCpp, Converter={StaticResource BoolToBrush}, ConverterParameter=Accent|Transparent}"
                                                    Foreground="{Binding IsCpp, Converter={StaticResource BoolToBrush}, ConverterParameter=OnAccent|TextMuted}">
                                                <TextBlock Text="C++"/>
                                            </Button>

                                            <Button Style="{StaticResource SecondaryButton}" Padding="10,4"
                                                    Command="{Binding SelectLanguageCommand}" CommandParameter="Java"
                                                    Background="{Binding IsJava, Converter={StaticResource BoolToBrush}, ConverterParameter=Accent|Transparent}"
                                                    Foreground="{Binding IsJava, Converter={StaticResource BoolToBrush}, ConverterParameter=OnAccent|TextMuted}">
                                                <TextBlock Text="Java"/>
                                            </Button>
                                        </StackPanel>

                                        <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Command="{Binding CopyCodeCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,5,0"/>
                                                <TextBlock Text="Copy Code"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <TextBox Grid.Row="1" Text="{Binding ActiveBruteForceCode, Mode=OneWay}" 
                                             Style="{x:Null}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{DynamicResource Text}"
                                             TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- MODE 2: OPTIMAL SOLUTION                       -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding IsOptimalMode, Converter={StaticResource BoolToVis}}">
                            <!-- The Aha! Moment Banner -->
                            <Border Margin="0,0,0,14" CornerRadius="10" Padding="16" Background="#1522C55E" BorderBrush="#3522C55E" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="&#xE781;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource Success}" Margin="0,0,8,0"/>
                                        <TextBlock Text="THE AHA! MOMENT &amp; PATTERN TRIGGER" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Success}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Training.AhaMoment}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Training.OptimalIntuition}" Style="{StaticResource Muted}" Margin="0,6,0,0" FontSize="13"/>
                                </StackPanel>
                            </Border>

                            <!-- Step by Step Execution -->
                            <Border Style="{StaticResource Inset}" Margin="0,0,0,14" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="STEP-BY-STEP ALGORITHM" Style="{StaticResource Overline}"/>
                                    <TextBlock Text="{Binding Training.OptimalAlgorithm}" Style="{StaticResource Body}" Margin="0,6,0,0" FontFamily="{StaticResource UiFont}"/>
                                </StackPanel>
                            </Border>

                            <!-- Complexity Proofs -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Inset}" Margin="0,0,6,0" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="Optimal Time Complexity" Style="{StaticResource Caption}"/>
                                        <TextBlock Text="{Binding Training.OptimalTime}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Success}" Margin="0,2,0,4"/>
                                        <TextBlock Text="{Binding Training.OptimalTimeProof}" Style="{StaticResource Caption}" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource Inset}" Margin="6,0,0,0" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="Optimal Space Complexity" Style="{StaticResource Caption}"/>
                                        <TextBlock Text="{Binding Training.OptimalSpace}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,2,0,4"/>
                                        <TextBlock Text="{Binding Training.OptimalSpaceProof}" Style="{StaticResource Caption}" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Multi-Language Code Editor -->
                            <Border Style="{StaticResource Inset}" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Language Tabs & Copy Button -->
                                    <Grid Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="OPTIMAL CODE" Style="{StaticResource Overline}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                            <Button Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,6,0"
                                                    Command="{Binding SelectLanguageCommand}" CommandParameter="Python"
                                                    Background="{Binding IsPython, Converter={StaticResource BoolToBrush}, ConverterParameter=Accent|Transparent}"
                                                    Foreground="{Binding IsPython, Converter={StaticResource BoolToBrush}, ConverterParameter=OnAccent|TextMuted}">
                                                <TextBlock Text="Python"/>
                                            </Button>

                                            <Button Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,6,0"
                                                    Command="{Binding SelectLanguageCommand}" CommandParameter="Cpp"
                                                    Background="{Binding IsCpp, Converter={StaticResource BoolToBrush}, ConverterParameter=Accent|Transparent}"
                                                    Foreground="{Binding IsCpp, Converter={StaticResource BoolToBrush}, ConverterParameter=OnAccent|TextMuted}">
                                                <TextBlock Text="C++"/>
                                            </Button>

                                            <Button Style="{StaticResource SecondaryButton}" Padding="10,4"
                                                    Command="{Binding SelectLanguageCommand}" CommandParameter="Java"
                                                    Background="{Binding IsJava, Converter={StaticResource BoolToBrush}, ConverterParameter=Accent|Transparent}"
                                                    Foreground="{Binding IsJava, Converter={StaticResource BoolToBrush}, ConverterParameter=OnAccent|TextMuted}">
                                                <TextBlock Text="Java"/>
                                            </Button>
                                        </StackPanel>

                                        <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Command="{Binding CopyCodeCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,5,0"/>
                                                <TextBlock Text="Copy Code"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Code Display -->
                                    <TextBox Grid.Row="1" Text="{Binding ActiveOptimalCode, Mode=OneWay}" 
                                             Style="{x:Null}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{DynamicResource Text}"
                                             TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <!-- Interactive Visualizer Quick Launcher -->
                            <Border Margin="0,12,0,0" Padding="14,10" CornerRadius="8" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7BE;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource Accent}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Interactive Step-by-Step State Visualizer &amp; Memory Graph" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Text}"/>
                                            <TextBlock Text="Watch pointers (i, L, R, mid) step through array cells, track live variables, and inspect memory transitions." Style="{StaticResource Caption}" Foreground="{DynamicResource TextMuted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Padding="14,6" Command="{Binding LaunchVisualizerCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Launch Visualizer" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,6,0"/>
                                            <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- HOW EACH LINE WORKS & VARIABLE DECONSTRUCTION -->
                            <Border Margin="0,14,0,0" Style="{StaticResource Inset}" Padding="16" Visibility="{Binding HasLineExplanations, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="&#xE8D2;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="HOW EACH LINE WORKS &amp; VARIABLE DECONSTRUCTION" Style="{StaticResource Overline}" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Line-by-line mechanical deconstruction: exactly what executes at each statement, what variables mutate in memory, and the algorithmic rationale." Style="{StaticResource Muted}" FontSize="12.5" Margin="0,0,0,14"/>

                                    <ItemsControl ItemsSource="{Binding LineExplanations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,10" Padding="12" CornerRadius="8" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
                                                    <StackPanel>
                                                        <!-- Line Header & Code -->
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="{DynamicResource AccentSoft}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding LineNumber, StringFormat='▶ LINE {0}'}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding CodeLine}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                                        </Grid>

                                                        <!-- What It Does -->
                                                        <Grid Margin="0,3,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="WHAT IT DOES:" Style="{StaticResource Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding WhatItDoes}" Style="{StaticResource Body}" FontSize="12.5"/>
                                                        </Grid>

                                                        <!-- Variables At Work -->
                                                        <Grid Margin="0,3,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="VARIABLES:" Style="{StaticResource Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding VariableImpact}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource Accent}"/>
                                                        </Grid>

                                                        <!-- Why This Line -->
                                                        <Grid Margin="0,3,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="WHY THIS LINE:" Style="{StaticResource Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Success}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding WhyThisLine}" Style="{StaticResource Body}" FontSize="12" Foreground="{DynamicResource Success}"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- MODE 3: TEACH ME (PYTHON TUTOR VISUAL COACH)   -->
                        <!-- ============================================== -->
                        <StackPanel Visibility="{Binding IsTeachMeMode, Converter={StaticResource BoolToVis}}">

                            <!-- Section 1: Main Python Tutor Visualizer Cockpit -->
                            <Border Style="{StaticResource Inset}" Margin="0,0,0,16" Padding="18">
                                <StackPanel>
                                    <!-- Toolbar: Title, Step Progress & Stepper Playback Controls -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Title & Progress Badge -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                                <TextBlock Text="PYTHON TUTOR" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                            </Border>
                                            <TextBlock Text="LIVE EXECUTION SIMULATOR" Style="{StaticResource Overline}" Foreground="{DynamicResource Text}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Border Background="{DynamicResource Surface2}" CornerRadius="10" Padding="10,3" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                                <TextBlock Text="{Binding StepProgressText}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Stepper Navigation Toolbar -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- << First -->
                                            <Button Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,5,0" 
                                                    Command="{Binding StepFirstCommand}" IsEnabled="{Binding CanStepFirst}" ToolTip="Jump to First Step (Start)">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE892;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,5,0"/>
                                                    <TextBlock Text="First" FontSize="11.5" FontWeight="Medium"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- < Prev -->
                                            <Button Style="{StaticResource SecondaryButton}" Padding="11,5" Margin="0,0,5,0" 
                                                    Command="{Binding StepPrevCommand}" IsEnabled="{Binding CanStepPrev}" ToolTip="Step Backward (Prev)">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Prev" FontSize="11.5" FontWeight="Medium"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Next > -->
                                            <Button Style="{StaticResource SecondaryButton}" Padding="11,5" Margin="0,0,5,0" 
                                                    Command="{Binding StepNextCommand}" IsEnabled="{Binding CanStepNext}" ToolTip="Step Forward (Next)">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Next" FontSize="11.5" FontWeight="Medium" Margin="0,0,5,0"/>
                                                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Last >> -->
                                            <Button Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,8,0" 
                                                    Command="{Binding StepLastCommand}" IsEnabled="{Binding CanStepLast}" ToolTip="Jump to Final Result (Last)">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Last" FontSize="11.5" FontWeight="Medium" Margin="0,0,5,0"/>
                                                    <TextBlock Text="&#xE893;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Play / Pause -->
                                            <Button Style="{StaticResource PrimaryButton}" Padding="14,5" Command="{Binding TogglePlayCommand}" ToolTip="Toggle Auto Play Simulation">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding PlayPauseIcon}" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding PlayPauseText}" FontSize="11.5" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Step Narration & Insight Banner -->
                                    <Border Margin="0,0,0,16" Padding="16,12" Background="{DynamicResource Surface2}" CornerRadius="10" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Action Title & Line Tag -->
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                                <Border Background="{DynamicResource Accent}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CurrentVisualStep.LineNumber, StringFormat='Line {0}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OnAccent}"/>
                                                </Border>
                                                <TextBlock Text="{Binding CurrentVisualStep.Title}" FontWeight="SemiBold" FontSize="14.5" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Summary & Deep Intuition -->
                                            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding CurrentVisualStep.ActionSummary}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding CurrentVisualStep.DeepExplanation}" FontSize="12.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <!-- Invariant Note Badge -->
                                            <Border Grid.Row="2" Padding="10,6" CornerRadius="6" Background="{DynamicResource SuccessSoft}" BorderBrush="{DynamicResource Success}" BorderThickness="1"
                                                    Visibility="{Binding CurrentVisualStep.InvariantNote, Converter={StaticResource StringToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource Success}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding CurrentVisualStep.InvariantNote, StringFormat='Algorithmic Invariant: {0}'}" FontSize="11.5" Foreground="{DynamicResource Success}" FontWeight="Medium" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- ============================================================== -->
                                    <!-- PYTHON TUTOR SPLIT VIEW: CODE ON LEFT, FRAMES & OBJECTS ON RIGHT-->
                                    <!-- ============================================================== -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="420" MinWidth="320"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- LEFT COLUMN: CODE LISTING WITH ACTIVE LINE ARROW (▶) -->
                                        <Border Grid.Column="0" Background="{DynamicResource Bg}" CornerRadius="10" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1.5" Padding="12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <!-- Code Header Bar -->
                                                <Border Grid.Row="0" Margin="0,0,0,10" Padding="4,0,4,8" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE756;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="PYTHON PROGRAM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                                                    </StackPanel>
                                                    <TextBlock HorizontalAlignment="Right" Text="Live Pointer" Style="{StaticResource Caption}" FontSize="10.5"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Scrollable Code Listing with Execution Pointer Arrow -->
                                                <ScrollViewer Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding VisualCodeLines}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="6,3" CornerRadius="4" Margin="0,1"
                                                                        Background="{Binding IsActive, Converter={StaticResource BoolToBrush}, ConverterParameter='AccentSoft|Transparent'}"
                                                                        BorderBrush="{Binding IsActive, Converter={StaticResource BoolToBrush}, ConverterParameter='Accent|Transparent'}"
                                                                        BorderThickness="1">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="26"/>
                                                                            <ColumnDefinition Width="18"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- Line Number -->
                                                                        <TextBlock Grid.Column="0" Text="{Binding LineNumber}" 
                                                                                   FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                                                   Foreground="{DynamicResource TextFaint}" TextAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                                                        <!-- Pointer Arrow (▶) -->
                                                                        <TextBlock Grid.Column="1" Text="{Binding PointerText}" 
                                                                                   FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold"
                                                                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                                        <!-- Code Line Text -->
                                                                        <TextBlock Grid.Column="2" Text="{Binding Code}" 
                                                                                   FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                                                                   Foreground="{Binding IsActive, Converter={StaticResource BoolToBrush}, ConverterParameter='Text|TextMuted'}"
                                                                                   FontWeight="{Binding IsActive, Converter={x:Static local:ViewHelpers.BoolToBold}}"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>

                                        <!-- RIGHT COLUMN: FRAMES & OBJECTS (PYTHON TUTOR ARCHITECTURE) -->
                                        <StackPanel Grid.Column="2">
                                            <!-- 1. FRAMES: Call Stack & Scope Variables -->
                                            <Border Background="{DynamicResource Bg}" CornerRadius="10" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1.5" Padding="14" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <!-- Frames Box Header -->
                                                    <Border Margin="0,0,0,10" Padding="0,0,0,8" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <TextBlock Text="&#xE7BE;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="FRAMES" Style="{StaticResource Overline}" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Local Function Scope" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" HorizontalAlignment="Right" Background="{DynamicResource Surface2}" CornerRadius="6" Padding="8,3" BorderBrush="{DynamicResource Border}" BorderThickness="1" MaxWidth="320">
                                                                <TextBlock Text="{Binding ActiveFunctionSignature}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Variables Table Header -->
                                                    <Grid Margin="4,0,4,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="VARIABLE" Style="{StaticResource Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                                                        <TextBlock Grid.Column="1" Text="CURRENT VALUE" Style="{StaticResource Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                                                    </Grid>

                                                    <!-- Variables Table Items -->
                                                    <ItemsControl ItemsSource="{Binding CurrentVisualStep.Variables}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,2" Padding="10,6" CornerRadius="6"
                                                                        Background="{Binding IsChanged, Converter={StaticResource BoolToBrush}, ConverterParameter='AccentSoft|Surface2'}"
                                                                        BorderBrush="{Binding IsChanged, Converter={StaticResource BoolToBrush}, ConverterParameter='AccentLine|Border'}"
                                                                        BorderThickness="1">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="130"/>
                                                                            <ColumnDefinition Width="20"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- Variable Name -->
                                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>

                                                                        <!-- Equals Separator -->
                                                                        <TextBlock Grid.Column="1" Text="=" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>

                                                                        <!-- Variable Value -->
                                                                        <TextBlock Grid.Column="2" Text="{Binding Value}" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Text}" VerticalAlignment="Center" TextWrapping="Wrap"/>

                                                                        <!-- Modified Indicator Badge -->
                                                                        <Border Grid.Column="3" Background="{DynamicResource WarningSoft}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                                                                Visibility="{Binding IsChanged, Converter={StaticResource BoolToVis}}">
                                                                            <TextBlock Text="UPDATED" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Warning}"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <!-- 2. OBJECTS: Heap, Arrays, Grids & Auxiliary State -->
                                            <Border Background="{DynamicResource Bg}" CornerRadius="10" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1.5" Padding="14">
                                                <StackPanel>
                                                    <!-- Objects Box Header -->
                                                    <Border Margin="0,0,0,12" Padding="0,0,0,8" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
                                                        <Grid>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="OBJECTS" Style="{StaticResource Overline}" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Heap / Data Structures" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Horizontal Data Structure Strip (Auto-sizing, no truncation!) -->
                                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,4,0,8">
                                                        <ItemsControl ItemsSource="{Binding CurrentVisualStep.Nodes}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="6,0">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="26"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="22"/>
                                                                        </Grid.RowDefinitions>

                                                                        <!-- Pointer Tag Badge & Pointer Arrow (e.g. i, L, R, mid, rows) -->
                                                                        <StackPanel Grid.Row="0" HorizontalAlignment="Center"
                                                                                    Visibility="{Binding PointerTag, Converter={StaticResource StringToVis}}">
                                                                            <Border Padding="8,2" CornerRadius="4" Background="{DynamicResource Accent}">
                                                                                <TextBlock Text="{Binding PointerTag}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OnAccent}"/>
                                                                            </Border>
                                                                            <TextBlock Text="▼" FontSize="9" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                                                                        </StackPanel>

                                                                        <!-- Visual Element Node Box (EXPANDABLE WIDTH, LARGE READABLE TYPOGRAPHY) -->
                                                                        <Border Grid.Row="1" MinWidth="80" MaxWidth="280" Width="Auto" MinHeight="56"
                                                                                Padding="14,10"
                                                                                Height="{Binding HeightPercent, Converter={StaticResource HeightToDouble}}"
                                                                                CornerRadius="8"
                                                                                BorderThickness="1.5"
                                                                                BorderBrush="{Binding Highlight, Converter={StaticResource HighlightToBorder}}"
                                                                                Background="{Binding Highlight, Converter={StaticResource HighlightToBg}}"
                                                                                VerticalAlignment="Bottom">
                                                                            <TextBlock Text="{Binding Value}" 
                                                                                       FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="Bold"
                                                                                       Foreground="{Binding Highlight, Converter={StaticResource HighlightToFg}}"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                       TextWrapping="NoWrap"/>
                                                                        </Border>

                                                                        <!-- Index / Key Subtitle -->
                                                                        <TextBlock Grid.Row="2" Text="{Binding IndexLabel}" 
                                                                                   FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>

                                                    <!-- Auxiliary Memory Collections (Sets, Maps, Stacks) -->
                                                    <StackPanel Margin="0,12,0,0" Visibility="{Binding CurrentVisualStep.AuxiliaryMemory.Count, Converter={StaticResource CountToVis}}">
                                                        <TextBlock Text="AUXILIARY COLLECTIONS (SETS &amp; MAPS)" Style="{StaticResource Overline}" FontSize="10" Foreground="{DynamicResource TextFaint}" Margin="0,0,0,6"/>
                                                        <ItemsControl ItemsSource="{Binding CurrentVisualStep.AuxiliaryMemory}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Margin="4,3" Padding="12,7" CornerRadius="6" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{}{ }" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Section 2: Phase 1 Clarifying Questions Before Coding -->
                            <Border Style="{StaticResource Inset}" Margin="0,0,0,12" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="PHASE 1: CLARIFYING QUESTIONS BEFORE CODING" Style="{StaticResource Overline}" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="Interviewers evaluate if you explore constraints and ambiguous edge cases before rushing into code:" Style="{StaticResource Muted}" Margin="0,4,0,8" FontSize="12.5"/>
                                    <ItemsControl ItemsSource="{Binding Training.ClarifyingQuestions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                                    <TextBlock Text="•" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="13"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Section 3: Phase 3 Common Pitfalls & Traps -->
                            <Border Style="{StaticResource Inset}" Margin="0,0,0,12" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="PHASE 3: COMMON PITFALLS &amp; INTERVIEW TRAPS" Style="{StaticResource Overline}" Foreground="{DynamicResource Warning}"/>
                                    <ItemsControl ItemsSource="{Binding Training.CommonPitfalls}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                                    <TextBlock Text="⚠" Foreground="{DynamicResource Warning}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="12.5"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Section 4: Phase 4 Top Interviewer Follow-ups -->
                            <Border Style="{StaticResource Inset}" Margin="0,0,0,12" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="PHASE 4: TOP INTERVIEWER FOLLOW-UPS" Style="{StaticResource Overline}" Foreground="{DynamicResource TextFaint}"/>
                                    <ItemsControl ItemsSource="{Binding Training.FollowUpQuestions}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                                    <TextBlock Text="?" Foreground="{DynamicResource Accent}" Margin="0,0,8,0" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="12.5"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Row 3: Bottom Mastery Actions -->
                <Border Grid.Row="3" Margin="0,14,0,0" Padding="0,10,0,0" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Brute Force Check -->
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding ToggleBruteForceCommand}" Margin="0,0,10,0" Padding="14,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding BruteForceButtonIcon}" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BruteForceButtonText}" FontSize="12.5" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>

                            <!-- Optimal Mastered Check -->
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ToggleOptimalCommand}" Padding="14,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding OptimalButtonIcon}" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding OptimalButtonText}" FontSize="12.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Practice on LeetCode:" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource LinkButton}" Content="{Binding SelectedProblem.Slug, StringFormat='leetcode.com/problems/{0}'}"
                                    Command="{Binding OpenLeetCodeCommand}" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
