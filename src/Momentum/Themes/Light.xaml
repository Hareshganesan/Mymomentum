<!-- Quiet Graphite — light. Same structure as dark; amber darkened for contrast on white. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg" Color="#F6F6F5"/>
    <SolidColorBrush x:Key="Sidebar" Color="#EEEEEC"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface2" Color="#F7F7F6"/>
    <SolidColorBrush x:Key="Hover" Color="#F0F0EE"/>
    <SolidColorBrush x:Key="Pressed" Color="#E8E8E6"/>
    <SolidColorBrush x:Key="Border" Color="#E1E1DE"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#CDCDC9"/>
    <SolidColorBrush x:Key="Divider" Color="#EBEBE8"/>
    <SolidColorBrush x:Key="PopupBg" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Text" Color="#17181A"/>
    <SolidColorBrush x:Key="TextMuted" Color="#5B6069"/>
    <SolidColorBrush x:Key="TextFaint" Color="#868B94"/>

    <SolidColorBrush x:Key="Accent" Color="#B07A1A"/>
    <SolidColorBrush x:Key="AccentHover" Color="#966713"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#1AB07A1A"/>
    <SolidColorBrush x:Key="AccentLine" Color="#66B07A1A"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryBg" Color="#17181A"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#2C2E32"/>
    <SolidColorBrush x:Key="PrimaryFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Success" Color="#2E9A66"/>
    <SolidColorBrush x:Key="SuccessSoft" Color="#1A2E9A66"/>
    <SolidColorBrush x:Key="Warning" Color="#B07A1A"/>
    <SolidColorBrush x:Key="WarningSoft" Color="#1AB07A1A"/>
    <SolidColorBrush x:Key="Danger" Color="#C94848"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#1AC94848"/>
    <SolidColorBrush x:Key="EasyBrush" Color="#2E9A66"/>
    <SolidColorBrush x:Key="MediumBrush" Color="#B07A1A"/>
    <SolidColorBrush x:Key="HardBrush" Color="#C94848"/>
    <SolidColorBrush x:Key="ProgressTrack" Color="#ECECEA"/>
    <SolidColorBrush x:Key="ProgressNeutral" Color="#A3A7AE"/>

    <SolidColorBrush x:Key="HeatEmpty" Color="#ECECEA"/>
    <SolidColorBrush x:Key="Heat1" Color="#F1E2C2"/>
    <SolidColorBrush x:Key="Heat2" Color="#E2C17E"/>
    <SolidColorBrush x:Key="Heat3" Color="#C8963A"/>
    <SolidColorBrush x:Key="Heat4" Color="#966713"/>

    <SolidColorBrush x:Key="GlassFill" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="GlassRim" Color="#E1E1DE"/>
    <SolidColorBrush x:Key="TileFill" Color="#F7F7F6"/>
    <!-- Card edge: a hair lighter on top so panels read as slightly raised -->
    <LinearGradientBrush x:Key="CardEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E8E8E5" Offset="0"/>
        <GradientStop Color="#DCDCD8" Offset="0.35"/>
    </LinearGradientBrush>
</ResourceDictionary>
