<Application x:Class="Momentum.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Momentum.Core"
             xmlns:vm="clr-namespace:Momentum.ViewModels"
             xmlns:views="clr-namespace:Momentum.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is swapped at runtime by App.ApplyTheme. -->
                <ResourceDictionary Source="Themes/Dark.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <core:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <core:NullToVisibilityConverter x:Key="NullToVis"/>
            <core:CountToVisibilityConverter x:Key="CountToVis"/>
            <core:StringToVisibilityConverter x:Key="StringToVis"/>
            <core:InverseBoolConverter x:Key="InverseBool"/>
            <core:DifficultyBrushConverter x:Key="DifficultyBrush"/>
            <core:BoolToBrushConverter x:Key="BoolToBrush"/>
            <core:EqualsConverter x:Key="Equals"/>
            <core:NodeHighlightToBorderBrushConverter x:Key="HighlightToBorder"/>
            <core:NodeHighlightToBgBrushConverter x:Key="HighlightToBg"/>
            <core:NodeHighlightToFgBrushConverter x:Key="HighlightToFg"/>
            <core:HeightPercentToDoubleConverter x:Key="HeightToDouble"/>

            <DataTemplate DataType="{x:Type vm:TodayViewModel}"><views:TodayView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AssessmentLabViewModel}"><views:AssessmentLabView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:TrainingViewModel}"><views:TrainingView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProblemsViewModel}"><views:ProblemsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReviewViewModel}"><views:ReviewView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CoreCsViewModel}"><views:CoreCsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:MockViewModel}"><views:MockView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PipelineViewModel}"><views:PipelineView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:StoriesViewModel}"><views:StoriesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:InsightsViewModel}"><views:InsightsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
