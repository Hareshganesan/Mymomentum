<Window x:Class="MyTodo.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyTodo.ViewModels"
        xmlns:controls="clr-namespace:MyTodo.Controls"
        Title="MyTodo - Premium Desktop" 
        Height="800" Width="1400"
        MinHeight="650" MinWidth="1100"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Smooth animations -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        
        <Storyboard x:Key="SlideIn">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" 
                             From="20" To="0" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
        </Storyboard>
    </Window.Resources>

    <!-- Main Container -->
    <Border Background="{StaticResource DarkBackgroundBrush}" 
            CornerRadius="20"
            Margin="8"
            BorderBrush="{StaticResource GoldBorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="50" ShadowDepth="0" Color="#000000" Opacity="0.9"/>
        </Border.Effect>
        
        <Grid>
            <!-- Animated Background -->
            <Border CornerRadius="20" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF08080C" Offset="0"/>
                        <GradientStop Color="#FF0C0C14" Offset="0.5"/>
                        <GradientStop Color="#FF08080C" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Ambient Gold Orbs -->
            <Canvas IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse Width="600" Height="600" Canvas.Left="-200" Canvas.Top="-200" Opacity="0.06">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFD4AF37" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="500" Height="500" Canvas.Right="-150" Canvas.Bottom="-100" Opacity="0.05">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFD700" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="400" Height="400" Canvas.Left="600" Canvas.Top="200" Opacity="0.03">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFB8860B" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- ============================================== -->
                <!-- LEFT SIDEBAR - Navigation & Stats              -->
                <!-- ============================================== -->
                <Border Grid.Column="0" 
                        Margin="0" 
                        CornerRadius="20,0,0,20"
                        BorderThickness="0,0,1,0"
                        BorderBrush="#15D4AF37">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12D4AF37" Offset="0"/>
                            <GradientStop Color="#08D4AF37" Offset="0.5"/>
                            <GradientStop Color="#05D4AF37" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    
                    <Grid Margin="24,20,24,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Logo & Brand -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,30">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Width="44" Height="44" CornerRadius="12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFB8860B" Offset="0"/>
                                            <GradientStop Color="#FFD4AF37" Offset="0.5"/>
                                            <GradientStop Color="#FFFFD700" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#FFD4AF37" Opacity="0.5"/>
                                    </Border.Effect>
                                    <TextBlock Text="✦" FontSize="22" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="#0A0A0F"/>
                                </Border>
                                
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="MyTodo" 
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource GoldGradient}"/>
                                    <TextBlock Text="Premium" 
                                               FontSize="10"
                                               Foreground="{StaticResource GoldMutedBrush}"
                                               Margin="0,-2,0,0"/>
                                </StackPanel>
                                
                                <!-- Window Controls -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource GoldIconButton}" Width="28" Height="28"
                                            Click="MinimizeButton_Click" Content="─" FontSize="10"/>
                                    <Button Style="{StaticResource GoldIconButton}" Width="28" Height="28"
                                            Click="CloseButton_Click" Content="✕" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        
                        <!-- Circular Progress - Large & Centered -->
                        <Border Grid.Row="1" Margin="0,0,0,25">
                            <Grid Width="180" Height="180" HorizontalAlignment="Center">
                                <controls:CircularProgress Value="{Binding TodayProgress, Mode=OneWay}"
                                                           StrokeThickness="12"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" FontSize="42" FontWeight="Bold" 
                                               Foreground="{StaticResource GoldGradient}">
                                        <TextBlock.Text>
                                            <Binding Path="TodayProgress" StringFormat="{}{0:0}" Mode="OneWay"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text="% Complete" FontSize="12" 
                                               Foreground="{StaticResource GoldMutedBrush}" 
                                               HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <!-- Quick Stats -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,20">
                            <!-- Streak -->
                            <Border Margin="0,0,0,10" Padding="16,14" CornerRadius="14"
                                    Background="#10D4AF37" BorderBrush="#20D4AF37" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔥" FontSize="22" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Current Streak" FontSize="11" 
                                                   Foreground="{StaticResource GoldMutedBrush}"/>
                                        <TextBlock Text="{Binding CurrentStreak, StringFormat='{}{0} days'}" 
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="🏆" FontSize="16" VerticalAlignment="Center"
                                               ToolTip="{Binding BestStreak, StringFormat='Best: {0} days'}"/>
                                </Grid>
                            </Border>
                            
                            <!-- Total Completed -->
                            <Border Padding="16,14" CornerRadius="14"
                                    Background="#10D4AF37" BorderBrush="#20D4AF37" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="✨" FontSize="22" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Total Completed" FontSize="11" 
                                                   Foreground="{StaticResource GoldMutedBrush}"/>
                                        <TextBlock Text="{Binding TotalTasksCompleted, StringFormat='{}{0} tasks'}" 
                                                   FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                        
                        <!-- Weekly Chart -->
                        <Border Grid.Row="3" CornerRadius="16" Padding="16"
                                Background="#08D4AF37" BorderBrush="#15D4AF37" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="This Week" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                <controls:WeeklyChart Height="100" Data="{Binding WeeklyData, Mode=OneWay}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <TextBlock Text="Avg: " FontSize="11" Foreground="{StaticResource GoldMutedBrush}"/>
                                    <TextBlock Text="{Binding WeeklyAverage, StringFormat='{}{0:0}%'}" 
                                               FontSize="11" FontWeight="SemiBold" 
                                               Foreground="{StaticResource GoldGradient}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Theme Toggle -->
                        <Button Grid.Row="4" Style="{StaticResource GoldIconButton}" 
                                Command="{Binding ToggleThemeCommand}"
                                HorizontalAlignment="Left" Margin="0,15,0,0"
                                Content="☀" ToolTip="Toggle Theme"/>
                    </Grid>
                </Border>

                <!-- ============================================== -->
                <!-- CENTER - Tasks List                            -->
                <!-- ============================================== -->
                <Grid Grid.Column="1" Margin="30,20,30,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="{Binding TimeGreeting}" FontSize="14" 
                                   Foreground="{StaticResource GoldMutedBrush}"/>
                        <TextBlock Text="{Binding TodayDateFormatted}" FontSize="28" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    
                    <!-- Motivational Banner -->
                    <Border Grid.Row="1" Margin="0,0,0,20" CornerRadius="18" Padding="24,20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#15D4AF37" Offset="0"/>
                                <GradientStop Color="#08FFD700" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#30D4AF37" Offset="0"/>
                                <GradientStop Color="#15FFD700" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.BorderThickness>1</Border.BorderThickness>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding MotivationalMessage}" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource GoldGradient}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}">
                                        <TextBlock.Text>
                                            <Binding Path="CompletedTodayTasks"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text=" / " FontSize="24" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock FontSize="24" Foreground="{StaticResource TextMutedBrush}">
                                        <TextBlock.Text>
                                            <Binding Path="TotalTodayTasks"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text=" tasks completed" FontSize="13" 
                                               Foreground="{StaticResource GoldMutedBrush}"
                                               VerticalAlignment="Bottom" Margin="8,0,0,4"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Mini Progress -->
                            <Border Grid.Column="1" Width="80" Height="80" Margin="20,0,0,0">
                                <Grid>
                                    <controls:CircularProgress Value="{Binding TodayProgress, Mode=OneWay}" StrokeThickness="6"/>
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="16" FontWeight="Bold" Foreground="{StaticResource GoldGradient}">
                                        <TextBlock.Text>
                                            <Binding Path="TodayProgress" StringFormat="{}{0:0}%" Mode="OneWay"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <!-- Tasks Section -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Section Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Today's Tasks" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="13" Foreground="{StaticResource GoldMutedBrush}">
                                <TextBlock.Text>
                                    <Binding Path="RemainingTodayTasks" StringFormat="{}{0} remaining"/>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                        
                        <!-- Task List with Scroll -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- Empty State -->
                                <Border Margin="0,40,0,0"
                                        Visibility="{Binding HasNoTasks, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🎯" FontSize="72" HorizontalAlignment="Center" Opacity="0.8"/>
                                        <TextBlock Text="Ready to conquer the day?" FontSize="20" FontWeight="SemiBold"
                                                   Foreground="{StaticResource GoldGradient}"
                                                   HorizontalAlignment="Center" Margin="0,16,0,8"/>
                                        <TextBlock Text="Add your first task and start building momentum!"
                                                   FontSize="14" Foreground="{StaticResource GoldMutedBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                
                                <!-- Task Items -->
                                <ItemsControl ItemsSource="{Binding TodayTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,10" CornerRadius="14" Padding="16,14" Cursor="Hand">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#0CD4AF37"/>
                                                        <Setter Property="BorderBrush" Value="#18D4AF37"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#15D4AF37"/>
                                                                <Setter Property="BorderBrush" Value="#30D4AF37"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Opacity" Value="0.6"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Check Button -->
                                                    <Button Style="{StaticResource GoldCheckButton}"
                                                            Command="{Binding DataContext.CompleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Tag="{Binding IsCompleted, Converter={StaticResource BoolToTag}}"
                                                            VerticalAlignment="Center"/>
                                                    
                                                    <!-- Task Title -->
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                               FontSize="15" VerticalAlignment="Center"
                                                               Margin="14,0" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    
                                                    <!-- Status & Delete -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Border Width="8" Height="8" CornerRadius="4"
                                                                VerticalAlignment="Center" Margin="0,0,10,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{StaticResource TextMutedBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding StatusColor}" Value="Green">
                                                                            <Setter Property="Background" Value="#FF4ADE80"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusColor}" Value="Yellow">
                                                                            <Setter Property="Background" Value="#FFFBBF24"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding StatusColor}" Value="Red">
                                                                            <Setter Property="Background" Value="#FFEF4444"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        <Button Style="{StaticResource GoldIconButton}"
                                                                Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Content="✕" FontSize="11" Width="30" Height="30"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ============================================== -->
                <!-- RIGHT PANEL - Quick Add & Goals                -->
                <!-- ============================================== -->
                <Border Grid.Column="2" 
                        Margin="0" 
                        CornerRadius="0,20,20,0"
                        BorderThickness="1,0,0,0"
                        BorderBrush="#15D4AF37">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0AD4AF37" Offset="0"/>
                            <GradientStop Color="#05D4AF37" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24,20,24,24">
                        <StackPanel>
                            <!-- Quick Add Task -->
                            <TextBlock Text="✏️ Quick Add" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                            
                            <Border CornerRadius="14" Padding="16" Margin="0,0,0,24"
                                    Background="#0CD4AF37" BorderBrush="#18D4AF37" BorderThickness="1">
                                <StackPanel>
                                    <TextBox x:Name="TaskInput"
                                             Style="{StaticResource PremiumTextBox}"
                                             Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,12">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding AddTaskCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Style="{StaticResource GoldButton}"
                                            Command="{Binding AddTaskCommand}"
                                            Content="+ Add Task" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>
                            
                            <!-- Goals Section -->
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="🎯 Goals" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Grid>
                            
                            <!-- Add Goal -->
                            <Border CornerRadius="14" Padding="16" Margin="0,0,0,16"
                                    Background="#0CD4AF37" BorderBrush="#18D4AF37" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource PremiumTextBox}"
                                             Text="{Binding NewGoalTitle, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,10,0" Padding="12,10">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding AddGoalCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="1" Style="{StaticResource GoldButton}"
                                            Command="{Binding AddGoalCommand}"
                                            Content="+" Padding="14,10" FontSize="16"/>
                                </Grid>
                            </Border>
                            
                            <!-- Goals List -->
                            <ItemsControl ItemsSource="{Binding Goals}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" CornerRadius="14" Padding="16" Cursor="Hand"
                                                Background="#0CD4AF37" BorderBrush="#18D4AF37" BorderThickness="1">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontSize="12" Foreground="{StaticResource GoldMutedBrush}" Margin="0,4,0,0">
                                                            <TextBlock.Text>
                                                                <Binding Path="ProgressPercentage" StringFormat="{}{0:0}% complete"/>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Style="{StaticResource GoldButton}"
                                                                Command="{Binding DataContext.IncrementGoalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Content="+10%" Padding="10,6" FontSize="10" Margin="0,0,6,0"/>
                                                        <Button Style="{StaticResource GoldIconButton}"
                                                                Command="{Binding DataContext.DeleteGoalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Content="✕" FontSize="10" Width="26" Height="26"/>
                                                    </StackPanel>
                                                </Grid>
                                                
                                                <!-- Progress Bar -->
                                                <Grid Height="6" Margin="0,12,0,0">
                                                    <Border Background="#15D4AF37" CornerRadius="3"/>
                                                    <Border CornerRadius="3" HorizontalAlignment="Left">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                                                <Binding Path="ProgressPercentage" Mode="OneWay"/>
                                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" Mode="OneWay"/>
                                                            </MultiBinding>
                                                        </Border.Width>
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#FFB8860B" Offset="0"/>
                                                                <GradientStop Color="#FFD4AF37" Offset="0.5"/>
                                                                <GradientStop Color="#FFFFD700" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#FFD4AF37" Opacity="0.5"/>
                                                        </Border.Effect>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <!-- Spacer -->
                            <Border Height="20"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ============================================== -->
            <!-- CONFETTI OVERLAY                               -->
            <!-- ============================================== -->
            <Canvas x:Name="ConfettiCanvas" 
                    IsHitTestVisible="False"
                    Visibility="{Binding ShowConfetti, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </Border>
</Window>
