<Application x:Class="MyTodo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MyTodo.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Themes.xaml"/>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
                <ResourceDictionary Source="Resources/Animations.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Global Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <converters:BoolToTagConverter x:Key="BoolToTag"/>
            <converters:ProgressColorConverter x:Key="ProgressColorConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBool"/>
            <converters:ProgressToBrushConverter x:Key="ProgressToBrush"/>
            <converters:ProgressWidthConverter x:Key="ProgressWidthConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
